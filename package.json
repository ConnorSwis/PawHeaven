{
  "name": "pawheaven",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*", "packages/*"],
  "allowScripts": { "esbuild": true, "workerd": true },
  "devDependencies": { "@astrojs/check": "0.9.10", "supabase": "2.119.0", "typescript": "5.9.3" },
  "scripts": {
    "dev:web": "npm run dev -w @pawheaven/web",
    "dev:admin": "npm run dev -w @pawheaven/admin",
    "dev:api": "npm run dev -w @pawheaven/api",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset --local",
    "db:test": "npx supabase test db --local",
    "db:images": "node scripts/import-pet-images.mjs",
    "db:configure-api": "node scripts/configure-local-api-env.mjs",
    "db:verify": "npm run db:start && npm run db:reset",
    "db:stop": "npx supabase stop",
    "qa:discovery": "node --experimental-strip-types --test tests/discovery-qa.test.mjs",
    "qa:ai": "node --experimental-strip-types --test tests/ai-matching.test.mjs",
    "qa:stripe": "node --experimental-strip-types --test tests/stripe-webhook.test.mjs",
    "qa:theme": "node --experimental-strip-types --test tests/theme-qa.test.mjs",
    "demo:activity": "node scripts/demo-activity.mjs",
    "qa:involved": "node --experimental-strip-types --test tests/get-involved.test.mjs",
    "qa:status": "node --experimental-strip-types --test tests/shelter-status.test.mjs",
    "qa:alerts": "node --experimental-strip-types --test tests/email-alerts.test.mjs",
    "qa:demo": "node scripts/verify-demo.mjs",
    "build": "npm run build -w @pawheaven/web && npm run build -w @pawheaven/admin && npm run build -w @pawheaven/api",
    "check": "npm run build && npm run check:astro -w @pawheaven/web && npm run check:astro -w @pawheaven/admin && npm run workers:deploy:dry-run -w @pawheaven/api && npm run workers:deploy:dry-run -w @pawheaven/admin && npm run qa:discovery && npm run qa:ai && npm run qa:stripe && npm run qa:theme && npm run qa:involved && npm run qa:status && npm run qa:alerts"
  }
}
