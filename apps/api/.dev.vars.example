# Do not copy a teammate's values into this file. Generate .dev.vars instead:
#
#   npm run db:start
#   npm run db:configure-api
#
# The local API dev command performs that setup automatically. Add the bootstrap
# email before testing an invitation flow; it becomes the first superuser on login.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY="generated-by-npm-run-db-configure-api"
ADMIN_SUPABASE_SERVICE_ROLE_KEY="generated-by-npm-run-db-configure-api"
ALLOWED_ORIGINS="http://localhost:4321,http://localhost:4322"
BOOTSTRAP_SUPERUSER_EMAIL="you@example.com"
ADMIN_INVITE_REDIRECT_URL="http://localhost:4322/accept-invite"
# Optional. Transactional email uses Resend. Without a key, email is logged
# instead of sent; with a key, local development still only logs unless
# EMAIL_LOCAL_DELIVERY is "true" (seeded demo addresses are unreachable).
RESEND_API_KEY="re_your_resend_key"
EMAIL_LOCAL_DELIVERY="false"
# AI matching (pet quiz and lost-pet photo search) uses OpenRouter. Without a
# key those features report that matching is unavailable.
OPENROUTER_API_KEY="sk-or-your-openrouter-key"
# Optional model overrides (defaults: anthropic/claude-haiku-5.5 with a
# google/gemini-2.5-flash-lite fallback). The vision model must accept images.
# OPENROUTER_QUIZ_MODEL="anthropic/claude-haiku-5.5"
# OPENROUTER_VISION_MODEL="anthropic/claude-haiku-5.5"
# Optional: also email lost-pet inquiries to the shelter.
# SHELTER_NOTIFICATION_EMAIL="shelter@example.org"
# Donations are recorded by Stripe's signed webhook. `npm run db:configure-api` writes a local-only
# placeholder; for real test events run `stripe listen --forward-to localhost:8787/api/webhooks/stripe`
# and paste the whsec_ value it prints.
STRIPE_WEBHOOK_SECRET="whsec_local_demo_secret"
