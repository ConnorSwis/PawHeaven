# Do not copy a teammate's values into this file. Generate .dev.vars instead:
#
#   npm run db:start
#   npm run db:configure-api
#
# The local API dev command performs that setup automatically. This file documents
# the only three local Worker bindings it needs.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY="generated-by-npm-run-db-configure-api"
ALLOWED_ORIGINS="http://localhost:4321"
