{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pawheaven-frontend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs first only for the pages that show animals; everything else is served as static files.
    "run_worker_first": ["/", "/adopt", "/adopt/*"]
  },
  "observability": {
    "enabled": false
  },
  "preview_urls": true,
  "previews": {}
}
