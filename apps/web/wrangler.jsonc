{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pawheaven-frontend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://api.pawheaven.online"
  },
  "observability": {
    "enabled": false
  },
  "preview_urls": true,
  "previews": {}
}
