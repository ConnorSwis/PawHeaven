# Local API Worker. A deployed custom-domain build should set its own API URL.
PUBLIC_API_BASE_URL=http://localhost:8787/api
# Optional: name of a [data-theme="..."] block in packages/contracts/src/theme.css (for example "dark").
# Leave empty for the default theme. Rebuild after changing it.
PUBLIC_THEME=
# Demo: set to "true" to show a theme picker (footer on the site, header in the portal) so you can switch themes live.
PUBLIC_THEME_SWITCHER=
# Demo: set to "true" to show the Debug button (theme picker, theme editor link, status, shortcuts) on every page.
# Without it, open any page with ?debug=1 to turn the button on in that browser (?debug=0 turns it off).
PUBLIC_DEBUG_MENU=
# Where the Debug menu's "Staff portal" link goes. Defaults to https://admin.pawheaven.online.
PUBLIC_ADMIN_URL=
