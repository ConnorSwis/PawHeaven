<div class="mx-auto max-w-5xl px-6 py-12">
  <section class="border border-stone-300 bg-white p-7 sm:p-9" data-lost-pet aria-live="polite">
    <p class="text-sm text-stone-600">Checking your session…</p>
  </section>
</div>

<script>
  import { matchStrength, type ApiUser, type FieldErrors, type LostPetInquiry, type LostPetInquiryInput, type LostPetInquiryListResponse, type LostPetMatch, type LostPetSearchResponse } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';

  const container = document.querySelector<HTMLElement>('[data-lost-pet]');
  const MAX_PHOTOS = 3;
  const MAX_BYTES = 5 * 1024 * 1024;
  const TYPES = ['image/jpeg', 'image/png', 'image/webp'];

  function element(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  function flyerLink(className = 'font-medium text-[var(--color-moss-dark)] underline underline-offset-4') {
    const link = document.createElement('a');
    link.href = '/lost-pet/flyer';
    link.className = className;
    link.textContent = 'Make a printable lost-pet flyer';
    return link;
  }

  function showSignedOut() {
    if (!container) return;
    container.replaceChildren(
      element('h1', 'text-3xl font-semibold tracking-tight text-stone-950', 'Lost a pet?'),
      element('p', 'mt-4 max-w-2xl leading-7 text-stone-700', 'Log in to upload photos of your missing pet and see whether a similar animal is at the shelter. You can also make a flyer without an account.'),
    );
    const login = document.createElement('a');
    login.href = '/login';
    login.className = 'mt-7 inline-block bg-[var(--color-moss)] px-5 py-3 font-semibold text-on-brand transition-colors hover:bg-[var(--color-moss-dark)]';
    login.textContent = 'Log in to search by photo';
    const flyer = flyerLink('ml-5 inline-block font-medium text-[var(--color-moss-dark)] underline underline-offset-4');
    container.append(login, flyer);
  }

  async function inquiryRequest(payload: LostPetInquiryInput) {
    const response = await fetch(`${apiBase}/lost-pet/inquiries`, { method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const body = await response.json().catch(() => null) as { message?: unknown; fieldErrors?: FieldErrors } | null;
    if (!response.ok) {
      const failure = new Error(typeof body?.message === 'string' ? body.message : 'We could not send your message.') as Error & { fieldErrors?: FieldErrors };
      failure.fieldErrors = body?.fieldErrors;
      throw failure;
    }
  }

  function inquiryForm(card: HTMLElement, searchId: string, match: LostPetMatch, onSent: () => void) {
    const form = document.createElement('form');
    form.className = 'mt-5 grid gap-4 border-t border-stone-200 pt-5 sm:max-w-lg';
    form.noValidate = true;
    const errors = new Map<string, HTMLElement>();
    function field(name: 'phone' | 'message', labelText: string, control: HTMLInputElement | HTMLTextAreaElement, help?: string) {
      const label = document.createElement('label');
      label.className = 'block text-sm font-medium text-stone-900';
      label.textContent = labelText;
      control.name = name;
      control.className = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 font-normal text-stone-950';
      label.append(control);
      const error = element('p', 'mt-2 hidden text-sm text-red-800', '');
      error.setAttribute('role', 'alert');
      errors.set(name, error);
      const wrapper = document.createElement('div');
      wrapper.append(label);
      if (help) wrapper.append(element('p', 'mt-2 text-sm font-normal text-stone-600', help));
      wrapper.append(error);
      form.append(wrapper);
    }
    const phone = document.createElement('input');
    phone.type = 'tel';
    phone.autocomplete = 'tel';
    phone.maxLength = 30;
    const message = document.createElement('textarea');
    message.rows = 4;
    message.maxLength = 1000;
    message.placeholder = `For example: when and where your pet went missing, a collar or microchip, and any marks that were not visible in your photos.`;
    field('phone', 'Phone number', phone);
    field('message', `Message for the shelter about ${match.pet.name}`, message, 'Staff will verify this with you. A photo match does not confirm ownership.');
    const actions = document.createElement('div');
    actions.className = 'flex flex-wrap items-center gap-3';
    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'bg-[var(--color-moss)] px-5 py-3 font-semibold text-on-brand transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70';
    submit.textContent = 'Send to the shelter';
    const status = document.createElement('p');
    status.setAttribute('role', 'status');
    actions.append(submit, status);
    form.append(actions);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload: LostPetInquiryInput = { searchId, petId: match.pet.id, phone: phone.value.trim(), message: message.value.trim() };
      const problems: FieldErrors = {};
      if (payload.phone.replace(/\D/g, '').length < 10) problems.phone = 'Enter a phone number with at least 10 digits.';
      if (payload.message.length < 10) problems.message = 'Tell the shelter a little more, at least 10 characters.';
      show(problems);
      if (Object.keys(problems).length) return;
      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        await inquiryRequest(payload);
        form.replaceChildren(element('p', 'font-medium text-[var(--color-moss-dark)]', `Your message about ${match.pet.name} was sent. We emailed a confirmation and staff will contact you.`));
        onSent();
      } catch (exception) {
        const failure = exception as Error & { fieldErrors?: FieldErrors };
        if (failure.fieldErrors) show(failure.fieldErrors);
        status.textContent = failure.message;
        status.className = 'text-sm text-red-800';
        submit.disabled = false;
        submit.textContent = 'Send to the shelter';
      }
    });
    function show(fieldErrors: FieldErrors) {
      for (const [name, error] of errors) {
        error.textContent = fieldErrors[name] ?? '';
        error.classList.toggle('hidden', !fieldErrors[name]);
      }
    }
    card.append(form);
    phone.focus();
  }

  function matchCard(searchId: string, match: LostPetMatch, onSent: () => void) {
    const card = document.createElement('article');
    card.className = 'border border-stone-300 bg-white p-5';
    const layout = document.createElement('div');
    layout.className = 'grid gap-4 sm:grid-cols-[10rem_minmax(0,1fr)]';
    const image = document.createElement(match.pet.imageUrl ? 'img' : 'div');
    image.className = 'aspect-[4/3] w-full bg-stone-200 object-cover';
    if (image instanceof HTMLImageElement && match.pet.imageUrl) { image.src = match.pet.imageUrl; image.alt = `${match.pet.name} at the shelter`; }
    const body = document.createElement('div');
    const header = document.createElement('div');
    header.className = 'flex flex-wrap items-baseline justify-between gap-2';
    header.append(
      element('h3', 'text-lg font-semibold text-stone-950', match.pet.name),
      element('span', 'border border-stone-400 px-2 py-1 text-sm text-stone-800', `${matchStrength(match.confidence)} visual match`),
    );
    const contact = document.createElement('button');
    contact.type = 'button';
    contact.className = 'mt-4 border border-[var(--color-moss)] px-4 py-2 text-sm font-semibold text-[var(--color-moss-dark)] transition-colors hover:bg-[var(--color-moss)] hover:text-on-brand';
    contact.textContent = `Ask the shelter about ${match.pet.name}`;
    contact.addEventListener('click', () => {
      if (card.querySelector('form')) return;
      inquiryForm(card, searchId, match, () => { contact.remove(); onSent(); });
    });
    body.append(
      header,
      element('p', 'mt-1 text-sm text-stone-700', `${match.pet.type} · ${match.pet.breed} · ${match.pet.age} · ${match.pet.status === 'Available' ? 'Available for adoption' : match.pet.status}`),
      element('p', 'mt-3 leading-7 text-stone-800', match.reason),
      contact,
    );
    layout.append(image, body);
    card.append(layout);
    return card;
  }

  function renderResults(target: HTMLElement, result: LostPetSearchResponse, onSent: () => void) {
    target.replaceChildren(element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Possible matches'));
    if (!result.matches.length || !result.searchId) {
      target.append(element('p', 'mt-3 leading-7 text-stone-700', result.notice ?? 'We did not find a possible match right now.'), flyerLink('mt-4 inline-block font-medium text-[var(--color-moss-dark)] underline underline-offset-4'));
      return;
    }
    target.append(element('p', 'mt-2 max-w-2xl border-l-2 border-stone-400 pl-3 text-sm leading-6 text-stone-700', 'These are visual comparisons made by an AI model. A similar-looking animal is not proof that it is your pet, and ownership is confirmed by shelter staff. Pick an animal to send staff a message.'));
    const list = document.createElement('div');
    list.className = 'mt-5 grid gap-4';
    for (const match of result.matches) list.append(matchCard(result.searchId, match, onSent));
    target.append(list);
  }

  function renderInquiries(target: HTMLElement, inquiries: LostPetInquiry[]) {
    target.replaceChildren(element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Your messages to the shelter'));
    if (!inquiries.length) { target.append(element('p', 'mt-2 text-sm text-stone-700', 'You have not contacted the shelter about a possible match yet.')); return; }
    const list = document.createElement('ul');
    list.className = 'mt-4 grid gap-3';
    for (const inquiry of inquiries) {
      const item = document.createElement('li');
      item.className = 'border border-stone-300 bg-white px-4 py-3';
      item.append(
        element('p', 'font-medium text-stone-950', inquiry.petName),
        element('p', 'mt-1 text-sm text-stone-700', `Status: ${inquiry.status} · Sent ${new Date(inquiry.createdAt).toLocaleDateString()}`),
        element('p', 'mt-2 whitespace-pre-wrap text-sm leading-6 text-stone-800', inquiry.message),
      );
      list.append(item);
    }
    target.append(list);
  }

  async function loadInquiries(target: HTMLElement) {
    try {
      const response = await fetch(`${apiBase}/lost-pet/inquiries`, { credentials: 'include' });
      if (!response.ok) throw new Error();
      renderInquiries(target, (await response.json() as LostPetInquiryListResponse).inquiries);
    } catch {
      target.replaceChildren(element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Your messages to the shelter'), element('p', 'mt-2 text-sm text-stone-700', 'We could not load your messages right now.'));
    }
  }

  function renderSearch(user: ApiUser) {
    if (!container) return;
    container.replaceChildren(
      element('h1', 'text-3xl font-semibold tracking-tight text-stone-950', 'Lost a pet?'),
      element('p', 'mt-4 max-w-2xl leading-7 text-stone-700', 'Upload up to three clear photos of your missing pet. We compare them with the photos of animals in our care and show any that look similar, so you can ask staff to check.'),
      element('p', 'mt-2 max-w-2xl text-sm leading-6 text-stone-600', `Your photos are sent to an AI provider for comparison. If there are no possible matches your photos are deleted right away; if there are, they are kept for 30 days so staff can verify, then deleted. We email ${user.email} about your messages.`),
      flyerLink('mt-3 inline-block font-medium text-[var(--color-moss-dark)] underline underline-offset-4'),
    );
    const form = document.createElement('form');
    form.className = 'mt-8 grid gap-5 border-t border-stone-300 pt-7 sm:max-w-xl';
    form.noValidate = true;
    const errors = new Map<string, HTMLElement>();
    const inputClass = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 font-normal text-stone-950';

    function wrap(name: string, labelText: string, control: HTMLElement, help?: string) {
      const label = document.createElement('label');
      label.className = 'block text-sm font-medium text-stone-900';
      label.textContent = labelText;
      label.append(control);
      const error = element('p', 'mt-2 hidden text-sm text-red-800', '');
      error.setAttribute('role', 'alert');
      errors.set(name, error);
      const wrapper = document.createElement('div');
      wrapper.append(label);
      if (help) wrapper.append(element('p', 'mt-2 text-sm font-normal text-stone-600', help));
      wrapper.append(error);
      form.append(wrapper);
    }
    const species = document.createElement('select');
    species.className = inputClass;
    for (const value of ['Dog', 'Cat', 'Other']) { const option = document.createElement('option'); option.value = value; option.textContent = value; species.append(option); }
    const description = document.createElement('textarea');
    description.rows = 3;
    description.maxLength = 300;
    description.className = inputClass;
    description.placeholder = 'Color, markings, size, collar, anything that stands out';
    const photos = document.createElement('input');
    photos.type = 'file';
    photos.accept = TYPES.join(',');
    photos.multiple = true;
    photos.className = 'mt-2 block w-full text-sm text-stone-700 file:mr-4 file:border-0 file:bg-stone-200 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-stone-900';
    wrap('species', 'Kind of animal', species);
    wrap('description', 'Describe your pet (optional)', description);
    wrap('photos', 'Photos of your pet', photos, `Up to ${MAX_PHOTOS} JPEG, PNG, or WebP photos, each smaller than 5 MB. Clear, well-lit photos of the face and body work best.`);
    const previews = document.createElement('div');
    previews.className = 'flex flex-wrap gap-2';
    form.append(previews);
    photos.addEventListener('change', () => {
      previews.replaceChildren();
      for (const file of [...(photos.files ?? [])].slice(0, MAX_PHOTOS)) {
        if (!TYPES.includes(file.type)) continue;
        const image = document.createElement('img');
        image.src = URL.createObjectURL(file);
        image.alt = 'Selected photo preview';
        image.className = 'size-20 object-cover';
        image.addEventListener('load', () => URL.revokeObjectURL(image.src), { once: true });
        previews.append(image);
      }
    });
    const actions = document.createElement('div');
    actions.className = 'flex flex-wrap items-center gap-3';
    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'bg-[var(--color-moss)] px-5 py-3 font-semibold text-on-brand transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70';
    submit.textContent = 'Search by photo';
    const status = document.createElement('p');
    status.setAttribute('role', 'status');
    actions.append(submit, status);
    form.append(actions);

    const results = document.createElement('section');
    results.className = 'mt-9 border-t border-stone-300 pt-7';
    results.hidden = true;
    results.setAttribute('aria-live', 'polite');
    const inquiries = document.createElement('section');
    inquiries.className = 'mt-9 border-t border-stone-300 pt-7';
    inquiries.setAttribute('aria-live', 'polite');
    container.append(form, results, inquiries);
    void loadInquiries(inquiries);

    function show(fieldErrors: FieldErrors) {
      for (const [name, error] of errors) {
        error.textContent = fieldErrors[name] ?? '';
        error.classList.toggle('hidden', !fieldErrors[name]);
      }
    }
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const files = [...(photos.files ?? [])];
      const problems: FieldErrors = {};
      if (!files.length) problems.photos = 'Add at least one photo of your pet.';
      else if (files.length > MAX_PHOTOS) problems.photos = `Choose at most ${MAX_PHOTOS} photos.`;
      else if (files.some((file) => !TYPES.includes(file.type))) problems.photos = 'Photos must be JPEG, PNG, or WebP images.';
      else if (files.some((file) => file.size > MAX_BYTES)) problems.photos = 'Each photo must be smaller than 5 MB.';
      show(problems);
      if (Object.keys(problems).length) { status.textContent = 'Please correct the highlighted fields.'; status.className = 'text-sm text-red-800'; return; }
      const data = new FormData();
      data.append('species', species.value);
      data.append('description', description.value.trim());
      for (const file of files) data.append('photos', file);
      submit.disabled = true;
      submit.textContent = 'Comparing photos…';
      status.textContent = 'This can take up to a minute.';
      status.className = 'text-sm text-stone-700';
      try {
        const response = await fetch(`${apiBase}/lost-pet/searches`, { method: 'POST', credentials: 'include', body: data });
        const payload = await response.json().catch(() => null) as (LostPetSearchResponse & { message?: unknown; fieldErrors?: FieldErrors }) | null;
        if (!response.ok) {
          if (payload?.fieldErrors) show(payload.fieldErrors);
          throw new Error(typeof payload?.message === 'string' ? payload.message : 'We could not compare your photos right now.');
        }
        status.textContent = '';
        results.hidden = false;
        renderResults(results, payload as LostPetSearchResponse, () => void loadInquiries(inquiries));
        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (exception) {
        status.textContent = exception instanceof Error ? exception.message : 'We could not compare your photos right now.';
        status.className = 'text-sm text-red-800';
      } finally {
        submit.disabled = false;
        submit.textContent = 'Search by photo';
      }
    });
  }

  async function load() {
    try {
      const response = await fetch(`${apiBase}/auth/me`, { credentials: 'include' });
      if (response.status === 401) return showSignedOut();
      if (!response.ok) throw new Error();
      renderSearch((await response.json() as { user: ApiUser }).user);
    } catch {
      if (!container) return;
      container.replaceChildren(
        element('h1', 'text-3xl font-semibold tracking-tight text-stone-950', 'Lost-pet search is unavailable'),
        element('p', 'mt-4 leading-7 text-stone-700', 'We could not load this page right now. Please try again shortly, or call the shelter.'),
      );
    }
  }

  void load();
</script>
