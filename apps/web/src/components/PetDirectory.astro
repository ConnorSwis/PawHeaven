---
const seedPets = [
  { id: 'maple', name: 'Maple', type: 'Dog', breed: 'Golden Retriever mix', age: '3 years', intakeDate: '2026-09-18', daysInShelter: 18, tags: ['big-dog', 'good-with-kids'], status: 'Available', summary: 'Maple is an affectionate young dog who enjoys gentle walks, quiet afternoons, and meeting new people.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/maple.jpg' },
  { id: 'milo', name: 'Milo', type: 'Dog', breed: 'Welsh Springer Spaniel', age: '2 years', intakeDate: '2026-08-25', daysInShelter: 42, tags: ['active', 'friendly'], status: 'Available', summary: 'Milo is a bright, active spaniel who would love regular exercise and plenty of time with his people.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/milo.jpg' },
  { id: 'nala', name: 'Nala', type: 'Dog', breed: 'White German Shepherd mix', age: '5 years', intakeDate: '2026-07-22', daysInShelter: 76, tags: ['big-dog', 'gentle'], status: 'Available', summary: 'Nala is a gentle companion who is ready for patient people, peaceful walks, and lots of room to explore.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/nala.jpg' },
  { id: 'pepper', name: 'Pepper', type: 'Dog', breed: 'Cavalier King Charles Spaniel', age: '1 year', intakeDate: '2026-09-27', daysInShelter: 9, tags: ['playful', 'small-dog'], status: 'Available', summary: 'Pepper is a playful young dog who enjoys toys, close company, and a little attention each day.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/pepper.jpg' },
];
const initialSearch = Astro.url.searchParams.get('search') ?? '';
const initialTag = Astro.url.searchParams.get('tag') ?? '';
---

<div class="mx-auto max-w-6xl px-6 py-10 sm:py-14">
  <section aria-labelledby="pet-directory-title">
    <p class="text-sm font-medium text-stone-600">PawHeaven</p>
    <h1 id="pet-directory-title" class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Pets available for adoption</h1>
    <p class="mt-3 max-w-2xl leading-7 text-stone-700">Listings are kept in alphabetical order. Search by name, description, breed, age, type, or shelter tag to find a pet that fits your home.</p>

    <form class="mt-8 grid gap-4 border-y border-stone-300 py-5 md:grid-cols-[minmax(0,1fr)_15rem_auto] md:items-end" data-pet-filters>
      <div>
        <label class="mb-2 block text-sm font-medium text-stone-900" for="pet-search">Search pets</label>
        <input class="block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 placeholder:text-stone-500" id="pet-search" name="search" type="search" placeholder="Try gentle, retriever, or good with kids" value={initialSearch} />
      </div>
      <div>
        <label class="mb-2 block text-sm font-medium text-stone-900" for="pet-tag">Shelter tag</label>
        <select class="block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950" id="pet-tag" name="tag">
          <option value="" selected={!initialTag}>All tags</option>
          <option value="big-dog" selected={initialTag === 'big-dog'}>Big dog</option>
          <option value="good-with-kids" selected={initialTag === 'good-with-kids'}>Good with kids</option>
          <option value="calm" selected={initialTag === 'calm'}>Calm</option>
          <option value="indoor" selected={initialTag === 'indoor'}>Indoor</option>
          <option value="playful" selected={initialTag === 'playful'}>Playful</option>
        </select>
      </div>
      <button class="bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]" type="submit">Search</button>
    </form>

    <p class="mt-5 text-sm text-stone-600" data-results-status aria-live="polite">Showing available pets.</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-pet-results data-pets={JSON.stringify(seedPets)}>
      {seedPets.map((pet) => (
        <article class="flex min-h-56 flex-col border border-stone-300 bg-white p-5">
          <div class="flex items-start justify-between gap-4">
            <p class="text-sm font-medium text-[var(--color-moss-dark)]">{pet.type}</p>
            <span class="border border-stone-300 px-2 py-1 text-xs font-medium text-stone-700">{pet.status}</span>
          </div>
          <h2 class="mt-7 text-xl font-semibold text-stone-950"><a class="underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950" href={`/pets/details?id=${pet.id}`}>{pet.name}</a></h2>
          <p class="mt-2 text-stone-700">{pet.breed} · {pet.age}</p>
          <p class="mt-3 leading-6 text-stone-700">{pet.summary}</p>
          <p class="mt-3 text-sm text-stone-700"><span class="font-medium text-stone-900">In shelter:</span> {pet.daysInShelter} days</p>
          <div class="mt-5 flex flex-wrap gap-2" aria-label={`${pet.name} tags`}>
            {pet.tags.map((tag) => <span class="border border-stone-300 px-2 py-1 text-xs text-stone-700">{tag.replaceAll('-', ' ')}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<script>
  import { matchesPetSearch, type Pet } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';

  const results = document.querySelector<HTMLElement>('[data-pet-results]');
  const form = document.querySelector<HTMLFormElement>('[data-pet-filters]');
  const status = document.querySelector<HTMLElement>('[data-results-status]');
  const seedPets: Pet[] = JSON.parse(results?.dataset.pets || '[]');
  let source: 'pending' | 'live' | 'sample' = 'pending';
  let searchTimer: number | undefined;
  let latestSearch = 0;

  function matches(pet: Pet, search: string, tag: string) {
    return matchesPetSearch(pet, search) && (!tag || pet.tags.includes(tag));
  }

  function displayPets(pets: Pet[]) {
    if (!results) return;
    results.replaceChildren();
    if (pets.length === 0) {
      const message = document.createElement('p');
      message.className = 'sm:col-span-2 lg:col-span-3 border border-stone-300 bg-white p-5 text-stone-700';
      message.textContent = 'No pets match that search. Try another word or shelter tag.';
      results.append(message);
      return;
    }
    [...pets].sort((first, second) => first.name.localeCompare(second.name)).forEach((pet) => {
      const card = document.createElement('article');
      card.className = 'flex min-h-56 flex-col border border-stone-300 bg-white p-5';
      const top = document.createElement('div');
      top.className = 'flex items-start justify-between gap-4';
      const type = document.createElement('p');
      type.className = 'text-sm font-medium text-[var(--color-moss-dark)]';
      type.textContent = pet.type;
      const availability = document.createElement('span');
      availability.className = 'border border-stone-300 px-2 py-1 text-xs font-medium text-stone-700';
      availability.textContent = pet.status;
      top.append(type, availability);
      const title = document.createElement('h2');
      title.className = 'mt-7 text-xl font-semibold text-stone-950';
      const link = document.createElement('a');
      link.className = 'underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950';
      link.href = `/pets/details?id=${encodeURIComponent(pet.id)}`;
      link.textContent = pet.name;
      title.append(link);
      const details = document.createElement('p');
      details.className = 'mt-2 text-stone-700';
      details.textContent = `${pet.breed} · ${pet.age}`;
      const description = document.createElement('p');
      description.className = 'mt-3 leading-6 text-stone-700';
      description.textContent = pet.summary;
      const stay = document.createElement('p');
      stay.className = 'mt-3 text-sm text-stone-700';
      stay.textContent = `In shelter: ${pet.daysInShelter} days`;
      const tags = document.createElement('div');
      tags.className = 'mt-5 flex flex-wrap gap-2';
      tags.setAttribute('aria-label', `${pet.name} tags`);
      pet.tags.forEach((tag) => {
        const tagElement = document.createElement('span');
        tagElement.className = 'border border-stone-300 px-2 py-1 text-xs text-stone-700';
        tagElement.textContent = tag.replaceAll('-', ' ');
        tags.append(tagElement);
      });
      if (pet.imageUrl) {
        const image = document.createElement('img');
        image.src = pet.imageUrl;
        image.alt = `${pet.name} at PawHeaven`;
        image.className = 'mt-4 aspect-[4/3] w-full object-cover';
        card.append(top, image, title, details, description, stay, tags);
      } else card.append(top, title, details, description, stay, tags);
      results.append(card);
    });
  }

  function filters() {
    if (!form) return { search: '', tag: '' };
    const values = new FormData(form);
    return { search: String(values.get('search') || '').trim(), tag: String(values.get('tag') || '') };
  }

  function queryFor(search: string, tag: string) {
    const query = new URLSearchParams({ sort: 'name_asc' });
    if (search) query.set('search', search);
    if (tag) query.set('tag', tag);
    return query;
  }

  function syncUrl(search: string, tag: string) {
    const url = new URL(window.location.href);
    url.search = '';
    if (search) url.searchParams.set('search', search);
    if (tag) url.searchParams.set('tag', tag);
    window.history.replaceState({}, '', `${url.pathname}${url.search}`);
  }

  function restoreFiltersFromUrl() {
    if (!form) return;
    const params = new URLSearchParams(window.location.search);
    const search = form.elements.namedItem('search');
    const tag = form.elements.namedItem('tag');
    if (search instanceof HTMLInputElement) search.value = params.get('search') ?? '';
    if (tag instanceof HTMLSelectElement) tag.value = params.get('tag') ?? '';
  }

  function showSampleResults(search: string, tag: string) {
    const pets = seedPets.filter((pet) => matches(pet, search, tag));
    displayPets(pets);
    if (status) status.textContent = pets.length === 0
      ? 'No sample pets match that search. Try another word or shelter tag.'
      : `Showing ${pets.length} sample ${pets.length === 1 ? 'listing' : 'listings'} while shelter listings are being added.`;
  }

  async function chooseSource() {
    try {
      const response = await fetch(`${apiBase}/pets?${queryFor('', '')}`, { credentials: 'include' });
      if (!response.ok) throw new Error('Pet directory is unavailable.');
      const payload = await response.json() as { pets?: Pet[] };
      source = payload.pets?.length ? 'live' : 'sample';
    } catch {
      source = 'sample';
    }
  }

  async function loadPets() {
    const searchNumber = ++latestSearch;
    const { search, tag } = filters();
    syncUrl(search, tag);
    if (status) status.textContent = source === 'pending' ? 'Loading available pets…' : 'Searching available pets…';
    if (source === 'pending') await chooseSource();
    if (searchNumber !== latestSearch) return;
    if (source === 'sample') return showSampleResults(search, tag);
    try {
      const response = await fetch(`${apiBase}/pets?${queryFor(search, tag)}`, { credentials: 'include' });
      if (!response.ok) throw new Error('Pet search is unavailable.');
      const payload = await response.json() as { pets?: Pet[] };
      if (searchNumber !== latestSearch) return;
      const pets = payload.pets ?? [];
      displayPets(pets);
      if (status) status.textContent = `${pets.length} ${pets.length === 1 ? 'pet' : 'pets'} found.`;
    } catch {
      if (searchNumber !== latestSearch) return;
      source = 'sample';
      showSampleResults(search, tag);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(searchTimer);
    void loadPets();
  });
  const searchInput = form?.elements.namedItem('search');
  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => void loadPets(), 250);
    });
  }
  const tagSelect = form?.elements.namedItem('tag');
  if (tagSelect instanceof HTMLSelectElement) {
    tagSelect.addEventListener('change', () => {
      window.clearTimeout(searchTimer);
      void loadPets();
    });
  }
  restoreFiltersFromUrl();
  void loadPets();
</script>
