---
const initialSearch = Astro.url.searchParams.get('search') ?? '';
---

<div class="mx-auto max-w-6xl px-6 py-10 sm:py-14">
  <section aria-labelledby="pet-directory-title">
    <p class="text-sm font-medium text-stone-600">PawHeaven</p>
    <h1 id="pet-directory-title" class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Pets available for adoption</h1>
    <p class="mt-3 max-w-2xl leading-7 text-stone-700">Listings are kept in alphabetical order. Search by name, description, breed, age, type, or “foster” to find a pet that fits your home.</p>

    <form class="mt-8 grid gap-4 border-y border-stone-300 py-5 md:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_11rem_11rem_auto] lg:items-end" data-pet-filters>
      <div>
        <label class="mb-2 block text-sm font-medium text-stone-900" for="pet-search">Search pets</label>
        <input class="block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 placeholder:text-stone-500" id="pet-search" name="search" type="search" placeholder="Try gentle, retriever, or good with kids" value={initialSearch} />
      </div>
      <div>
        <label class="mb-2 block text-sm font-medium text-stone-900" for="pet-species">Species</label>
        <select class="block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950" id="pet-species" name="species">
          <option value="">All species</option>
          <option value="Cat">Cats</option><option value="Dog">Dogs</option><option value="Rabbit">Rabbits</option>
        </select>
      </div>
      <div>
        <label class="mb-2 block text-sm font-medium text-stone-900" for="pet-age">Age</label>
        <select class="block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950" id="pet-age" name="age">
          <option value="">Any age</option><option value="young">Under 1 year</option><option value="adult">1–7 years</option><option value="senior">8+ years</option>
        </select>
      </div>
      <button class="bg-[var(--color-moss)] px-5 py-3 font-semibold text-on-brand transition-colors hover:bg-[var(--color-moss-dark)]" type="submit">Search</button>
    </form>

    <p class="mt-5 text-sm text-stone-600" data-results-status aria-live="polite">Loading available pets…</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-pet-results></div>
  </section>
</div>

<script>
  import { matchesPetSearch, type Pet } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';
  import { hasPetImage, publicPets } from '../lib/pet-discovery';

  const results = document.querySelector<HTMLElement>('[data-pet-results]');
  const form = document.querySelector<HTMLFormElement>('[data-pet-filters]');
  const status = document.querySelector<HTMLElement>('[data-results-status]');
  let searchTimer: number | undefined;
  let latestSearch = 0;

  function matches(pet: Pet, search: string, tag: string, species: string, ageGroup: string) {
    const age = pet.age.toLocaleLowerCase();
    const years = Number(age.match(/[\d.]+/)?.[0] ?? NaN);
    const ageYears = age.includes('month') ? years / 12 : years;
    const ageMatches = !ageGroup || (ageGroup === 'young' && Number.isFinite(ageYears) && ageYears < 1)
      || (ageGroup === 'adult' && Number.isFinite(ageYears) && ageYears >= 1 && ageYears < 8)
      || (ageGroup === 'senior' && Number.isFinite(ageYears) && ageYears >= 8);
    return matchesPetSearch(pet, search) && (!tag || pet.tags.includes(tag))
      && (!species || pet.type.toLocaleLowerCase() === species.toLocaleLowerCase()) && ageMatches;
  }

  function displayPets(pets: Pet[]) {
    if (!results) return;
    results.replaceChildren();
    if (pets.length === 0) {
      const message = document.createElement('p');
      message.className = 'sm:col-span-2 lg:col-span-3 border border-stone-300 bg-white p-5 text-stone-700';
      message.textContent = 'No pets match that search. Try another word.';
      results.append(message);
      return;
    }
    publicPets(pets).forEach((pet) => {
      const card = document.createElement('article');
      card.className = 'flex min-h-56 flex-col border border-stone-300 bg-white p-5';
      const top = document.createElement('div');
      top.className = 'flex items-start justify-between gap-4';
      const type = document.createElement('p');
      type.className = 'text-sm font-medium text-[var(--color-moss-dark)]';
      type.textContent = pet.type;
      const availability = document.createElement('span');
      availability.className = 'border border-stone-300 px-2 py-1 text-xs font-medium text-stone-700';
      availability.textContent = pet.status;
      const badges = document.createElement('div');
      badges.className = 'flex flex-wrap justify-end gap-2';
      badges.append(availability);
      if (pet.fosterAvailable) {
        const foster = document.createElement('span');
        foster.className = 'border border-[var(--color-moss)] px-2 py-1 text-xs font-medium text-[var(--color-moss-dark)]';
        foster.textContent = pet.fosterUrgent ? 'Foster needed now' : 'Open to foster';
        badges.append(foster);
      }
      if (pet.needsWalkers) {
        const walkers = document.createElement('span');
        walkers.className = 'border border-stone-300 px-2 py-1 text-xs font-medium text-stone-700';
        walkers.textContent = 'Needs walkers';
        badges.append(walkers);
      }
      top.append(type, badges);
      const title = document.createElement('h2');
      title.className = 'mt-7 text-xl font-semibold text-stone-950';
      const link = document.createElement('a');
      link.className = 'underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950';
      link.href = `/pets/details?id=${encodeURIComponent(pet.id)}`;
      link.textContent = pet.name;
      title.append(link);
      const details = document.createElement('p');
      details.className = 'mt-2 text-stone-700';
      details.textContent = `${pet.breed} · ${pet.age}`;
      const description = document.createElement('p');
      description.className = 'mt-3 line-clamp-3 leading-6 text-stone-700';
      description.textContent = pet.summary;
      const stay = document.createElement('p');
      stay.className = 'mt-3 text-sm text-stone-700';
      stay.textContent = `In shelter: ${pet.daysInShelter} days`;
      const tags = document.createElement('div');
      tags.className = 'mt-5 flex flex-wrap gap-2';
      tags.setAttribute('aria-label', `${pet.name} tags`);
      pet.tags.forEach((tag) => {
        const tagElement = document.createElement('span');
        tagElement.className = 'border border-stone-300 px-2 py-1 text-xs text-stone-700';
        tagElement.textContent = tag.replaceAll('-', ' ');
        tags.append(tagElement);
      });
      if (hasPetImage(pet)) {
        const image = document.createElement('img');
        image.src = pet.imageUrl;
        image.alt = `${pet.name} at PawHeaven`;
        image.className = 'mt-4 aspect-[4/3] w-full object-cover';
        card.append(top, image, title, details, description, stay, tags);
      } else card.append(top, title, details, description, stay, tags);
      results.append(card);
    });
  }

  function filters() {
    if (!form) return { search: '', tag: '', species: '', age: '' };
    const values = new FormData(form);
    return { search: String(values.get('search') || '').trim(), tag: String(values.get('tag') || ''), species: String(values.get('species') || ''), age: String(values.get('age') || '') };
  }

  function queryFor(search: string, tag: string) {
    const query = new URLSearchParams({ sort: 'name_asc' });
    if (search) query.set('search', search);
    if (tag) query.set('tag', tag);
    return query;
  }

  function syncUrl(search: string, tag: string, species: string, age: string) {
    const url = new URL(window.location.href);
    url.search = '';
    if (search) url.searchParams.set('search', search);
    if (tag) url.searchParams.set('tag', tag);
    if (species) url.searchParams.set('species', species);
    if (age) url.searchParams.set('age', age);
    window.history.replaceState({}, '', `${url.pathname}${url.search}`);
  }

  function restoreFiltersFromUrl() {
    if (!form) return;
    const params = new URLSearchParams(window.location.search);
    const search = form.elements.namedItem('search');
    const tag = form.elements.namedItem('tag');
    const species = form.elements.namedItem('species');
    const age = form.elements.namedItem('age');
    if (search instanceof HTMLInputElement) search.value = params.get('search') ?? '';
    if (tag instanceof HTMLSelectElement) tag.value = params.get('tag') ?? '';
    if (species instanceof HTMLSelectElement) species.value = params.get('species') ?? '';
    if (age instanceof HTMLSelectElement) age.value = params.get('age') ?? '';
  }

  async function loadPets() {
    const searchNumber = ++latestSearch;
    const { search, tag, species, age } = filters();
    syncUrl(search, tag, species, age);
    if (status) status.textContent = 'Searching available pets…';
    try {
      const response = await fetch(`${apiBase}/pets?${queryFor(search, tag)}`, { credentials: 'include' });
      if (!response.ok) throw new Error('Pet search is unavailable.');
      const payload = await response.json() as { pets?: Pet[] };
      if (searchNumber !== latestSearch) return;
      const pets = publicPets((payload.pets ?? []).filter((pet) => matches(pet, search, tag, species, age)));
      displayPets(pets);
      if (status) status.textContent = `${pets.length} ${pets.length === 1 ? 'pet' : 'pets'} found.`;
    } catch {
      if (searchNumber !== latestSearch) return;
      results?.replaceChildren();
      if (status) status.textContent = 'Pet listings are unavailable right now. Please try again in a moment.';
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(searchTimer);
    void loadPets();
  });
  const searchInput = form?.elements.namedItem('search');
  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => void loadPets(), 250);
    });
  }
  const tagSelect = form?.elements.namedItem('tag');
  if (tagSelect instanceof HTMLSelectElement) {
    tagSelect.addEventListener('change', () => {
      window.clearTimeout(searchTimer);
      void loadPets();
    });
  }
  for (const fieldName of ['species', 'age']) {
    const control = form?.elements.namedItem(fieldName);
    if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement) {
      control.addEventListener('change', () => { void loadPets(); });
    }
  }
  restoreFiltersFromUrl();
  void loadPets();
</script>
