---
const seedPets = [
  { id: 'maple', name: 'Maple', type: 'Dog', breed: 'Golden Retriever mix', age: '3 years', daysInShelter: 18, tags: ['big-dog', 'good-with-kids'], status: 'Available', summary: 'Maple is an affectionate young dog who enjoys gentle walks, quiet afternoons, and meeting new people.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/maple.jpg' },
  { id: 'milo', name: 'Milo', type: 'Dog', breed: 'Welsh Springer Spaniel', age: '2 years', daysInShelter: 42, tags: ['active', 'friendly'], status: 'Available', summary: 'Milo is a bright, active spaniel who would love regular exercise and plenty of time with his people.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/milo.jpg' },
  { id: 'nala', name: 'Nala', type: 'Dog', breed: 'White German Shepherd mix', age: '5 years', daysInShelter: 76, tags: ['big-dog', 'gentle'], status: 'Available', summary: 'Nala is a gentle companion who is ready for patient people, peaceful walks, and lots of room to explore.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/nala.jpg' },
  { id: 'pepper', name: 'Pepper', type: 'Dog', breed: 'Cavalier King Charles Spaniel', age: '1 year', daysInShelter: 9, tags: ['playful', 'small-dog'], status: 'Available', summary: 'Pepper is a playful young dog who enjoys toys, close company, and a little attention each day.', imageUrl: 'https://zzcbjfgyibhuhlylsvhs.supabase.co/storage/v1/object/public/pet-images/seed/pepper.jpg' },
];
---

<div class="mx-auto grid max-w-5xl place-items-center px-6 py-12">
  <article class="w-full max-w-2xl border border-stone-300 bg-white p-7 sm:p-10" data-pet-detail data-pets={JSON.stringify(seedPets)} aria-live="polite">
    <p class="text-sm text-stone-600">Loading pet details…</p>
  </article>
</div>

<script>
  import type { AdoptionApplication, AdoptionApplicationInput, AdoptionApplicationListResponse, ApiUser, FieldErrors, FosterApplication, FosterApplicationInput, FosterApplicationListResponse, Pet } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';
  import { prefillContact, saveDetailsBox, saveProfile } from '../lib/profile';
  import { matchStrength, type LatestQuizResponse } from '@pawheaven/contracts';
  import { canStartApplication, hasPetImage } from '../lib/pet-discovery';
  const container = document.querySelector<HTMLElement>('[data-pet-detail]');
  const seedPets: Pet[] = JSON.parse(container?.dataset.pets || '[]');
  const id = new URLSearchParams(window.location.search).get('id') || 'maple';

  function element(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  /** Recorded attributes only: an empty or Unknown value is simply not shown. */
  function attributesList(pet: Pet) {
    const rows: [string, string][] = [];
    if (pet.sex) rows.push(['Sex', pet.sex]);
    if (pet.size || pet.weightLbs) rows.push(['Size', [pet.size, pet.weightLbs ? `${pet.weightLbs} lb` : ''].filter(Boolean).join(', ')]);
    if (pet.color) rows.push(['Color', pet.color]);
    if (pet.spayedNeutered && pet.spayedNeutered !== 'Unknown') rows.push(['Spayed or neutered', pet.spayedNeutered]);
    const good = [['kids', pet.goodWithKids], ['dogs', pet.goodWithDogs], ['cats', pet.goodWithCats]] as const;
    const yes = good.filter(([, value]) => value === 'Yes').map(([label]) => label);
    const no = good.filter(([, value]) => value === 'No').map(([label]) => label);
    if (yes.length || no.length) rows.push(['Good with', [yes.join(', '), no.length ? `not with ${no.join(' or ')}` : ''].filter(Boolean).join('; ')]);
    if (pet.energyLevel) rows.push(['Energy level', pet.energyLevel]);
    const list = document.createElement('dl');
    list.className = rows.length ? 'grid border-b border-stone-300 sm:grid-cols-3' : 'hidden';
    for (const [term, value] of rows) {
      const item = document.createElement('div');
      item.className = 'border-stone-300 py-4 sm:border-r sm:px-4 first:sm:pl-0 last:sm:border-r-0';
      item.append(element('dt', 'text-sm text-stone-600', term), element('dd', 'mt-1 font-medium text-stone-950', value));
      list.append(item);
    }
    return list;
  }

  async function showQuizFit(pet: Pet, target: HTMLElement) {
    try {
      const response = await fetch(`${apiBase}/quiz/latest`, { credentials: 'include' });
      if (!response.ok) return;
      const { result } = await response.json() as LatestQuizResponse;
      const match = result?.recommendations.find((recommendation) => recommendation.pet.id === pet.id);
      if (match) {
        const strength = matchStrength(match.score);
        target.className = 'mt-6 border border-stone-300 bg-white p-6';
        const header = document.createElement('div');
        header.className = 'flex flex-wrap items-baseline justify-between gap-2';
        header.append(element('h2', 'text-base font-semibold text-stone-950', `Why ${pet.name} might suit you`), element('span', `border px-2 py-1 text-xs ${strength === 'Strong' ? 'border-[var(--color-moss)] bg-[#f1f5ee] text-[var(--color-moss-dark)]' : 'border-stone-400 text-stone-700'}`, `${strength} match`));
        target.append(header, element('p', 'mt-3 text-sm leading-6 text-stone-700', match.reason));
      } else if (result === null) {
        target.className = 'mt-6 border border-dashed border-stone-400 bg-white p-6';
        const link = document.createElement('a');
        link.href = '/quiz';
        link.className = 'font-medium text-[var(--color-moss-dark)] underline underline-offset-4';
        link.textContent = 'Take the two-minute quiz';
        target.append(element('p', 'text-sm leading-6 text-stone-700', `Not sure ${pet.name} is the right fit? `), link);
      }
    } catch { /* The match card is a bonus; the page works without it. */ }
  }

  function displayPet(pet: Pet, note?: string) {
    if (!container) return;
    container.replaceChildren();
    const category = element('p', 'text-sm font-medium text-[var(--color-moss-dark)]', `${pet.type} · ${pet.status}${pet.fosterAvailable ? ' · Open to foster' : ''}`);
    const name = element('h1', 'mt-3 text-3xl font-semibold tracking-tight text-stone-950', pet.name);
    const description = element('p', 'mt-5 max-w-xl leading-7 text-stone-700', pet.summary);
    const credit = document.createElement('p');
    credit.className = 'mt-3 text-sm text-stone-600';
    if (pet.housing) credit.append(`Currently in ${pet.housing === 'Foster home' ? 'a foster home' : 'the shelter'}. `);
    if (pet.sourceName) {
      credit.append('Listing from ');
      const source = document.createElement('a');
      source.textContent = pet.sourceName;
      if (/^https:\/\//.test(pet.sourceUrl ?? '')) { source.href = pet.sourceUrl; source.target = '_blank'; source.rel = 'noopener noreferrer'; source.className = 'underline underline-offset-4'; }
      credit.append(source, '.');
    }
    const gallery = document.createElement('div');
    gallery.className = 'mt-3 flex flex-wrap gap-2';
    for (const url of (pet.galleryUrls ?? []).filter((item) => /^https:\/\//.test(item)).slice(0, 4)) {
      const thumb = document.createElement('img');
      thumb.src = url;
      thumb.alt = `More photos of ${pet.name}`;
      thumb.loading = 'lazy';
      thumb.className = 'h-20 w-28 object-cover';
      gallery.append(thumb);
    }
    const details = document.createElement('dl');
    details.className = 'mt-8 grid border-y border-stone-300 sm:grid-cols-3';
    [['Breed', pet.breed], ['Age', pet.age], ['Time in shelter', `${pet.daysInShelter} days`]].forEach(([term, value]) => {
      const item = document.createElement('div');
      item.className = 'border-stone-300 py-4 sm:border-r sm:px-4 first:sm:pl-0 last:sm:border-r-0';
      item.append(element('dt', 'text-sm text-stone-600', term), element('dd', 'mt-1 font-medium text-stone-950', value));
      details.append(item);
    });
    const tagHeading = element('h2', 'mt-7 text-base font-semibold text-stone-950', 'Shelter tags');
    const tags = document.createElement('div');
    tags.className = 'mt-3 flex flex-wrap gap-2';
    pet.tags.forEach((tag) => tags.append(element('span', 'border border-stone-300 px-2 py-1 text-sm text-stone-700', tag.replaceAll('-', ' '))));
    const medicalHeading = element('h2', 'mt-7 text-base font-semibold text-stone-950', 'Medical history');
    const medical = element('p', 'mt-3 max-w-xl whitespace-pre-wrap leading-7 text-stone-700', pet.medicalHistory?.trim() || 'No medical history has been recorded for this animal yet. Ask the shelter team for details.');
    const back = document.createElement('a');
    back.href = '/pets';
    back.className = 'mt-8 inline-block font-medium text-[var(--color-moss-dark)] underline underline-offset-4';
    back.textContent = 'Back to available pets';
    container.append(category, name);
    if (hasPetImage(pet)) {
      const image = document.createElement('img');
      image.src = pet.imageUrl;
      image.alt = `${pet.name} at PawHeaven`;
      image.className = 'mt-6 aspect-[4/3] w-full object-cover';
      container.append(image);
    }
    const samplePet = Boolean(note);
    const application = document.createElement('section');
    application.className = 'mt-5';
    application.setAttribute('aria-live', 'polite');
    const adoptBox = document.createElement('details');
    adoptBox.id = 'adopt';
    adoptBox.className = 'mt-6 border border-stone-300 bg-white p-6';
    adoptBox.append(element('summary', 'cursor-pointer text-lg font-semibold text-stone-950', `Apply to adopt ${pet.name}`), application);

    let fosterBox: HTMLDetailsElement | null = null;
    if (pet.fosterAvailable) {
      const foster = document.createElement('section');
      foster.className = 'mt-5';
      foster.setAttribute('aria-live', 'polite');
      fosterBox = document.createElement('details');
      fosterBox.id = 'foster';
      fosterBox.className = 'mt-4 border border-stone-300 bg-white p-6';
      fosterBox.append(element('summary', 'cursor-pointer text-lg font-semibold text-stone-950', `Apply to foster ${pet.name}`), foster);
      void displayFosterForm(pet, foster, samplePet);
    }

    // One panel for everything a visitor can do about this pet.
    const actions = document.createElement('section');
    actions.className = 'mt-8 border border-[var(--color-moss)] bg-white p-6';
    actions.append(element('h2', 'text-lg font-semibold text-stone-950', 'What would you like to do?'));
    const buttons = document.createElement('div');
    buttons.className = 'mt-4 grid gap-3 sm:grid-cols-2';
    const openForm = (box: HTMLDetailsElement) => { box.open = true; box.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
    const action = (label: string, hint: string, primary: boolean) => {
      const control = document.createElement('button');
      control.type = 'button';
      control.className = `flex flex-col items-start gap-1 border border-[var(--color-moss)] px-4 py-3 text-left text-sm font-semibold transition-colors ${primary ? 'bg-[var(--color-moss)] text-white hover:bg-[var(--color-moss-dark)]' : 'bg-white text-[var(--color-moss-dark)] hover:bg-stone-50'}`;
      control.append(label, element('span', 'text-xs font-normal opacity-90', hint));
      return control;
    };
    if (!samplePet && pet.status === 'Available') {
      const adopt = action(`Apply to adopt ${pet.name}`, 'Your saved details are filled in for you', true);
      adopt.addEventListener('click', () => openForm(adoptBox));
      buttons.append(adopt);
      if (fosterBox) {
        const box = fosterBox;
        const foster = action(`Apply to foster ${pet.name}`, 'Choose the dates you can provide care', false);
        foster.addEventListener('click', () => openForm(box));
        buttons.append(foster);
      }
      const visit = document.createElement('a');
      visit.href = `/visits?pet=${encodeURIComponent(pet.id)}&name=${encodeURIComponent(pet.name)}`;
      visit.className = 'flex flex-col items-start gap-1 border border-[var(--color-moss)] bg-white px-4 py-3 text-sm font-semibold text-[var(--color-moss-dark)] transition-colors hover:bg-stone-50 sm:col-span-2';
      visit.append(`Schedule a visit to meet ${pet.name}`, element('span', 'text-xs font-normal', 'Pick an open time; we will add the pet to your reason for visiting'));
      buttons.append(visit);
      actions.append(buttons, element('p', 'mt-3 text-xs text-stone-600', 'Not logged in? Each option asks you to log in first.'));
    } else {
      actions.append(element('p', 'mt-3 text-sm leading-6 text-stone-700', samplePet ? 'Applications and visits are available when this listing is connected to live records.' : 'This animal is not currently open to new applications.'));
    }

    // "Why this pet might suit you" appears only for a member whose quiz recommended it.
    const fit = document.createElement('section');
    fit.setAttribute('aria-live', 'polite');

    container.append(gallery, description, credit, actions, fit, details, attributesList(pet), medicalHeading, medical, tagHeading, tags);
    if (!samplePet && pet.status === 'Available') container.append(adoptBox);
    if (!samplePet && fosterBox && pet.status === 'Available') container.append(fosterBox);
    container.append(back);
    if (note) container.append(element('p', 'mt-5 text-sm text-stone-600', note));
    void showQuizFit(pet, fit);
    void displayApplicationForm(pet, application, Boolean(note));
  }

  function applicationMessage(target: HTMLElement, text: string, error = false) {
    target.textContent = text;
    target.className = `mt-3 text-sm ${error ? 'text-red-800' : 'text-stone-700'}`;
  }

  function existingApplication(target: HTMLElement, application: AdoptionApplication) {
    target.replaceChildren(
      element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Application submitted'),
      element('p', 'mt-3 leading-7 text-stone-700', `Your application for ${application.petName} is ${application.status.toLowerCase()}. We emailed a confirmation, and the shelter will contact you using the details you provided.`),
    );
  }

  function signedOutApplication(target: HTMLElement) {
    target.replaceChildren(
      element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Interested in adopting?'),
      element('p', 'mt-3 leading-7 text-stone-700', 'Log in or create an account to send the shelter a short adoption application.'),
    );
    const login = document.createElement('a');
    login.href = '/login';
    login.className = 'mt-5 inline-block bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]';
    login.textContent = 'Log in to apply';
    target.append(login);
  }

  type ApplicationFieldName = keyof AdoptionApplicationInput;

  function applicationForm(target: HTMLElement, pet: Pet, user: ApiUser) {
    target.replaceChildren(
      element('h2', 'text-xl font-semibold tracking-tight text-stone-950', `Apply to adopt ${pet.name}`),
      element('p', 'mt-3 max-w-xl leading-7 text-stone-700', `We’ll email you at your PawHeaven account address (${user.email}) and may call or write using the details below. An application does not reserve ${pet.name}. We never ask for a driver’s license or payment information here.`),
    );
    const form = document.createElement('form');
    form.className = 'mt-6 space-y-5';
    form.noValidate = true;
    const controls = new Map<ApplicationFieldName, HTMLInputElement | HTMLTextAreaElement>();
    const errors = new Map<ApplicationFieldName, HTMLElement>();
    const inputClass = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950';

    function addField(name: ApplicationFieldName, labelText: string, control: HTMLInputElement | HTMLTextAreaElement, help?: string) {
      const label = document.createElement('label');
      label.className = 'block text-sm font-medium text-stone-900';
      label.textContent = labelText;
      control.name = name;
      control.className = control instanceof HTMLTextAreaElement ? `${inputClass} resize-y` : inputClass;
      label.append(control);
      const error = element('p', 'mt-2 hidden text-sm text-red-800', '');
      error.setAttribute('role', 'alert');
      errors.set(name, error);
      controls.set(name, control);
      const wrapper = document.createElement('div');
      wrapper.append(label);
      if (help) wrapper.append(element('p', 'mt-2 text-sm font-normal text-stone-600', help));
      wrapper.append(error);
      form.append(wrapper);
    }
    function input(type: string, extra: Partial<HTMLInputElement> = {}) {
      const control = document.createElement('input');
      control.type = type;
      Object.assign(control, extra);
      return control;
    }
    function textarea(rows: number, maxLength: number, placeholder = '') {
      const control = document.createElement('textarea');
      control.rows = rows;
      control.maxLength = maxLength;
      control.placeholder = placeholder;
      return control;
    }

    const eighteenYearsAgo = new Date();
    eighteenYearsAgo.setFullYear(eighteenYearsAgo.getFullYear() - 18);
    addField('applicantPhone', 'Phone number', input('tel', { autocomplete: 'tel', maxLength: 30, placeholder: '(404) 555-0142' }));
    addField('applicantAddress', 'Mailing address', textarea(2, 300, 'Street, city, state, and ZIP code'));
    addField('applicantDateOfBirth', 'Date of birth', input('date', { max: eighteenYearsAgo.toISOString().slice(0, 10), min: '1900-01-01' }), 'You must be at least 18 years old to apply.');
    addField('householdSummary', 'Tell us about your household and the care you can provide', textarea(5, 2000, 'For example: who lives with you, your home routine, and how you plan to care for a pet.'));
    addField('adoptionExperience', 'Tell us about your pet-care experience or how you will prepare', textarea(4, 1000, 'For example: pets you have cared for, support you have in place, and how you will learn what this pet needs.'));
    addField('note', 'Anything else the shelter should know? (optional)', textarea(3, 1000));

    const draftKey = `pawheaven:application-draft:${user.id}:${pet.id}`;
    try {
      const saved = JSON.parse(sessionStorage.getItem(draftKey) || 'null') as Partial<AdoptionApplicationInput> | null;
      if (saved) for (const [name, control] of controls) control.value = typeof saved[name] === 'string' ? saved[name] : '';
    } catch { /* Ignore a malformed or unavailable session draft. */ }
    void prefillContact(controls, { phone: 'applicantPhone', address: 'applicantAddress', dateOfBirth: 'applicantDateOfBirth' });

    const saveBox = saveDetailsBox();
    form.append(saveBox.wrapper);
    const actions = document.createElement('div');
    actions.className = 'flex flex-wrap items-center gap-3';
    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70';
    submit.textContent = 'Submit application';
    const message = document.createElement('p');
    message.setAttribute('role', 'status');
    actions.append(submit, message);
    form.append(actions);
    target.append(form);

    function showFieldErrors(fieldErrors: FieldErrors) {
      for (const [name, error] of errors) {
        const text = fieldErrors[name];
        error.textContent = text ?? '';
        error.classList.toggle('hidden', !text);
        controls.get(name)?.toggleAttribute('aria-invalid', Boolean(text));
      }
      const first = [...controls].find(([name]) => fieldErrors[name]);
      first?.[1].focus();
    }
    function readPayload(): AdoptionApplicationInput {
      const value = (name: ApplicationFieldName) => controls.get(name)?.value.trim() ?? '';
      return {
        applicantPhone: value('applicantPhone'),
        applicantAddress: value('applicantAddress'),
        applicantDateOfBirth: value('applicantDateOfBirth'),
        householdSummary: value('householdSummary'),
        adoptionExperience: value('adoptionExperience'),
        note: value('note'),
      };
    }

    form.addEventListener('input', () => {
      try { sessionStorage.setItem(draftKey, JSON.stringify(readPayload())); } catch { /* Draft saving is best effort and never blocks the form. */ }
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload = readPayload();
      const problems: FieldErrors = {};
      if (payload.applicantPhone.replace(/\D/g, '').length < 10) problems.applicantPhone = 'Enter a phone number with at least 10 digits.';
      if (payload.applicantAddress.length < 5) problems.applicantAddress = 'Enter your mailing address.';
      if (!payload.applicantDateOfBirth) problems.applicantDateOfBirth = 'Enter your date of birth.';
      else if (payload.applicantDateOfBirth > eighteenYearsAgo.toISOString().slice(0, 10)) problems.applicantDateOfBirth = 'Applicants must be at least 18 years old.';
      if (payload.householdSummary.length < 20) problems.householdSummary = 'Tell us a little more about your household and the care you can provide.';
      if (payload.adoptionExperience.length < 20) problems.adoptionExperience = 'Tell us about your pet-care experience or how you will prepare for the responsibility.';
      showFieldErrors(problems);
      if (Object.keys(problems).length) return applicationMessage(message, 'Please correct the highlighted fields.', true);
      submit.disabled = true;
      submit.textContent = 'Submitting…';
      applicationMessage(message, '');
      try {
        const response = await fetch(`${apiBase}/applications/pets/${encodeURIComponent(pet.id)}`, {
          method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => null) as AdoptionApplication | { message?: unknown; fieldErrors?: FieldErrors } | null;
        if (!response.ok) {
          const failure = result as { message?: unknown; fieldErrors?: FieldErrors } | null;
          if (failure?.fieldErrors) showFieldErrors(failure.fieldErrors);
          throw new Error(typeof failure?.message === 'string' ? failure.message : 'We could not submit your application.');
        }
        try { sessionStorage.removeItem(draftKey); } catch { /* Submission still succeeded. */ }
        if (saveBox.input.checked) void saveProfile({ phone: payload.applicantPhone, address: payload.applicantAddress, dateOfBirth: payload.applicantDateOfBirth });
        existingApplication(target, result as AdoptionApplication);
      } catch (exception) {
        applicationMessage(message, exception instanceof Error ? exception.message : 'We could not submit your application.', true);
        submit.disabled = false;
        submit.textContent = 'Submit application';
      }
    });
  }

  async function displayApplicationForm(pet: Pet, target: HTMLElement, samplePet: boolean) {
    if (!canStartApplication(pet, samplePet)) {
      target.replaceChildren(
        element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Interested in adopting?'),
        element('p', 'mt-3 leading-7 text-stone-700', 'Applications will be available when this shelter listing is connected to live records.'),
      );
      return;
    }
    try {
      const identityResponse = await fetch(`${apiBase}/auth/me`, { credentials: 'include' });
      if (identityResponse.status === 401) return signedOutApplication(target);
      if (!identityResponse.ok) throw new Error();
      const identity = await identityResponse.json() as { user: ApiUser };
      const applicationsResponse = await fetch(`${apiBase}/applications`, { credentials: 'include' });
      if (!applicationsResponse.ok) throw new Error();
      const applications = await applicationsResponse.json() as AdoptionApplicationListResponse;
      const existing = applications.applications.find((application) => application.petId === pet.id);
      if (existing) return existingApplication(target, existing);
      applicationForm(target, pet, identity.user);
    } catch {
      target.replaceChildren(
        element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Applications are unavailable right now'),
        element('p', 'mt-3 leading-7 text-stone-700', 'Please try again shortly, or contact the shelter directly.'),
      );
    }
  }

  function existingFosterApplication(target: HTMLElement, application: FosterApplication) {
    target.replaceChildren(
      element('h2', 'text-xl font-semibold tracking-tight text-stone-950', 'Foster application submitted'),
      element('p', 'mt-3 leading-7 text-stone-700', `Your foster application for ${application.petName} is ${application.status.toLowerCase()}. You offered care from ${application.availableFrom} to ${application.availableUntil}. We emailed a confirmation, and the shelter will contact you using the details you provided.`),
    );
  }

  type FosterFieldName = keyof FosterApplicationInput;

  function fosterForm(target: HTMLElement, pet: Pet, user: ApiUser) {
    target.replaceChildren(
      element('h2', 'text-xl font-semibold tracking-tight text-stone-950', `Apply to foster ${pet.name}`),
      element('p', 'mt-3 max-w-xl leading-7 text-stone-700', `Fostering gives ${pet.name} a temporary home. We’ll email you at your PawHeaven account address (${user.email}) and may call or write using the details below. A foster application does not approve a placement, and we never ask for a driver’s license or payment information here.`),
    );
    const form = document.createElement('form');
    form.className = 'mt-6 space-y-5';
    form.noValidate = true;
    const controls = new Map<FosterFieldName, HTMLInputElement | HTMLTextAreaElement>();
    const errors = new Map<FosterFieldName, HTMLElement>();
    const inputClass = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950';

    function addField(name: FosterFieldName, labelText: string, control: HTMLInputElement | HTMLTextAreaElement, help?: string) {
      const label = document.createElement('label');
      label.className = 'block text-sm font-medium text-stone-900';
      label.textContent = labelText;
      control.name = `foster-${name}`;
      control.className = control instanceof HTMLTextAreaElement ? `${inputClass} resize-y` : inputClass;
      label.append(control);
      const error = element('p', 'mt-2 hidden text-sm text-red-800', '');
      error.setAttribute('role', 'alert');
      errors.set(name, error);
      controls.set(name, control);
      const wrapper = document.createElement('div');
      wrapper.append(label);
      if (help) wrapper.append(element('p', 'mt-2 text-sm font-normal text-stone-600', help));
      wrapper.append(error);
      form.append(wrapper);
    }
    function input(type: string, extra: Partial<HTMLInputElement> = {}) {
      const control = document.createElement('input');
      control.type = type;
      Object.assign(control, extra);
      return control;
    }
    function textarea(rows: number, maxLength: number, placeholder = '') {
      const control = document.createElement('textarea');
      control.rows = rows;
      control.maxLength = maxLength;
      control.placeholder = placeholder;
      return control;
    }

    const eighteenYearsAgo = new Date();
    eighteenYearsAgo.setFullYear(eighteenYearsAgo.getFullYear() - 18);
    const maxDob = eighteenYearsAgo.toISOString().slice(0, 10);
    const today = new Date().toISOString().slice(0, 10);
    addField('applicantPhone', 'Phone number', input('tel', { autocomplete: 'tel', maxLength: 30, placeholder: '(404) 555-0142' }));
    addField('applicantAddress', 'Mailing address', textarea(2, 300, 'Street, city, state, and ZIP code'));
    addField('applicantDateOfBirth', 'Date of birth', input('date', { max: maxDob, min: '1900-01-01' }), 'You must be at least 18 years old to foster.');
    addField('householdSummary', 'Tell us about your household and the care you can provide', textarea(5, 2000, 'For example: who lives with you, your home routine, and where the pet will stay.'));
    addField('fosterExperience', 'Tell us about your pet-care or fostering experience', textarea(4, 1000, 'For example: pets you have cared for, fostering you have done, or how you will prepare.'));
    addField('availableFrom', 'First day you can provide care', input('date', { min: today }));
    addField('availableUntil', 'Last day you can provide care', input('date', { min: today }), 'Choose a care period of one year or less.');
    addField('note', 'Anything else the shelter should know? (optional)', textarea(3, 1000));

    const draftKey = `pawheaven:foster-draft:${user.id}:${pet.id}`;
    try {
      const saved = JSON.parse(sessionStorage.getItem(draftKey) || 'null') as Partial<FosterApplicationInput> | null;
      if (saved) for (const [name, control] of controls) control.value = typeof saved[name] === 'string' ? saved[name] : '';
    } catch { /* Ignore a malformed or unavailable session draft. */ }
    void prefillContact(controls, { phone: 'applicantPhone', address: 'applicantAddress', dateOfBirth: 'applicantDateOfBirth' });

    const saveBox = saveDetailsBox();
    form.append(saveBox.wrapper);
    const actions = document.createElement('div');
    actions.className = 'flex flex-wrap items-center gap-3';
    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70';
    submit.textContent = 'Submit foster application';
    const message = document.createElement('p');
    message.setAttribute('role', 'status');
    actions.append(submit, message);
    form.append(actions);
    target.append(form);

    function showFieldErrors(fieldErrors: FieldErrors) {
      for (const [name, error] of errors) {
        const text = fieldErrors[name];
        error.textContent = text ?? '';
        error.classList.toggle('hidden', !text);
        controls.get(name)?.toggleAttribute('aria-invalid', Boolean(text));
      }
      const first = [...controls].find(([name]) => fieldErrors[name]);
      first?.[1].focus();
    }
    function readPayload(): FosterApplicationInput {
      const value = (name: FosterFieldName) => controls.get(name)?.value.trim() ?? '';
      return {
        applicantPhone: value('applicantPhone'),
        applicantAddress: value('applicantAddress'),
        applicantDateOfBirth: value('applicantDateOfBirth'),
        householdSummary: value('householdSummary'),
        fosterExperience: value('fosterExperience'),
        availableFrom: value('availableFrom'),
        availableUntil: value('availableUntil'),
        note: value('note'),
      };
    }

    form.addEventListener('input', () => {
      try { sessionStorage.setItem(draftKey, JSON.stringify(readPayload())); } catch { /* Draft saving is best effort and never blocks the form. */ }
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload = readPayload();
      const problems: FieldErrors = {};
      if (payload.applicantPhone.replace(/\D/g, '').length < 10) problems.applicantPhone = 'Enter a phone number with at least 10 digits.';
      if (payload.applicantAddress.length < 5) problems.applicantAddress = 'Enter your mailing address.';
      if (!payload.applicantDateOfBirth) problems.applicantDateOfBirth = 'Enter your date of birth.';
      else if (payload.applicantDateOfBirth > maxDob) problems.applicantDateOfBirth = 'Applicants must be at least 18 years old.';
      if (payload.householdSummary.length < 20) problems.householdSummary = 'Tell us a little more about your household and the care you can provide.';
      if (payload.fosterExperience.length < 20) problems.fosterExperience = 'Tell us about your pet-care or fostering experience, or how you will prepare.';
      if (!payload.availableFrom) problems.availableFrom = 'Choose the first day you can provide care.';
      if (!payload.availableUntil) problems.availableUntil = 'Choose the last day you can provide care.';
      else if (payload.availableFrom && payload.availableUntil < payload.availableFrom) problems.availableUntil = 'The end date must be on or after the start date.';
      showFieldErrors(problems);
      if (Object.keys(problems).length) return applicationMessage(message, 'Please correct the highlighted fields.', true);
      submit.disabled = true;
      submit.textContent = 'Submitting…';
      applicationMessage(message, '');
      try {
        const response = await fetch(`${apiBase}/foster-applications/pets/${encodeURIComponent(pet.id)}`, {
          method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => null) as FosterApplication | { message?: unknown; fieldErrors?: FieldErrors } | null;
        if (!response.ok) {
          const failure = result as { message?: unknown; fieldErrors?: FieldErrors } | null;
          if (failure?.fieldErrors) showFieldErrors(failure.fieldErrors);
          throw new Error(typeof failure?.message === 'string' ? failure.message : 'We could not submit your foster application.');
        }
        try { sessionStorage.removeItem(draftKey); } catch { /* Submission still succeeded. */ }
        if (saveBox.input.checked) void saveProfile({ phone: payload.applicantPhone, address: payload.applicantAddress, dateOfBirth: payload.applicantDateOfBirth });
        existingFosterApplication(target, result as FosterApplication);
      } catch (exception) {
        applicationMessage(message, exception instanceof Error ? exception.message : 'We could not submit your foster application.', true);
        submit.disabled = false;
        submit.textContent = 'Submit foster application';
      }
    });
  }

  async function displayFosterForm(pet: Pet, target: HTMLElement, samplePet: boolean) {
    if (!canStartApplication(pet, samplePet)) return target.remove();
    const heading = () => element('h2', 'text-xl font-semibold tracking-tight text-stone-950', `Interested in fostering ${pet.name}?`);
    try {
      const identityResponse = await fetch(`${apiBase}/auth/me`, { credentials: 'include' });
      if (identityResponse.status === 401) {
        const login = document.createElement('a');
        login.href = '/login';
        login.className = 'mt-5 inline-block border border-[var(--color-moss)] px-5 py-3 font-semibold text-[var(--color-moss-dark)] transition-colors hover:bg-[var(--color-moss)] hover:text-white';
        login.textContent = 'Log in to foster';
        return target.replaceChildren(heading(), element('p', 'mt-3 leading-7 text-stone-700', `${pet.name} is open to a temporary foster home. Log in or create an account to send a foster application.`), login);
      }
      if (!identityResponse.ok) throw new Error();
      const identity = await identityResponse.json() as { user: ApiUser };
      const applicationsResponse = await fetch(`${apiBase}/foster-applications`, { credentials: 'include' });
      if (!applicationsResponse.ok) throw new Error();
      const applications = await applicationsResponse.json() as FosterApplicationListResponse;
      const existing = applications.applications.find((application) => application.petId === pet.id);
      if (existing) return existingFosterApplication(target, existing);
      fosterForm(target, pet, identity.user);
    } catch {
      target.replaceChildren(heading(), element('p', 'mt-3 leading-7 text-stone-700', 'Foster applications are unavailable right now. Please try again shortly, or contact the shelter directly.'));
    }
  }

  function displayNotFound() {
    if (!container) return;
    container.replaceChildren(
      element('h1', 'text-2xl font-semibold text-stone-950', 'Pet not found'),
      element('p', 'mt-3 leading-7 text-stone-700', 'This animal may no longer be listed. Return to the current available pets.'),
    );
    const back = document.createElement('a');
    back.href = '/pets';
    back.className = 'mt-7 inline-block font-medium text-[var(--color-moss-dark)] underline underline-offset-4';
    back.textContent = 'Back to available pets';
    container.append(back);
  }

  async function loadPet() {
    try {
      const response = await fetch(`${apiBase}/pets/${encodeURIComponent(id)}`, { credentials: 'include' });
      if (response.status === 404) {
        const fallback = seedPets.find((pet) => pet.id === id);
        return fallback ? displayPet(fallback, 'Sample pet information is shown while the shelter API is unavailable.') : displayNotFound();
      }
      if (!response.ok) throw new Error('Pet details are unavailable.');
      displayPet(await response.json());
    } catch {
      const fallback = seedPets.find((pet) => pet.id === id);
      fallback ? displayPet(fallback, 'Sample pet information is shown while the shelter API is unavailable.') : displayNotFound();
    }
  }

  loadPet();
</script>
