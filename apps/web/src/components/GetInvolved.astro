<div class="mx-auto max-w-6xl px-6 py-12">
  <h1 class="text-3xl font-semibold tracking-tight text-stone-950">Get involved</h1>
  <p class="mt-3 max-w-2xl leading-7 text-stone-700">Meet the animals, lend a hand, or open your home. Here is what is open at the shelter right now.</p>

  <div data-involved aria-live="polite" class="mt-8">
    <p class="text-sm text-stone-600">Loading what is open…</p>
  </div>
</div>

<script>
  import type { GetInvolvedFeed } from '@pawheaven/contracts';
  import { apiRequest, el, formatShelterRange, pill } from '@pawheaven/contracts/ui';
  import { apiBase } from '../lib/api';

  const root = document.querySelector<HTMLElement>('[data-involved]');
  const when = (startsAt: string, endsAt: string) => formatShelterRange(startsAt, endsAt);
  const link = (href: string, text: string, primary = false) => Object.assign(el('a', primary ? 'ph-btn ph-btn-primary' : 'ph-btn', text), { href });

  function column(title: string, intro: string, footer: Node) {
    const section = el('section', 'ph-card flex flex-col');
    section.append(el('h2', 'text-lg font-semibold text-stone-950', title), el('p', 'mt-1 text-sm leading-6 text-stone-700', intro));
    const list = el('div', 'mt-3 grid gap-2');
    section.append(list);
    const foot = el('div', 'mt-auto flex flex-wrap gap-2 pt-4');
    foot.append(footer);
    section.append(foot);
    return { section, list };
  }

  async function load() {
    if (!root) return;
    try {
      const feed = await apiRequest<GetInvolvedFeed>(apiBase, '/get-involved');
      const page = el('div', 'grid gap-6');

      if (feed.events.length) {
        const events = el('section', 'ph-card border-l-4 border-l-[var(--ph-accent)]');
        events.append(el('h2', 'text-lg font-semibold text-stone-950', 'Coming up'));
        for (const event of feed.events) {
          const item = el('div', 'mt-3 border-t border-stone-200 pt-3');
          item.append(el('p', 'font-semibold text-stone-950', event.title), el('p', 'text-sm text-stone-700', when(event.startsAt, event.endsAt)));
          if (event.description) item.append(el('p', 'mt-1 text-sm leading-6 text-stone-700', event.description));
          if (event.pets.length) {
            const meet = el('p', 'mt-2 text-sm text-stone-800', 'Meet: ');
            event.pets.forEach((pet, index) => { if (index) meet.append(', '); meet.append(Object.assign(el('a', 'font-medium text-[var(--color-moss-dark)] underline underline-offset-4', pet.name), { href: `/pets/detail?id=${encodeURIComponent(pet.id)}` })); });
            item.append(meet);
          }
          events.append(item);
        }
        page.append(events);
      }

      const grid = el('div', 'grid items-start gap-6 lg:grid-cols-3');

      const visits = column('Visit the shelter', 'Book a time to meet the animals.', link('/visits', 'Book a visit', true));
      if (!feed.visits.length) visits.list.append(el('p', 'text-sm text-stone-700', 'No open times in the next two weeks. Check back soon.'));
      for (const slot of feed.visits.slice(0, 6)) {
        const line = el('div', 'flex flex-wrap items-center justify-between gap-2 border border-stone-300 p-2 text-sm');
        line.append(el('span', '', when(slot.startsAt, slot.endsAt)), pill(`${slot.spotsLeft} left`, 'good'));
        visits.list.append(line);
      }

      const volunteer = column('Volunteer', 'Walk dogs, socialize cats, or help at events.', link('/volunteer', 'See all shifts', true));
      if (!feed.shifts.length) volunteer.list.append(el('p', 'text-sm text-stone-700', 'Every shift is full right now. Check back soon.'));
      for (const shift of feed.shifts.slice(0, 6)) {
        const line = el('div', 'border border-stone-300 p-2 text-sm');
        const top = el('div', 'flex flex-wrap items-center justify-between gap-2');
        top.append(el('strong', 'text-stone-950', shift.title), pill(`${shift.spotsLeft} spot${shift.spotsLeft === 1 ? '' : 's'}`, 'warn'));
        line.append(top, el('span', 'block text-stone-700', when(shift.startsAt, shift.endsAt)));
        volunteer.list.append(line);
      }

      const foster = column('Foster', `${feed.foster.open} animal${feed.foster.open === 1 ? ' is' : 's are'} open to foster right now.`, link('/pets?search=foster', 'Pets open to foster', true));
      if (feed.foster.urgent.length) {
        foster.list.append(el('p', 'text-sm font-semibold text-stone-950', 'Needed now'));
        for (const pet of feed.foster.urgent) {
          const line = el('div', 'flex flex-wrap items-center justify-between gap-2 border border-stone-300 p-2 text-sm');
          line.append(Object.assign(el('a', 'font-medium text-[var(--color-moss-dark)] underline underline-offset-4', pet.name), { href: `/pets/detail?id=${encodeURIComponent(pet.id)}` }), pill('Foster needed', 'warn'));
          foster.list.append(line);
        }
      } else foster.list.append(el('p', 'text-sm text-stone-700', 'Fostering gives an animal a break from the kennel. Apply on any pet marked “Open to foster”.'));

      grid.append(visits.section, volunteer.section, foster.section);
      page.append(grid);
      root.replaceChildren(page);
    } catch {
      root.replaceChildren(el('p', 'text-sm leading-6 text-stone-700', 'We could not load what is open right now. You can still browse '), Object.assign(el('a', 'underline', 'visits'), { href: '/visits' }), ', ', Object.assign(el('a', 'underline', 'volunteer shifts'), { href: '/volunteer' }), ', or ', Object.assign(el('a', 'underline', 'pets'), { href: '/pets' }), '.');
    }
  }

  void load();
</script>
