<div class="mx-auto grid max-w-5xl place-items-center px-6 py-12">
  <section class="w-full max-w-xl border border-stone-300 bg-white p-7 sm:p-9" data-account-panel aria-live="polite">
    <p class="text-sm text-stone-600">Checking your session…</p>
  </section>
</div>

<script>
  import { passwordProblem, type AdoptionApplicationListResponse, type ApiUser, type FosterApplicationListResponse, type VolunteerRegistrationListResponse, type ChangeEmailInput, type ChangePasswordInput, type FieldErrors, type RescheduleVisitInput, type VisitAppointmentListResponse, type VisitSlotListResponse } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';
  const panel = document.querySelector<HTMLElement>('[data-account-panel]');

  function textElement(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  function signedOut() {
    if (!panel) return;
    panel.replaceChildren(
      textElement('p', 'text-sm font-medium text-stone-600', 'PawHeaven'),
      textElement('h1', 'mt-3 text-3xl font-semibold tracking-tight text-stone-950', 'You are signed out'),
      textElement('p', 'mt-3 leading-7 text-stone-700', 'Log in to manage your account and continue an adoption application.'),
    );
    const login = document.createElement('a');
    login.href = '/login';
    login.className = 'mt-7 inline-block bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]';
    login.textContent = 'Log in';
    panel.append(login);
  }

  function signedIn(user: ApiUser) {
    if (!panel) return;
    panel.replaceChildren(
      textElement('p', 'text-sm font-medium text-stone-600', 'PawHeaven account'),
      textElement('h1', 'mt-3 text-3xl font-semibold tracking-tight text-stone-950', user.name),
      textElement('p', 'mt-2 text-stone-700', user.email),
    );
    const logout = document.createElement('button');
    logout.type = 'button';
    logout.className = 'mt-7 border border-stone-400 px-5 py-3 font-semibold text-stone-900 transition-colors hover:bg-stone-100';
    logout.textContent = 'Log out';
    const profile = document.createElement('form');
    profile.className = 'mt-6 border-t border-stone-300 pt-6';
    const label = textElement('label', 'block text-sm font-medium text-stone-900', 'Name');
    const name = document.createElement('input');
    name.name = 'name';
    name.value = user.name;
    name.maxLength = 100;
    name.required = true;
    name.className = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950';
    label.append(name);
    const save = document.createElement('button');
    save.type = 'submit';
    save.className = 'mt-3 bg-[var(--color-moss)] px-4 py-2.5 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]';
    save.textContent = 'Save name';
    const profileMessage = textElement('p', 'mt-2 text-sm text-stone-700', '');
    profileMessage.setAttribute('role', 'status');
    profile.append(label, save, profileMessage);
    profile.addEventListener('submit', async (event) => {
      event.preventDefault();
      const nextName = name.value.trim().replace(/\s+/g, ' ');
      if (!nextName || nextName.length > 100) { profileMessage.textContent = 'Enter a name up to 100 characters long.'; return; }
      save.disabled = true;
      try {
        const response = await fetch(`${apiBase}/auth/profile`, { method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: nextName }) });
        const payload = await response.json().catch(() => null) as { user?: ApiUser; message?: string } | null;
        if (!response.ok || !payload?.user) throw new Error(payload?.message || 'We could not save your profile.');
        name.value = payload.user.name;
        const heading = panel?.querySelector('h1');
        if (heading) heading.textContent = payload.user.name;
        profileMessage.textContent = 'Profile name saved.';
      } catch (exception) { profileMessage.textContent = exception instanceof Error ? exception.message : 'We could not save your profile.'; }
      finally { save.disabled = false; }
    });
    const security = document.createElement('section');
    security.className = 'mt-6 border-t border-stone-300 pt-6';
    security.append(textElement('h2', 'text-lg font-semibold text-stone-950', 'Sign-in details'));
    security.append(
      accountForm('Change email address', 'Save new email', [
        { name: 'email', label: 'New email address', type: 'email', autocomplete: 'email' },
        { name: 'currentPassword', label: 'Current password', type: 'password', autocomplete: 'current-password' },
      ], async (values) => {
        const payload: ChangeEmailInput = { email: values.email.trim(), currentPassword: values.currentPassword };
        const result = await accountRequest<{ message: string }>('/auth/email', 'PUT', payload);
        return result.message;
      }),
      accountForm('Change password', 'Save new password', [
        { name: 'currentPassword', label: 'Current password', type: 'password', autocomplete: 'current-password' },
        { name: 'newPassword', label: 'New password', type: 'password', autocomplete: 'new-password', help: 'At least 8 characters, with an uppercase letter, a lowercase letter, a number, and a special character.' },
      ], async (values) => {
        const problem = passwordProblem(values.newPassword);
        if (problem) throw new AccountError(problem, { newPassword: problem });
        const payload: ChangePasswordInput = { currentPassword: values.currentPassword, newPassword: values.newPassword };
        await accountRequest('/auth/change-password', 'POST', payload);
        return 'Your password was changed.';
      }),
    );
    logout.addEventListener('click', async () => {
      logout.disabled = true;
      logout.textContent = 'Logging out…';
      try {
        const response = await fetch(`${apiBase}/auth/logout`, { method: 'POST', credentials: 'include' });
        if (!response.ok) throw new Error('Logout failed.');
        signedOut();
        window.dispatchEvent(new CustomEvent('pawheaven:authchange', { detail: { signedIn: false } }));
      } catch {
        logout.disabled = false;
        logout.textContent = 'Log out';
      }
    });
    const visits = document.createElement('section');
    visits.className = 'mt-8 border-t border-stone-300 pt-6';
    visits.setAttribute('aria-live', 'polite');
    const applications = document.createElement('section');
    applications.className = 'mt-8 border-t border-stone-300 pt-6';
    applications.setAttribute('aria-live', 'polite');
    const fosterApplications = document.createElement('section');
    fosterApplications.className = 'mt-8 border-t border-stone-300 pt-6';
    fosterApplications.setAttribute('aria-live', 'polite');
    const volunteering = document.createElement('section');
    volunteering.className = 'mt-8 border-t border-stone-300 pt-6';
    volunteering.setAttribute('aria-live', 'polite');
    panel.append(profile, security, logout, visits, applications, fosterApplications, volunteering);
    void showAppointments(visits);
    void showApplications(applications);
    void showFosterApplications(fosterApplications);
    void showVolunteerShifts(volunteering);
  }

  class AccountError extends Error {
    fieldErrors?: FieldErrors;
    constructor(message: string, fieldErrors?: FieldErrors) { super(message); this.fieldErrors = fieldErrors; }
  }

  async function accountRequest<T>(path: string, method: string, body: unknown): Promise<T> {
    const response = await fetch(`${apiBase}${path}`, { method, credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const payload = await response.json().catch(() => null) as ({ message?: unknown; fieldErrors?: FieldErrors } & T) | null;
    if (!response.ok) throw new AccountError(typeof payload?.message === 'string' ? payload.message : 'The request could not be completed.', payload?.fieldErrors);
    return payload as T;
  }

  type AccountFieldSpec = { name: string; label: string; type: string; autocomplete: string; help?: string };

  /** A small disclosure form with per-field errors and a status message. */
  function accountForm(title: string, submitLabel: string, fields: AccountFieldSpec[], onSubmit: (values: Record<string, string>) => Promise<string>) {
    const details = document.createElement('details');
    details.className = 'mt-4 border border-stone-300 bg-white px-4 py-3';
    details.append(textElement('summary', 'cursor-pointer text-sm font-semibold text-stone-950', title));
    const form = document.createElement('form');
    form.className = 'mt-4 grid gap-4';
    form.noValidate = true;
    const inputs = new Map<string, HTMLInputElement>();
    const errors = new Map<string, HTMLElement>();
    for (const spec of fields) {
      const label = textElement('label', 'block text-sm font-medium text-stone-900', spec.label);
      const input = document.createElement('input');
      input.name = spec.name;
      input.type = spec.type;
      input.setAttribute('autocomplete', spec.autocomplete);
      input.maxLength = 1024;
      input.required = true;
      input.className = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950';
      label.append(input);
      const error = textElement('p', 'mt-2 hidden text-sm text-red-800', '');
      error.setAttribute('role', 'alert');
      inputs.set(spec.name, input);
      errors.set(spec.name, error);
      const wrapper = document.createElement('div');
      wrapper.append(label);
      if (spec.help) wrapper.append(textElement('p', 'mt-2 text-sm text-stone-600', spec.help));
      wrapper.append(error);
      form.append(wrapper);
    }
    const submit = textElement('button', 'justify-self-start bg-[var(--color-moss)] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70', submitLabel) as HTMLButtonElement;
    submit.type = 'submit';
    const status = textElement('p', 'text-sm', '');
    status.setAttribute('role', 'status');
    form.append(submit, status);
    function showErrors(fieldErrors: FieldErrors) {
      for (const [name, error] of errors) {
        error.textContent = fieldErrors[name] ?? '';
        error.classList.toggle('hidden', !fieldErrors[name]);
      }
    }
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showErrors({});
      status.textContent = '';
      const values = Object.fromEntries([...inputs].map(([name, input]) => [name, input.value]));
      const missing = Object.fromEntries([...inputs].filter(([, input]) => !input.value).map(([name]) => [name, 'This field is required.']));
      if (Object.keys(missing).length) return showErrors(missing);
      submit.disabled = true;
      try {
        status.textContent = await onSubmit(values);
        status.className = 'text-sm text-[var(--color-moss-dark)]';
        for (const input of inputs.values()) input.value = '';
      } catch (exception) {
        if (exception instanceof AccountError && exception.fieldErrors) showErrors(exception.fieldErrors);
        status.textContent = exception instanceof Error ? exception.message : 'We could not save that change.';
        status.className = 'text-sm text-red-800';
      } finally { submit.disabled = false; }
    });
    details.append(form);
    return details;
  }

  const shelterTimeZone = 'America/New_York';

  function formatVisitTime(startsAt: string, endsAt: string) {
    const start = new Date(startsAt);
    const end = new Date(endsAt);
    if (Number.isNaN(start.valueOf()) || Number.isNaN(end.valueOf())) return 'Unknown visit time';
    const date = new Intl.DateTimeFormat(undefined, { timeZone: shelterTimeZone, weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }).format(start);
    const range = new Intl.DateTimeFormat(undefined, { timeZone: shelterTimeZone, hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).formatRange(start, end);
    return `${date} · ${range}`;
  }

  async function visitResponse<T>(path: string, init?: RequestInit): Promise<T> {
    const response = await fetch(`${apiBase}${path}`, { credentials: 'include', ...init });
    const payload = await response.json().catch(() => null) as { message?: unknown } | T | null;
    if (!response.ok) throw new Error(typeof (payload as { message?: unknown } | null)?.message === 'string' ? (payload as { message: string }).message : 'The request could not be completed.');
    return payload as T;
  }

  function visitMessage(target: HTMLElement, text: string, error = false) {
    target.textContent = text;
    target.className = `mt-3 text-sm ${error ? 'text-red-800' : 'text-[var(--color-moss-dark)]'}`;
  }

  async function showAppointments(target: HTMLElement) {
    target.replaceChildren(textElement('p', 'text-sm text-stone-600', 'Loading your scheduled visits…'));
    try {
      const [appointmentPayload, slotPayload] = await Promise.all([
        visitResponse<VisitAppointmentListResponse>('/appointments'),
        visitResponse<VisitSlotListResponse>('/visit-slots'),
      ]);
      target.replaceChildren(
        textElement('h2', 'text-lg font-semibold text-stone-950', 'Your shelter visits'),
        textElement('p', 'mt-2 leading-7 text-stone-700', 'Visit times are shown in America/New_York. Your booking and any changes are confirmed here immediately.'),
      );
      if (!appointmentPayload.appointments.length) {
        const empty = textElement('p', 'mt-4 leading-7 text-stone-700', 'You do not have a shelter visit scheduled yet.');
        const schedule = document.createElement('a');
        schedule.href = '/visits';
        schedule.className = 'mt-4 inline-block font-medium text-[var(--color-moss-dark)] underline underline-offset-4';
        schedule.textContent = 'Schedule a visit';
        target.append(empty, schedule);
        return;
      }
      const list = document.createElement('div');
      list.className = 'mt-5 grid gap-4';
      for (const appointment of appointmentPayload.appointments) {
        const item = document.createElement('article');
        item.className = 'border border-stone-300 bg-white p-5';
        item.append(
          textElement('h3', 'font-semibold text-stone-950', formatVisitTime(appointment.startsAt, appointment.endsAt)),
          textElement('p', 'mt-1 text-sm text-stone-700', appointment.status === 'booked' ? 'Confirmed' : 'Canceled'),
          textElement('p', 'mt-4 whitespace-pre-wrap leading-7 text-stone-800', appointment.purpose),
        );
        const isFutureBooking = appointment.status === 'booked' && Date.parse(appointment.startsAt) > Date.now();
        if (isFutureBooking) {
          const controls = document.createElement('div');
          controls.className = 'mt-5 flex flex-wrap items-end gap-3 border-t border-stone-200 pt-4';
          const label = document.createElement('label');
          label.className = 'text-sm font-medium text-stone-900';
          label.textContent = 'Reschedule to';
          const select = document.createElement('select');
          select.className = 'mt-2 block border border-stone-400 bg-white px-3 py-2 text-stone-950';
          const emptyChoice = document.createElement('option');
          emptyChoice.value = '';
          emptyChoice.textContent = 'Choose another open time';
          select.append(emptyChoice);
          for (const slot of slotPayload.slots.filter((slot) => slot.available && slot.id !== appointment.slotId)) {
            const option = document.createElement('option');
            option.value = slot.id;
            option.textContent = formatVisitTime(slot.startsAt, slot.endsAt);
            select.append(option);
          }
          label.append(select);
          const reschedule = document.createElement('button');
          reschedule.type = 'button';
          reschedule.className = 'border border-[var(--color-moss)] px-4 py-2 text-sm font-semibold text-[var(--color-moss-dark)] transition-colors hover:bg-[var(--color-moss)] hover:text-white disabled:cursor-wait disabled:opacity-70';
          reschedule.textContent = 'Reschedule';
          const cancel = document.createElement('button');
          cancel.type = 'button';
          cancel.className = 'px-2 py-2 text-sm font-medium text-red-800 underline underline-offset-4 hover:text-red-950 disabled:cursor-wait disabled:opacity-70';
          cancel.textContent = 'Cancel visit';
          const result = document.createElement('p');
          result.setAttribute('role', 'status');
          reschedule.addEventListener('click', async () => {
            const payload: RescheduleVisitInput = { slotId: select.value };
            if (!payload.slotId) return visitMessage(result, 'Choose another open visit time.', true);
            reschedule.disabled = true;
            cancel.disabled = true;
            reschedule.textContent = 'Rescheduling…';
            try {
              await visitResponse(`/appointments/${encodeURIComponent(appointment.id)}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
              await showAppointments(target);
            } catch (exception) {
              visitMessage(result, exception instanceof Error ? exception.message : 'We could not reschedule your visit.', true);
              reschedule.disabled = false;
              cancel.disabled = false;
              reschedule.textContent = 'Reschedule';
            }
          });
          cancel.addEventListener('click', async () => {
            if (!window.confirm('Cancel this shelter visit? The time will become available to someone else.')) return;
            reschedule.disabled = true;
            cancel.disabled = true;
            cancel.textContent = 'Canceling…';
            try {
              await visitResponse(`/appointments/${encodeURIComponent(appointment.id)}/cancel`, { method: 'POST' });
              await showAppointments(target);
            } catch (exception) {
              visitMessage(result, exception instanceof Error ? exception.message : 'We could not cancel your visit.', true);
              reschedule.disabled = false;
              cancel.disabled = false;
              cancel.textContent = 'Cancel visit';
            }
          });
          controls.append(label, reschedule, cancel, result);
          item.append(controls);
        }
        list.append(item);
      }
      target.append(list);
      if (appointmentPayload.events.length) {
        const history = document.createElement('section');
        history.className = 'mt-6 border-t border-stone-300 pt-5';
        history.append(textElement('h3', 'font-semibold text-stone-950', 'Confirmation history'));
        const eventList = document.createElement('ul');
        eventList.className = 'mt-3 grid gap-2 text-sm text-stone-700';
        for (const event of appointmentPayload.events) {
          const item = document.createElement('li');
          item.textContent = `${event.eventType[0].toUpperCase()}${event.eventType.slice(1)} · ${formatVisitTime(event.startsAt, event.endsAt)}`;
          eventList.append(item);
        }
        history.append(eventList);
        target.append(history);
      }
    } catch {
      target.replaceChildren(
        textElement('h2', 'text-lg font-semibold text-stone-950', 'Your shelter visits'),
        textElement('p', 'mt-2 leading-7 text-stone-700', 'We could not load your visits right now. Please try again later.'),
      );
    }
  }

  async function showApplications(target: HTMLElement) {
    target.replaceChildren(textElement('p', 'text-sm text-stone-600', 'Loading your adoption applications…'));
    try {
      const response = await fetch(`${apiBase}/applications`, { credentials: 'include' });
      if (!response.ok) throw new Error();
      const payload = await response.json() as AdoptionApplicationListResponse;
      target.replaceChildren(textElement('h2', 'text-lg font-semibold text-stone-950', 'Your adoption applications'));
      if (!payload.applications.length) {
        target.append(textElement('p', 'mt-2 leading-7 text-stone-700', 'You have not submitted an adoption application yet.'));
        return;
      }
      const list = document.createElement('ul');
      list.className = 'mt-4 grid gap-3';
      for (const application of payload.applications) {
        const item = document.createElement('li');
        item.className = 'border border-stone-300 bg-white px-4 py-3';
        item.append(
          textElement('p', 'font-medium text-stone-950', application.petName),
          textElement('p', 'mt-1 text-sm text-stone-700', `Status: ${application.status}`),
        );
        list.append(item);
      }
      target.append(list);
    } catch {
      target.replaceChildren(
        textElement('h2', 'text-lg font-semibold text-stone-950', 'Your adoption applications'),
        textElement('p', 'mt-2 leading-7 text-stone-700', 'We could not load your applications right now. Please try again later.'),
      );
    }
  }

  async function showFosterApplications(target: HTMLElement) {
    target.replaceChildren(textElement('p', 'text-sm text-stone-600', 'Loading your foster applications…'));
    try {
      const payload = await visitResponse<FosterApplicationListResponse>('/foster-applications');
      target.replaceChildren(textElement('h2', 'text-lg font-semibold text-stone-950', 'Your foster applications'));
      if (!payload.applications.length) {
        target.append(textElement('p', 'mt-2 leading-7 text-stone-700', 'You have not submitted a foster application yet. Pets that are open to foster say so on their details page.'));
        return;
      }
      const list = document.createElement('ul');
      list.className = 'mt-4 grid gap-3';
      for (const application of payload.applications) {
        const item = document.createElement('li');
        item.className = 'border border-stone-300 bg-white px-4 py-3';
        item.append(
          textElement('p', 'font-medium text-stone-950', application.petName),
          textElement('p', 'mt-1 text-sm text-stone-700', `Status: ${application.status}`),
          textElement('p', 'mt-1 text-sm text-stone-700', `Care period: ${application.availableFrom} to ${application.availableUntil}`),
        );
        list.append(item);
      }
      target.append(list);
    } catch {
      target.replaceChildren(
        textElement('h2', 'text-lg font-semibold text-stone-950', 'Your foster applications'),
        textElement('p', 'mt-2 leading-7 text-stone-700', 'We could not load your foster applications right now. Please try again later.'),
      );
    }
  }

  async function showVolunteerShifts(target: HTMLElement) {
    target.replaceChildren(textElement('p', 'text-sm text-stone-600', 'Loading your volunteer shifts…'));
    try {
      const payload = await visitResponse<VolunteerRegistrationListResponse>('/volunteer/registrations');
      target.replaceChildren(
        textElement('h2', 'text-lg font-semibold text-stone-950', 'Your volunteer shifts'),
        textElement('p', 'mt-2 leading-7 text-stone-700', 'Shift times are shown in America/New_York.'),
      );
      if (!payload.registrations.length) {
        const empty = textElement('p', 'mt-4 leading-7 text-stone-700', 'You have not signed up to volunteer yet.');
        const browse = document.createElement('a');
        browse.href = '/volunteer';
        browse.className = 'mt-4 inline-block font-medium text-[var(--color-moss-dark)] underline underline-offset-4';
        browse.textContent = 'Find a volunteer shift';
        target.append(empty, browse);
        return;
      }
      const list = document.createElement('div');
      list.className = 'mt-5 grid gap-4';
      for (const registration of payload.registrations) {
        const item = document.createElement('article');
        item.className = 'border border-stone-300 bg-white p-5';
        const label = registration.status === 'registered'
          ? 'Signed up'
          : registration.canceledReason === 'shift_canceled' ? 'Canceled by the shelter' : 'Canceled';
        item.append(
          textElement('h3', 'font-semibold text-stone-950', registration.title),
          textElement('p', 'mt-1 text-sm text-stone-700', `${formatVisitTime(registration.startsAt, registration.endsAt)} · ${label}`),
        );
        if (registration.status === 'registered' && Date.parse(registration.startsAt) > Date.now()) {
          const cancel = textElement('button', 'mt-4 text-sm font-medium text-red-800 underline underline-offset-4 hover:text-red-950 disabled:cursor-wait disabled:opacity-70', 'Cancel sign-up') as HTMLButtonElement;
          cancel.type = 'button';
          const result = document.createElement('p');
          result.setAttribute('role', 'status');
          cancel.addEventListener('click', async () => {
            if (!window.confirm('Cancel this volunteer shift? Your spot will open for someone else.')) return;
            cancel.disabled = true;
            cancel.textContent = 'Canceling…';
            try {
              await visitResponse(`/volunteer/registrations/${encodeURIComponent(registration.id)}/cancel`, { method: 'POST' });
              await showVolunteerShifts(target);
            } catch (exception) {
              visitMessage(result, exception instanceof Error ? exception.message : 'We could not cancel your sign-up.', true);
              cancel.disabled = false;
              cancel.textContent = 'Cancel sign-up';
            }
          });
          item.append(cancel, result);
        }
        list.append(item);
      }
      target.append(list);
    } catch {
      target.replaceChildren(
        textElement('h2', 'text-lg font-semibold text-stone-950', 'Your volunteer shifts'),
        textElement('p', 'mt-2 leading-7 text-stone-700', 'We could not load your volunteer shifts right now. Please try again later.'),
      );
    }
  }

  async function loadAccount() {
    try {
      const response = await fetch(`${apiBase}/auth/me`, { credentials: 'include' });
      if (response.status === 401) return signedOut();
      if (!response.ok) throw new Error('Account details are unavailable.');
      const payload = await response.json() as { user: ApiUser };
      signedIn(payload.user);
    } catch { signedOut(); }
  }

  loadAccount();
</script>
