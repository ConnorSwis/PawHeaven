<div class="mx-auto grid max-w-5xl place-items-center px-6 py-12">
  <section class="w-full max-w-xl border border-stone-300 bg-white p-7 sm:p-9" data-account-panel aria-live="polite">
    <p class="text-sm text-stone-600">Checking your session…</p>
  </section>
</div>

<script>
  import type { AdoptionApplicationListResponse, ApiUser } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';
  const panel = document.querySelector<HTMLElement>('[data-account-panel]');

  function textElement(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  function signedOut() {
    if (!panel) return;
    panel.replaceChildren(
      textElement('p', 'text-sm font-medium text-stone-600', 'PawHeaven'),
      textElement('h1', 'mt-3 text-3xl font-semibold tracking-tight text-stone-950', 'You are signed out'),
      textElement('p', 'mt-3 leading-7 text-stone-700', 'Log in to manage your account and continue an adoption application.'),
    );
    const login = document.createElement('a');
    login.href = '/login';
    login.className = 'mt-7 inline-block bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]';
    login.textContent = 'Log in';
    panel.append(login);
  }

  function signedIn(user: ApiUser) {
    if (!panel) return;
    panel.replaceChildren(
      textElement('p', 'text-sm font-medium text-stone-600', 'PawHeaven account'),
      textElement('h1', 'mt-3 text-3xl font-semibold tracking-tight text-stone-950', user.name),
      textElement('p', 'mt-2 text-stone-700', user.email),
    );
    const logout = document.createElement('button');
    logout.type = 'button';
    logout.className = 'mt-7 border border-stone-400 px-5 py-3 font-semibold text-stone-900 transition-colors hover:bg-stone-100';
    logout.textContent = 'Log out';
    logout.addEventListener('click', async () => {
      logout.disabled = true;
      logout.textContent = 'Logging out…';
      try {
        const response = await fetch(`${apiBase}/auth/logout`, { method: 'POST', credentials: 'include' });
        if (!response.ok) throw new Error('Logout failed.');
        signedOut();
        window.dispatchEvent(new CustomEvent('pawheaven:authchange', { detail: { signedIn: false } }));
      } catch {
        logout.disabled = false;
        logout.textContent = 'Log out';
      }
    });
    const applications = document.createElement('section');
    applications.className = 'mt-8 border-t border-stone-300 pt-6';
    applications.setAttribute('aria-live', 'polite');
    panel.append(logout, applications);
    void showApplications(applications);
  }

  async function showApplications(target: HTMLElement) {
    target.replaceChildren(textElement('p', 'text-sm text-stone-600', 'Loading your adoption applications…'));
    try {
      const response = await fetch(`${apiBase}/applications`, { credentials: 'include' });
      if (!response.ok) throw new Error();
      const payload = await response.json() as AdoptionApplicationListResponse;
      target.replaceChildren(textElement('h2', 'text-lg font-semibold text-stone-950', 'Your adoption applications'));
      if (!payload.applications.length) {
        target.append(textElement('p', 'mt-2 leading-7 text-stone-700', 'You have not submitted an adoption application yet.'));
        return;
      }
      const list = document.createElement('ul');
      list.className = 'mt-4 grid gap-3';
      for (const application of payload.applications) {
        const item = document.createElement('li');
        item.className = 'border border-stone-300 bg-white px-4 py-3';
        item.append(
          textElement('p', 'font-medium text-stone-950', application.petName),
          textElement('p', 'mt-1 text-sm text-stone-700', `Status: ${application.status}`),
        );
        list.append(item);
      }
      target.append(list);
    } catch {
      target.replaceChildren(
        textElement('h2', 'text-lg font-semibold text-stone-950', 'Your adoption applications'),
        textElement('p', 'mt-2 leading-7 text-stone-700', 'We could not load your applications right now. Please try again later.'),
      );
    }
  }

  async function loadAccount() {
    try {
      const response = await fetch(`${apiBase}/auth/me`, { credentials: 'include' });
      if (response.status === 401) return signedOut();
      if (!response.ok) throw new Error('Account details are unavailable.');
      const payload = await response.json() as { user: ApiUser };
      signedIn(payload.user);
    } catch { signedOut(); }
  }

  loadAccount();
</script>
