<div class="mx-auto grid max-w-5xl place-items-center px-6 py-12">
  <section class="w-full max-w-xl border border-stone-300 bg-white p-7 sm:p-9" data-account-panel aria-live="polite">
    <p class="text-sm text-stone-600">Checking your session…</p>
  </section>
</div>

<script>
  import { passwordProblem, type ApiUser, type ChangeEmailInput, type ChangePasswordInput, type FieldErrors } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';
  const panel = document.querySelector<HTMLElement>('[data-account-panel]');

  function textElement(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  function signedOut() {
    if (!panel) return;
    panel.replaceChildren(
      textElement('p', 'text-sm font-medium text-stone-600', 'PawHeaven'),
      textElement('h1', 'mt-3 text-3xl font-semibold tracking-tight text-stone-950', 'You are signed out'),
      textElement('p', 'mt-3 leading-7 text-stone-700', 'Log in to change your name, email address, or password.'),
    );
    const login = document.createElement('a');
    login.href = '/login';
    login.className = 'mt-7 inline-block bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]';
    login.textContent = 'Log in';
    panel.append(login);
  }

  function signedIn(user: ApiUser) {
    if (!panel) return;
    panel.replaceChildren(
      textElement('p', 'text-sm font-medium text-stone-600', 'Profile and sign-in details'),
      textElement('h1', 'mt-3 text-3xl font-semibold tracking-tight text-stone-950', user.name),
      textElement('p', 'mt-2 text-stone-700', user.email),
    );
    const logout = document.createElement('button');
    logout.type = 'button';
    logout.className = 'mt-7 border border-stone-400 px-5 py-3 font-semibold text-stone-900 transition-colors hover:bg-stone-100';
    logout.textContent = 'Log out';
    const profile = document.createElement('form');
    profile.className = 'mt-6 border-t border-stone-300 pt-6';
    const label = textElement('label', 'block text-sm font-medium text-stone-900', 'Name');
    const name = document.createElement('input');
    name.name = 'name';
    name.value = user.name;
    name.maxLength = 100;
    name.required = true;
    name.className = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950';
    label.append(name);
    const save = document.createElement('button');
    save.type = 'submit';
    save.className = 'mt-3 bg-[var(--color-moss)] px-4 py-2.5 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]';
    save.textContent = 'Save name';
    const profileMessage = textElement('p', 'mt-2 text-sm text-stone-700', '');
    profileMessage.setAttribute('role', 'status');
    profile.append(label, save, profileMessage);
    profile.addEventListener('submit', async (event) => {
      event.preventDefault();
      const nextName = name.value.trim().replace(/\s+/g, ' ');
      if (!nextName || nextName.length > 100) { profileMessage.textContent = 'Enter a name up to 100 characters long.'; return; }
      save.disabled = true;
      try {
        const response = await fetch(`${apiBase}/auth/profile`, { method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: nextName }) });
        const payload = await response.json().catch(() => null) as { user?: ApiUser; message?: string } | null;
        if (!response.ok || !payload?.user) throw new Error(payload?.message || 'We could not save your profile.');
        name.value = payload.user.name;
        const heading = panel?.querySelector('h1');
        if (heading) heading.textContent = payload.user.name;
        profileMessage.textContent = 'Profile name saved.';
      } catch (exception) { profileMessage.textContent = exception instanceof Error ? exception.message : 'We could not save your profile.'; }
      finally { save.disabled = false; }
    });
    const security = document.createElement('section');
    security.className = 'mt-6 border-t border-stone-300 pt-6';
    security.append(textElement('h2', 'text-lg font-semibold text-stone-950', 'Sign-in details'));
    security.append(
      accountForm('Change email address', 'Save new email', [
        { name: 'email', label: 'New email address', type: 'email', autocomplete: 'email' },
        { name: 'currentPassword', label: 'Current password', type: 'password', autocomplete: 'current-password' },
      ], async (values) => {
        const payload: ChangeEmailInput = { email: values.email.trim(), currentPassword: values.currentPassword };
        const result = await accountRequest<{ message: string }>('/auth/email', 'PUT', payload);
        return result.message;
      }),
      accountForm('Change password', 'Save new password', [
        { name: 'currentPassword', label: 'Current password', type: 'password', autocomplete: 'current-password' },
        { name: 'newPassword', label: 'New password', type: 'password', autocomplete: 'new-password', help: 'At least 8 characters, with an uppercase letter, a lowercase letter, a number, and a special character.' },
      ], async (values) => {
        const problem = passwordProblem(values.newPassword);
        if (problem) throw new AccountError(problem, { newPassword: problem });
        const payload: ChangePasswordInput = { currentPassword: values.currentPassword, newPassword: values.newPassword };
        await accountRequest('/auth/change-password', 'POST', payload);
        return 'Your password was changed.';
      }),
    );
    logout.addEventListener('click', async () => {
      logout.disabled = true;
      logout.textContent = 'Logging out…';
      try {
        const response = await fetch(`${apiBase}/auth/logout`, { method: 'POST', credentials: 'include' });
        if (!response.ok) throw new Error('Logout failed.');
        signedOut();
        window.dispatchEvent(new CustomEvent('pawheaven:authchange', { detail: { signedIn: false } }));
      } catch {
        logout.disabled = false;
        logout.textContent = 'Log out';
      }
    });
    const dashboard = document.createElement('p');
    dashboard.className = 'mt-8 border-t border-stone-300 pt-6 text-sm leading-6 text-stone-700';
    dashboard.append('Your visits, volunteer shifts, applications, matches, and saved contact details are on ');
    const dashboardLink = document.createElement('a');
    dashboardLink.href = '/me';
    dashboardLink.className = 'font-medium text-[var(--color-moss-dark)] underline underline-offset-4';
    dashboardLink.textContent = 'My PawHeaven';
    dashboard.append(dashboardLink, '.');
    panel.append(profile, security, logout, dashboard);
  }

  class AccountError extends Error {
    fieldErrors?: FieldErrors;
    constructor(message: string, fieldErrors?: FieldErrors) { super(message); this.fieldErrors = fieldErrors; }
  }

  async function accountRequest<T>(path: string, method: string, body: unknown): Promise<T> {
    const response = await fetch(`${apiBase}${path}`, { method, credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const payload = await response.json().catch(() => null) as ({ message?: unknown; fieldErrors?: FieldErrors } & T) | null;
    if (!response.ok) throw new AccountError(typeof payload?.message === 'string' ? payload.message : 'The request could not be completed.', payload?.fieldErrors);
    return payload as T;
  }

  type AccountFieldSpec = { name: string; label: string; type: string; autocomplete: string; help?: string };

  /** A small disclosure form with per-field errors and a status message. */
  function accountForm(title: string, submitLabel: string, fields: AccountFieldSpec[], onSubmit: (values: Record<string, string>) => Promise<string>) {
    const details = document.createElement('details');
    details.className = 'mt-4 border border-stone-300 bg-white px-4 py-3';
    details.append(textElement('summary', 'cursor-pointer text-sm font-semibold text-stone-950', title));
    const form = document.createElement('form');
    form.className = 'mt-4 grid gap-4';
    form.noValidate = true;
    const inputs = new Map<string, HTMLInputElement>();
    const errors = new Map<string, HTMLElement>();
    for (const spec of fields) {
      const label = textElement('label', 'block text-sm font-medium text-stone-900', spec.label);
      const input = document.createElement('input');
      input.name = spec.name;
      input.type = spec.type;
      input.setAttribute('autocomplete', spec.autocomplete);
      input.maxLength = 1024;
      input.required = true;
      input.className = 'mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950';
      label.append(input);
      const error = textElement('p', 'mt-2 hidden text-sm text-red-800', '');
      error.setAttribute('role', 'alert');
      inputs.set(spec.name, input);
      errors.set(spec.name, error);
      const wrapper = document.createElement('div');
      wrapper.append(label);
      if (spec.help) wrapper.append(textElement('p', 'mt-2 text-sm text-stone-600', spec.help));
      wrapper.append(error);
      form.append(wrapper);
    }
    const submit = textElement('button', 'justify-self-start bg-[var(--color-moss)] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70', submitLabel) as HTMLButtonElement;
    submit.type = 'submit';
    const status = textElement('p', 'text-sm', '');
    status.setAttribute('role', 'status');
    form.append(submit, status);
    function showErrors(fieldErrors: FieldErrors) {
      for (const [name, error] of errors) {
        error.textContent = fieldErrors[name] ?? '';
        error.classList.toggle('hidden', !fieldErrors[name]);
      }
    }
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showErrors({});
      status.textContent = '';
      const values = Object.fromEntries([...inputs].map(([name, input]) => [name, input.value]));
      const missing = Object.fromEntries([...inputs].filter(([, input]) => !input.value).map(([name]) => [name, 'This field is required.']));
      if (Object.keys(missing).length) return showErrors(missing);
      submit.disabled = true;
      try {
        status.textContent = await onSubmit(values);
        status.className = 'text-sm text-[var(--color-moss-dark)]';
        for (const input of inputs.values()) input.value = '';
      } catch (exception) {
        if (exception instanceof AccountError && exception.fieldErrors) showErrors(exception.fieldErrors);
        status.textContent = exception instanceof Error ? exception.message : 'We could not save that change.';
        status.className = 'text-sm text-red-800';
      } finally { submit.disabled = false; }
    });
    details.append(form);
    return details;
  }

  async function loadAccount() {
    try {
      const response = await fetch(`${apiBase}/auth/me`, { credentials: 'include' });
      if (response.status === 401) return signedOut();
      if (!response.ok) throw new Error('Account details are unavailable.');
      const payload = await response.json() as { user: ApiUser };
      signedIn(payload.user);
    } catch { signedOut(); }
  }

  loadAccount();
</script>
