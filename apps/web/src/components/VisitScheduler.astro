<div class="mx-auto max-w-5xl px-6 py-12">
  <section class="border border-stone-300 bg-white p-7 sm:p-9" data-visit-scheduler aria-live="polite">
    <p class="text-sm text-stone-600">Loading visit times…</p>
  </section>
</div>

<script>
  import type { ApiUser, BookVisitInput, VisitAppointmentListResponse, VisitSlot, VisitSlotListResponse } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';

  const shelterTimeZone = 'America/New_York';
  const container = document.querySelector<HTMLElement>('[data-visit-scheduler]');
  let selectedSlotId = '';
  // Arriving from a pet page (?name=Baxter) pre-writes the reason for the visit.
  const requestedName = new URLSearchParams(window.location.search).get('name')?.trim().slice(0, 60) ?? '';
  const suggestedPurpose = requestedName ? `I would like to meet ${requestedName} and learn about adopting or fostering.` : '';
  let slots: VisitSlot[] = [];

  function element(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  function visitTime(startsAt: string, endsAt: string) {
    const start = new Date(startsAt);
    const end = new Date(endsAt);
    if (Number.isNaN(start.valueOf()) || Number.isNaN(end.valueOf())) return 'Unknown visit time';
    const date = new Intl.DateTimeFormat(undefined, { timeZone: shelterTimeZone, weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(start);
    const range = new Intl.DateTimeFormat(undefined, { timeZone: shelterTimeZone, hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).formatRange(start, end);
    return `${date} · ${range}`;
  }

  function showSignedOut() {
    if (!container) return;
    container.replaceChildren(
      element('h1', 'text-3xl font-semibold tracking-tight text-stone-950', 'Schedule a shelter visit'),
      element('p', 'mt-4 max-w-2xl leading-7 text-stone-700', 'Log in to see available shelter visit times, choose a time, and leave a short note about your visit.'),
    );
    const login = document.createElement('a');
    login.href = '/login';
    login.className = 'mt-7 inline-block bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]';
    login.textContent = 'Log in to schedule';
    container.append(login);
  }

  function message(target: HTMLElement, content: string, error = false) {
    target.textContent = content;
    target.className = `mt-4 text-sm ${error ? 'text-red-800' : 'text-[var(--color-moss-dark)]'}`;
  }

  function renderScheduler(user: ApiUser, previousMessage?: string, initialPurpose = '') {
    if (!container) return;
    container.replaceChildren(
      element('h1', 'text-3xl font-semibold tracking-tight text-stone-950', 'Schedule a shelter visit'),
      element('p', 'mt-4 max-w-2xl leading-7 text-stone-700', `Choose an open time for a general visit. We’ll use the email on your PawHeaven account (${user.email}) to confirm it in your account.`),
      element('p', 'mt-2 text-sm text-stone-600', 'All visit times are shown in America/New_York.'),
    );
    const form = document.createElement('form');
    form.className = 'mt-8 border-t border-stone-300 pt-7';
    form.noValidate = true;
    const choicesHeading = element('h2', 'text-lg font-semibold text-stone-950', 'Available visit times');
    const choices = document.createElement('div');
    choices.className = 'mt-4 grid gap-3';
    const visibleSlots = slots.filter((slot) => slot.available || slot.id === selectedSlotId);
    if (!visibleSlots.length) {
      choices.append(element('p', 'leading-7 text-stone-700', 'There are no future visit times available right now. Please check back soon.'));
    }
    for (const slot of visibleSlots) {
      const label = document.createElement('label');
      label.className = `flex items-start gap-3 border px-4 py-4 ${slot.available ? 'border-stone-300 cursor-pointer hover:border-[var(--color-moss)]' : 'border-stone-200 bg-stone-50 text-stone-500'}`;
      const radio = document.createElement('input');
      radio.type = 'radio';
      radio.name = 'slot';
      radio.value = slot.id;
      radio.checked = slot.id === selectedSlotId;
      radio.disabled = !slot.available;
      radio.className = 'mt-1';
      radio.addEventListener('change', () => { selectedSlotId = slot.id; });
      const text = document.createElement('span');
      text.className = 'min-w-0';
      text.append(element('span', 'block font-medium text-stone-950', visitTime(slot.startsAt, slot.endsAt)));
      text.append(element('span', `mt-1 block text-sm ${slot.available ? 'text-stone-700' : 'text-stone-500'}`, slot.available ? 'Open' : 'Already booked'));
      label.append(radio, text);
      choices.append(label);
    }
    const purposeLabel = document.createElement('label');
    purposeLabel.className = 'mt-7 block text-sm font-medium text-stone-900';
    purposeLabel.textContent = 'What would you like to discuss during your visit?';
    const purpose = document.createElement('textarea');
    purpose.name = 'purpose';
    purpose.required = true;
    purpose.maxLength = 500;
    purpose.className = 'mt-2 block min-h-28 w-full resize-y border border-stone-400 bg-white px-3 py-2.5 text-stone-950';
    purpose.placeholder = 'For example: I would like to learn more about meeting the animals and the adoption process.';
    purpose.value = initialPurpose || suggestedPurpose;
    purposeLabel.append(purpose);
    const controls = document.createElement('div');
    controls.className = 'mt-5 flex flex-wrap items-center gap-3';
    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.disabled = !visibleSlots.some((slot) => slot.available);
    submit.className = 'bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-not-allowed disabled:opacity-60';
    submit.textContent = 'Confirm visit';
    const result = document.createElement('p');
    result.setAttribute('role', 'status');
    controls.append(submit, result);
    form.append(choicesHeading, choices, purposeLabel, controls);
    container.append(form);
    if (previousMessage) message(result, previousMessage);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload: BookVisitInput = { slotId: selectedSlotId, purpose: purpose.value.trim() };
      if (!payload.slotId) return message(result, 'Choose an available visit time.', true);
      if (!payload.purpose || payload.purpose.length > 500) return message(result, 'Tell the shelter why you would like to visit, using up to 500 characters.', true);
      submit.disabled = true;
      submit.textContent = 'Confirming…';
      try {
        const response = await fetch(`${apiBase}/appointments`, {
          method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        const responseBody = await response.json().catch(() => null) as { message?: unknown } | null;
        if (!response.ok) throw new Error(typeof responseBody?.message === 'string' ? responseBody.message : 'We could not confirm your visit.');
        selectedSlotId = '';
        await load(user, 'Your visit is confirmed. You can reschedule or cancel it from your account.');
      } catch (exception) {
        message(result, exception instanceof Error ? exception.message : 'We could not confirm your visit.', true);
        submit.disabled = false;
        submit.textContent = 'Confirm visit';
        if (exception instanceof Error && /no longer available|just booked/i.test(exception.message)) {
          await refreshAvailability();
          selectedSlotId = '';
          renderScheduler(user, exception.message, payload.purpose);
        }
      }
    });
  }

  async function refreshAvailability() {
    try {
      const response = await fetch(`${apiBase}/visit-slots`, { credentials: 'include' });
      if (!response.ok) return;
      slots = (await response.json() as VisitSlotListResponse).slots;
    } catch { /* The confirmation error remains the useful message. */ }
  }

  async function load(user?: ApiUser, confirmation?: string) {
    try {
      const identity = user ? { user } : await (async () => {
        const response = await fetch(`${apiBase}/auth/me`, { credentials: 'include' });
        if (response.status === 401) return null;
        if (!response.ok) throw new Error();
        return response.json() as Promise<{ user: ApiUser }>;
      })();
      if (!identity) return showSignedOut();
      const [slotResponse, appointmentResponse] = await Promise.all([
        fetch(`${apiBase}/visit-slots`, { credentials: 'include' }),
        fetch(`${apiBase}/appointments`, { credentials: 'include' }),
      ]);
      if (!slotResponse.ok || !appointmentResponse.ok) throw new Error();
      slots = (await slotResponse.json() as VisitSlotListResponse).slots;
      const appointments = await appointmentResponse.json() as VisitAppointmentListResponse;
      const active = appointments.appointments.find((appointment) => appointment.status === 'booked' && Date.parse(appointment.startsAt) > Date.now());
      if (active && confirmation) confirmation = `${confirmation} Your appointment is ${visitTime(active.startsAt, active.endsAt)}.`;
      renderScheduler(identity.user, confirmation);
    } catch {
      if (!container) return;
      container.replaceChildren(
        element('h1', 'text-3xl font-semibold tracking-tight text-stone-950', 'Visit scheduling is unavailable'),
        element('p', 'mt-4 leading-7 text-stone-700', 'We could not load visit times right now. Please try again shortly.'),
      );
    }
  }

  void load();
</script>
