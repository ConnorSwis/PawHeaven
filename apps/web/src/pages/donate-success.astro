---
import PageShell from '../layouts/PageShell.astro';
---

<PageShell title="Thank you" description="Thank you for supporting PawHeaven." noindex>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <section class="border border-stone-300 bg-white p-7 sm:p-10" aria-labelledby="thanks-title">
      <p class="text-sm font-medium text-[var(--color-moss-dark)]">Donation received</p>
      <h1 id="thanks-title" class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Thank you for your gift</h1>
      <p class="mt-5 max-w-2xl leading-7 text-stone-700">Your support helps feed, treat, and shelter the animals in our care while they wait for a home. We are grateful.</p>
      <p class="mt-4 max-w-2xl leading-7 text-stone-700">Stripe sends your receipt to the email address you entered at checkout. If it does not arrive within a few minutes, check your spam folder or contact the shelter.</p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a class="bg-[var(--color-moss)] px-5 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)]" href="/pets">Meet our pets</a>
        <a class="border border-stone-400 px-5 py-3 font-semibold text-stone-900 transition-colors hover:bg-stone-100" href="/volunteer">Volunteer your time</a>
        <a class="px-2 py-3 font-medium text-[var(--color-moss-dark)] underline underline-offset-4" href="/">Back to home</a>
      </div>

      <p class="mt-8 border-t border-stone-300 pt-5 text-sm leading-6 text-stone-600">Did you land here without finishing a payment? Nothing was charged. <a class="underline underline-offset-4" href="/donate">Return to the donation page</a> to try again.</p>
    </section>
  </div>
</PageShell>
