---
import PageShell from '../layouts/PageShell.astro';
import FosterAnimals from '../app/foster/FosterAnimals';
import StatusBannerIsland from '../app/status/StatusBannerIsland';
import { Accordion, AccordionItem, ButtonLink, Card, IconTile, PageHero, Section, SectionHeader, TextLink } from '../ui';
import { ClockIcon, HomeIcon, ShieldCheckIcon } from '../ui/icons';
import { SHELTER } from '@pawheaven/contracts/site';

const faq = [
  ['How long does a foster stay last?', 'Most stays are a few weeks. Some animals need only a weekend and some need longer, for example a litter growing up or a dog recovering from surgery. You tell us the dates you can offer and we match you to an animal that fits.'],
  ['Do I need experience?', 'No. Tell us what experience you do have on the application. Our team explains what each animal needs and answers questions while you foster.'],
  ['What does it cost?', 'The animal stays under the shelter’s care. Ask us about food, supplies, and vet visits when we talk, so you know exactly what we cover before you say yes.'],
  ['Can I foster if I have other pets?', 'Often yes. Tell us about your pets on the application and we will choose an animal that suits your home.'],
  ['What if I fall in love?', 'It happens. Tell us, and we will talk through adopting the animal you have been caring for.'],
  ['What if it is not working out?', 'Call us. We would rather hear early and find another plan than have you struggle alone.'],
];

const cards = [
  { title: 'What fostering asks of you', icon: HomeIcon, kind: 'ul', items: [
    'A safe, calm place at home, and the dates you can offer.',
    'Daily feeding, exercise, and company.',
    'Photos and a few words about the animal’s personality. They help us find the right adopter.',
    'Bringing the animal to the shelter for adoption meetings when needed.',
  ] },
  { title: 'What we provide', icon: ShieldCheckIcon, kind: 'ul', items: [
    'A staff contact you can call or email with any question.',
    'Medical care arranged through the shelter.',
    'Guidance on what each animal needs, and help finding the right match.',
    'Help finding the animal a permanent home.',
  ] },
  { title: 'How it works', icon: ClockIcon, kind: 'ol', items: [
    'Choose an animal below and tell us about your home and the dates you can foster. It takes about five minutes.',
    'Our team reads your application and emails you. We may call to talk it through.',
    'Once you are approved, we agree on a pick-up time and go over what the animal needs.',
    'You foster, and we help find a permanent home.',
  ] },
];
---

<PageShell title="Foster" statusBanner description={`Foster an animal from ${SHELTER.name}. A few weeks in a home helps a shelter animal rest, heal, and get ready for adoption.`}>
  <PageHero
    eyebrow="Foster"
    title="Open your home for a little while."
    highlight="little while"
    intro="A foster home is a quiet place to rest, heal, or grow up while an animal waits for adoption. Most stays are a few weeks, and every one frees up space for another animal in need."
  >
    <div class="mt-7 flex flex-wrap items-center gap-3"><ButtonLink variant="primary" href="/apply?type=foster">Apply to foster</ButtonLink><ButtonLink href="#animals">See who needs a home</ButtonLink></div>
  </PageHero>

  <div class="mx-auto max-w-6xl px-4 sm:px-6"><StatusBannerIsland client:load className="mb-2" /></div>

  <Section labelledBy="what-heading" innerClassName="pt-6 sm:pt-8">
    <SectionHeader id="what-heading" title="What fostering looks like" intro="Plain answers to what you do, what we do, and how to start." />
    <ul class="mt-8 grid gap-5 lg:grid-cols-3">
      {cards.map((card) => (
        <li>
          <Card as="div" className="flex h-full flex-col gap-3">
            <IconTile size="lg"><card.icon width={28} height={28} /></IconTile>
            <h3 class="text-xl font-semibold text-stone-950">{card.title}</h3>
            {card.kind === 'ul'
              ? <ul class="grid list-disc gap-2 pl-5 text-base leading-7 text-stone-800">{card.items.map((item) => <li>{item}</li>)}</ul>
              : <ol class="grid list-decimal gap-2 pl-5 text-base leading-7 text-stone-800">{card.items.map((item) => <li>{item}</li>)}</ol>}
          </Card>
        </li>
      ))}
    </ul>
  </Section>

  <FosterAnimals client:load />

  <Section labelledBy="faq-heading">
    <div class="mx-auto max-w-3xl">
      <SectionHeader id="faq-heading" title="Questions about fostering" />
      <Accordion className="mt-6">
        {faq.map(([question, answer]) => <AccordionItem question={question}><p>{answer}</p></AccordionItem>)}
      </Accordion>
      <p class="mt-6 text-base text-stone-800">Something else? Call <TextLink href={SHELTER.phoneHref}>{SHELTER.phone}</TextLink> or email <TextLink href={`mailto:${SHELTER.email}`}>{SHELTER.email}</TextLink>.</p>
    </div>
  </Section>
</PageShell>
