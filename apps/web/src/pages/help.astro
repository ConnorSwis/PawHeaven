---
import PageShell from '../layouts/PageShell.astro';
import StatusBannerIsland from '../app/status/StatusBannerIsland';
import { PageHeading } from '../ui';
import { SHELTER } from '@pawheaven/contracts/site';

const ways = [
  ['Foster', 'Give an animal a quiet place to rest, heal, or grow up for a few weeks. Every foster home frees up a kennel for another animal in need.', '/foster', 'See how fostering works'],
  ['Volunteer', 'Walk dogs, play with cats, and help keep the shelter running. Pick a shift and sign up in two taps.', '/volunteer', 'See open shifts'],
  ['Donate', 'Food, medical care, and warm beds all come from gifts like yours. Give once or every month.', '/donate', 'Give today'],
  ['Come to an event', 'Adoption days, open houses, and fundraisers are a friendly way to meet the team and the animals.', '/events', 'See what is coming up'],
];
---

<PageShell title="Ways to help" statusBanner description={`Foster, volunteer, donate, or come to an event. Every way of helping ${SHELTER.name} makes a difference for the animals.`}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <PageHeading title="Ways to help" intro="Not ready to adopt? There are plenty of ways to make an animal’s day better, and each one gets an animal closer to a home." />
    <StatusBannerIsland client:load className="mt-8" />
    <ul class="mt-8 grid gap-5 sm:grid-cols-2">
      {ways.map(([title, text, href, cta]) => (
        <li class="ph-lift flex flex-col rounded-[var(--ph-radius)] border border-stone-300 bg-white p-6 shadow-[var(--ph-shadow-sm)]">
          <h2 class="text-xl font-semibold text-stone-950">{title}</h2>
          <p class="mt-2 flex-1 text-base leading-7 text-stone-800">{text}</p>
          <p class="mt-4"><a class="inline-flex min-h-11 items-center rounded-[var(--ph-radius-pill)] bg-[var(--ph-brand-soft)] px-5 py-2 text-base font-semibold text-[var(--ph-brand-strong)] transition-colors hover:bg-stone-100" href={href}>{cta}</a></p>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-base leading-7 text-stone-800">Looking to adopt or to meet an animal? <a class="font-medium text-[var(--ph-brand-strong)] underline underline-offset-4" href="/adopt">Meet the animals</a> or <a class="font-medium text-[var(--ph-brand-strong)] underline underline-offset-4" href="/visit">plan a visit</a>.</p>
  </div>
</PageShell>
