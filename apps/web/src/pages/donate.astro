---
import PageShell from '../layouts/PageShell.astro';
import { DONATE_URL, isTestDonateLink } from '../lib/donate';
---

<PageShell title="Donate" description="Support the animals at PawHeaven with a secure donation through Stripe.">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <section class="border border-stone-300 bg-white p-7 sm:p-10">
      <p class="text-sm font-medium text-[var(--color-moss-dark)]">Support the shelter</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Help a pet find a home</h1>
      <p class="mt-5 max-w-2xl leading-7 text-stone-700">Donations help pay for food, medical care, and shelter for the animals waiting for their families. Every gift, large or small, makes a difference.</p>

      {isTestDonateLink && (
        <aside class="mt-7 border border-amber-700 bg-amber-50 p-4 text-sm leading-6 text-amber-950" data-test-mode-notice>
          <p class="font-semibold">Test mode: no real money will move.</p>
          <p class="mt-1">Use card number <span class="font-mono">4242 4242 4242 4242</span>, any future expiry date, any 3-digit security code, and any ZIP code.</p>
        </aside>
      )}

      <a
        class="mt-8 inline-block bg-[var(--color-moss)] px-7 py-4 text-lg font-semibold text-on-brand transition-colors hover:bg-[var(--color-moss-dark)]"
        href={DONATE_URL}
        rel="noopener"
        data-donate-link
      >Donate securely with Stripe</a>

      <h2 class="mt-10 text-lg font-semibold text-stone-950">How it works</h2>
      <ol class="mt-3 grid gap-2 pl-5 leading-7 text-stone-700 [list-style:decimal]">
        <li>Choose Donate. You will go to Stripe's secure checkout page.</li>
        <li>Enter your gift and your contact and payment details there.</li>
        <li>When the payment goes through, you come back to PawHeaven and Stripe emails your receipt.</li>
      </ol>

      <p class="mt-8 border-t border-stone-300 pt-5 text-sm leading-6 text-stone-600">Payments are processed by Stripe. PawHeaven never sees or stores your card details. If a payment is declined or you close the page, nothing is charged and you can try again.</p>
    </section>
  </div>
</PageShell>
