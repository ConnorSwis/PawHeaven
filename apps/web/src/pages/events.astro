---
import PageShell from '../layouts/PageShell.astro';
import EventList from '../app/events/EventList';
import { ButtonLink, PageHero, Section, SectionHeader } from '../ui';
import { SHELTER } from '@pawheaven/contracts/site';
---

<PageShell title="Shelter events" description="See upcoming PawHeaven open houses and shelter events, including featured animals and ways to get involved.">
  <PageHero
    eyebrow="Events"
    title="Come meet the animals, and the people too."
    highlight="people"
    intro="Join us for open houses and other ways to meet animals, connect with the shelter, and help out."
  >
    <div class="mt-7 flex flex-wrap items-center gap-3"><ButtonLink variant="primary" href="/visit">Plan a visit</ButtonLink><ButtonLink href="/volunteer">See volunteer shifts</ButtonLink></div>
  </PageHero>
  <Section tone="tint" labelledBy="upcoming-heading">
    <SectionHeader id="upcoming-heading" title="Coming up" intro="Dates and times are in the shelter’s time zone (Eastern)." />
    <div class="mt-8"><EventList client:load /></div>
  </Section>
  <Section labelledBy="open-days-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="open-days-heading" class="text-2xl font-bold tracking-tight text-stone-950 sm:text-3xl">Cannot make an event?</h2>
      <p class="mt-2 text-base leading-7 text-stone-800">You can meet the animals on any open day.</p>
      <dl class="mx-auto mt-5 grid max-w-md gap-2 rounded-[var(--ph-radius)] border border-stone-300 bg-white p-5 text-left text-base shadow-sm">
        {SHELTER.hours.map((row) => <div class="flex flex-wrap justify-between gap-x-4"><dt class="text-stone-800">{row.days}</dt><dd class="font-semibold text-stone-950">{row.open}</dd></div>)}
      </dl>
      <p class="mt-6"><ButtonLink variant="secondary" href="/visit">Plan a visit</ButtonLink></p>
    </div>
  </Section>
</PageShell>
