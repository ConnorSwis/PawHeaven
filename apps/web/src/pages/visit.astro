---
import PageShell from '../layouts/PageShell.astro';
import VisitBooking from '../app/visit/VisitBooking';
import { PageHeading } from '../ui';
import { SHELTER } from '@pawheaven/contracts/site';

const address = `${SHELTER.address.line1}, ${SHELTER.address.city}, ${SHELTER.address.state} ${SHELTER.address.zip}`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
---

<PageShell title="Visit the shelter" description={`Book a time to meet the animals at ${SHELTER.name}. See our hours, address, and what to expect.`}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <PageHeading title="Visit the shelter" intro="Book a time to meet the animals. You can look at open times without an account and only log in at the end to confirm.">
      <p class="mt-3"><a class="font-medium text-[var(--ph-brand-strong)] underline underline-offset-4" href="#plan">Hours and directions</a></p>
    </PageHeading>
    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-start">
      <div><VisitBooking client:load /></div>
      <aside id="plan" aria-labelledby="plan-heading" class="grid gap-4 scroll-mt-6">
        <h2 id="plan-heading" class="sr-only">Plan your visit</h2>
        <section class="rounded-[var(--ph-radius)] border border-stone-300 bg-white p-5">
          <h3 class="text-lg font-semibold text-stone-950">Hours</h3>
          <dl class="mt-3 grid gap-2 text-base">
            {SHELTER.hours.map((row) => (
              <div class="flex justify-between gap-4"><dt class="text-stone-800">{row.days}</dt><dd class="text-right font-medium text-stone-950">{row.open}</dd></div>
            ))}
          </dl>
          <p class="mt-3 text-sm leading-6 text-stone-700">{SHELTER.hoursNote} Times are Eastern.</p>
        </section>
        <section class="rounded-[var(--ph-radius)] border border-stone-300 bg-white p-5">
          <h3 class="text-lg font-semibold text-stone-950">Find us</h3>
          <address class="mt-2 text-base not-italic leading-7 text-stone-900">
            {SHELTER.name}<br />{SHELTER.address.line1}<br />{SHELTER.address.city}, {SHELTER.address.state} {SHELTER.address.zip}
          </address>
          <p class="mt-3"><a class="inline-flex min-h-11 items-center font-medium text-[var(--ph-brand-strong)] underline underline-offset-4" href={directions} target="_blank" rel="noreferrer">Get directions<span class="sr-only"> (opens in a new tab)</span></a></p>
          <p class="text-base text-stone-800">Questions? <a class="inline-flex min-h-11 items-center font-medium text-[var(--ph-brand-strong)] underline underline-offset-4" href={SHELTER.phoneHref}>{SHELTER.phone}</a></p>
        </section>
        <section class="rounded-[var(--ph-radius)] border border-stone-300 bg-white p-5">
          <h3 class="text-lg font-semibold text-stone-950">What to expect</h3>
          <ul class="mt-2 grid list-disc gap-1.5 pl-5 text-base leading-7 text-stone-800">
            <li>A staff member or volunteer greets you and introduces the animals you chose.</li>
            <li>You can bring everyone in your household. Booking tells us how many to expect.</li>
            <li>If you hope to adopt, bring a government-issued photo ID.</li>
            <li>Wear closed-toe shoes.</li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</PageShell>
