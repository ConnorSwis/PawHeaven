---
import PageShell from '../layouts/PageShell.astro';
import { Mascot } from '../ui/Mascot';
import { ButtonLink } from '../ui';
---

<PageShell title="Page not found" description="We could not find that page. Try the animals or the home page." noindex>
  <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-14 text-center sm:px-6 sm:py-20">
    <div class="relative grid place-items-center">
      <span aria-hidden="true" class="absolute size-56 rounded-full bg-[var(--ph-pop)] opacity-50"></span>
      <Mascot pose="searching" species="dog" size={200} className="relative" />
    </div>
    <p class="mt-6 text-sm font-semibold uppercase tracking-wide text-stone-700">Error 404</p>
    <h1 class="mt-1 text-4xl font-bold tracking-tight text-stone-950 sm:text-5xl">This page <span class="ph-highlight">wandered off</span></h1>
    <p class="mt-4 max-w-lg text-lg leading-8 text-stone-800">We looked everywhere and could not find it. The link may be old or mistyped. The animals, at least, are right where we left them.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <ButtonLink variant="primary" href="/adopt">Meet the animals</ButtonLink>
      <ButtonLink href="/">Go to the home page</ButtonLink>
    </div>
  </div>
</PageShell>
