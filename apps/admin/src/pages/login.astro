---
import AdminShell from '../layouts/AdminShell.astro';
---

<AdminShell title="Log in">
  <div class="grid place-items-center py-4">
    <section class="w-full max-w-md border border-stone-300 bg-white p-7 sm:p-9" aria-labelledby="login-title">
      <h1 id="login-title" class="text-2xl font-semibold tracking-tight text-stone-950">Log in</h1>
      <p class="mt-2 leading-6 text-stone-700">Use the credentials created from your staff invitation.</p>
      <form class="mt-8 space-y-5" data-login-form novalidate>
        <div>
          <label class="mb-2 block text-sm font-medium text-stone-900" for="email">Email address</label>
          <input class="block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 placeholder:text-stone-500" id="email" name="email" type="email" autocomplete="email" autocapitalize="none" spellcheck="false" required maxlength="254" placeholder="name@example.com" />
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-stone-900" for="password">Password</label>
          <input class="block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950" id="password" name="password" type="password" autocomplete="current-password" required maxlength="1024" />
        </div>
        <p class="hidden border-l-4 border-red-700 bg-red-50 px-3 py-2 text-sm text-red-900" data-form-error role="alert" tabindex="-1"></p>
        <button class="w-full bg-[var(--color-moss)] px-4 py-3 font-semibold text-on-brand transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70" type="submit" data-submit>Log in</button>
      </form>
    </section>
  </div>
</AdminShell>

<script>
  import { apiBase } from '../lib/api';
  const form = document.querySelector<HTMLFormElement>('[data-login-form]');
  const error = document.querySelector<HTMLParagraphElement>('[data-form-error]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');
  const email = form?.elements.namedItem('email') as HTMLInputElement | null;
  const password = form?.elements.namedItem('password') as HTMLInputElement | null;
  let submitting = false;

  function showError(message: string) {
    if (!error) return;
    error.textContent = message;
    error.classList.remove('hidden');
    error.focus();
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitting || !email || !password) return;
    email.value = email.value.trim();
    if (!email.validity.valid || !password.value) return showError('Enter your email address and password.');
    submitting = true;
    if (submit) { submit.disabled = true; submit.textContent = 'Logging in…'; }
    try {
      const response = await fetch(`${apiBase}/auth/login`, {
        method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.value, password: password.value }),
      });
      const payload = await response.json().catch(() => null) as { message?: unknown } | null;
      if (!response.ok) throw new Error(typeof payload?.message === 'string' ? payload.message : 'We could not log you in.');
      window.location.assign('/');
    } catch (exception) {
      showError(exception instanceof Error ? exception.message : 'We could not reach the account service. Please try again.');
    } finally {
      submitting = false;
      if (submit) { submit.disabled = false; submit.textContent = 'Log in'; }
    }
  });
</script>
