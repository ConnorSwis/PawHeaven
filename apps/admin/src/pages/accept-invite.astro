---
import AdminShell from '../layouts/AdminShell.astro';
---

<AdminShell title="Set password">
  <div class="grid place-items-center py-4">
    <section class="w-full max-w-md border border-stone-300 bg-white p-7 sm:p-9" data-invite-panel aria-live="polite">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-950">Set your password</h1>
      <p class="mt-3 leading-6 text-stone-700" data-message>Checking your account link…</p>
    </section>
  </div>
</AdminShell>

<script>
  import { passwordProblem } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';
  const panel = document.querySelector<HTMLElement>('[data-invite-panel]');

  function message(text: string, error = false) {
    if (!panel) return;
    const existing = panel.querySelector('[data-message]');
    const element = existing instanceof HTMLElement ? existing : document.createElement('p');
    element.dataset.message = '';
    element.className = `mt-3 leading-6 ${error ? 'text-red-800' : 'text-stone-700'}`;
    element.textContent = text;
    if (!existing) panel.append(element);
  }

  function passwordForm() {
    if (!panel) return;
    const form = document.createElement('form');
    form.className = 'mt-7 space-y-5';
    form.noValidate = true;
    const field = document.createElement('div');
    const label = document.createElement('label');
    label.htmlFor = 'new-password';
    label.className = 'mb-2 block text-sm font-medium text-stone-900';
    label.textContent = 'Choose a password';
    const input = document.createElement('input');
    input.id = 'new-password';
    input.type = 'password';
    input.autocomplete = 'new-password';
    input.minLength = 8;
    input.maxLength = 1024;
    input.required = true;
    input.className = 'block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950';
    field.append(label, input);
    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'w-full bg-[var(--color-moss)] px-4 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70';
    submit.textContent = 'Set password and continue';
    form.append(field, submit);
    panel.append(form);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const problem = passwordProblem(input.value);
      if (problem) return message(problem, true);
      submit.disabled = true;
      submit.textContent = 'Saving…';
      try {
        const response = await fetch(`${apiBase}/auth/password`, {
          method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: input.value }),
        });
        const payload = await response.json().catch(() => null) as { message?: unknown } | null;
        if (!response.ok) throw new Error(typeof payload?.message === 'string' ? payload.message : 'We could not save that password.');
        const administrator = await fetch(`${apiBase}/admin/me`, { credentials: 'include' });
        window.location.assign(administrator.ok ? '/' : 'https://pawheaven.online/account');
      } catch (exception) {
        message(exception instanceof Error ? exception.message : 'We could not save that password.', true);
        submit.disabled = false;
        submit.textContent = 'Set password and continue';
      }
    });
  }

  async function acceptAccountLink() {
    const values = new URLSearchParams(window.location.hash.slice(1));
    const tokenHash = values.get('token_hash');
    if (tokenHash) {
      // Keep the one-time credential out of the address bar and browser history.
      history.replaceState(null, '', window.location.pathname);
      if (!/^[a-f0-9]{56}$/i.test(tokenHash)) return message('This invitation link is incomplete. Ask a superadmin for a new invitation.', true);
      if (!panel) return;
      message('You have been invited to administer Paw Heaven. Continue to verify your invitation and choose a password.');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'mt-7 w-full bg-[var(--color-moss)] px-4 py-3 font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70';
      button.textContent = 'Continue to set password';
      panel.append(button);
      button.addEventListener('click', async () => {
        button.disabled = true;
        button.textContent = 'Verifying…';
        try {
          const response = await fetch(`${apiBase}/auth/verify-invitation`, {
            method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tokenHash }),
          });
          const payload = await response.json().catch(() => null) as { message?: unknown } | null;
          if (!response.ok) throw new Error(typeof payload?.message === 'string' ? payload.message : 'We could not verify your invitation.');
          button.remove();
          message('Your invitation is verified. Choose a password to continue.');
          passwordForm();
        } catch (exception) {
          message(exception instanceof Error ? exception.message : 'We could not verify your invitation.', true);
          button.disabled = false;
          button.textContent = 'Try again';
        }
      });
      return;
    }
    const accessToken = values.get('access_token');
    const refreshToken = values.get('refresh_token');
    if (!accessToken || !refreshToken) return message('This account link is incomplete or has expired. Ask shelter staff to send a new password reset or invitation.', true);
    try {
      const response = await fetch(`${apiBase}/auth/exchange`, {
        method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ accessToken, refreshToken }),
      });
      const payload = await response.json().catch(() => null) as { message?: unknown } | null;
      if (!response.ok) throw new Error(typeof payload?.message === 'string' ? payload.message : 'This account link is invalid or expired.');
      history.replaceState(null, '', window.location.pathname);
      message('Your account link is verified. Choose a password to continue.');
      passwordForm();
    } catch (exception) {
      message(exception instanceof Error ? exception.message : 'We could not verify your account link.', true);
    }
  }

  acceptAccountLink();
</script>
