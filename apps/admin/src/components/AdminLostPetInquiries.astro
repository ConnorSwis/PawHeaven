<section class="mt-10 border-t border-stone-300 pt-8" aria-labelledby="lost-pet-title">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="lost-pet-title" class="text-lg font-semibold text-stone-950">Lost-pet inquiries</h2>
    <button data-purge type="button" class="border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-900 transition-colors hover:bg-stone-100 disabled:cursor-wait disabled:opacity-70">Delete expired photos and inquiries</button>
  </div>
  <p class="mt-2 max-w-2xl leading-6 text-stone-700">Members send these after a photo search suggests one of our animals might be their pet. A visual match is not proof of ownership: verify details with the member before releasing any animal. Uploaded photos and inquiries are kept for 30 days after the latest inquiry, then removed when someone uses lost-pet search or presses the delete button here.</p>
  <p data-purge-message class="mt-3 hidden text-sm" role="status"></p>
  <div data-lost-pet-list class="mt-5 grid gap-4" aria-live="polite">
    <p class="text-sm text-stone-700">Loading lost-pet inquiries…</p>
  </div>
</section>

<script>
  import type { AdminLostPetInquiry, AdminLostPetInquiryListResponse, AdminLostPetInquiryUpdateInput, LostPetInquiryStatus } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';

  const list = document.querySelector<HTMLElement>('[data-lost-pet-list]');
  const purge = document.querySelector<HTMLButtonElement>('[data-purge]');
  const purgeMessage = document.querySelector<HTMLElement>('[data-purge-message]');
  let inquiries: AdminLostPetInquiry[] = [];

  function textNode(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  async function request<T>(path: string, init?: RequestInit): Promise<T> {
    const response = await fetch(`${apiBase}${path}`, { credentials: 'include', ...init });
    const payload = await response.json().catch(() => null) as { message?: unknown } | T | null;
    if (!response.ok) throw new Error(typeof (payload as { message?: unknown } | null)?.message === 'string' ? (payload as { message: string }).message : 'The request could not be completed.');
    return payload as T;
  }

  function render() {
    if (!list) return;
    list.replaceChildren();
    if (!inquiries.length) {
      list.append(textNode('p', 'text-sm leading-6 text-stone-700', 'No lost-pet inquiries right now.'));
      return;
    }
    for (const inquiry of inquiries) {
      const card = document.createElement('article');
      card.className = 'border border-stone-300 bg-white p-5';
      card.append(
        textNode('h3', 'font-semibold text-stone-950', `${inquiry.memberName} asks about ${inquiry.petName}`),
        textNode('p', 'mt-1 text-sm text-stone-700', `${inquiry.memberEmail} · ${inquiry.memberPhone} · Sent ${new Date(inquiry.createdAt).toLocaleString()} · ${inquiry.status}`),
        textNode('p', 'mt-3 whitespace-pre-wrap leading-7 text-stone-800', inquiry.message),
        textNode('p', 'mt-2 text-sm text-stone-700', `Reported species: ${inquiry.searchSpecies}${inquiry.searchDescription ? ` · Description: ${inquiry.searchDescription}` : ''}`),
      );

      const photos = document.createElement('div');
      photos.className = 'mt-4 flex flex-wrap items-start gap-4';
      if (inquiry.petImageUrl) {
        const figure = document.createElement('figure');
        const image = document.createElement('img');
        image.src = inquiry.petImageUrl;
        image.alt = `${inquiry.petName} in the shelter`;
        image.className = 'h-32 w-auto border border-stone-300 object-cover';
        figure.append(image, textNode('figcaption', 'mt-1 text-xs text-stone-600', 'Shelter photo'));
        photos.append(figure);
      }
      for (const url of inquiry.photoUrls) {
        const figure = document.createElement('figure');
        const link = document.createElement('a');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        const image = document.createElement('img');
        image.src = url;
        image.alt = 'Photo uploaded by the member';
        image.className = 'h-32 w-auto border border-stone-300 object-cover';
        link.append(image);
        figure.append(link, textNode('figcaption', 'mt-1 text-xs text-stone-600', 'Member’s photo'));
        photos.append(figure);
      }
      if (photos.childElementCount) card.append(photos);

      const controls = document.createElement('div');
      controls.className = 'mt-5 grid gap-3 sm:max-w-xl';
      const statusLabel = textNode('label', 'block text-sm font-medium text-stone-900', 'Status');
      const select = document.createElement('select');
      select.className = 'mt-2 block border border-stone-400 bg-white px-3 py-2 text-stone-950';
      for (const status of ['New', 'In progress', 'Resolved'] as LostPetInquiryStatus[]) {
        const option = document.createElement('option');
        option.value = status;
        option.textContent = status;
        option.selected = status === inquiry.status;
        select.append(option);
      }
      statusLabel.append(select);
      const noteLabel = textNode('label', 'block text-sm font-medium text-stone-900', 'Staff note (visible to staff only)');
      const note = document.createElement('textarea');
      note.rows = 2;
      note.maxLength = 1000;
      note.value = inquiry.staffNote;
      note.className = 'mt-2 block w-full resize-y border border-stone-400 bg-white px-3 py-2 font-normal text-stone-950';
      noteLabel.append(note);
      const row = document.createElement('div');
      row.className = 'flex flex-wrap items-center gap-3';
      const save = textNode('button', 'bg-[var(--color-moss)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70', 'Save') as HTMLButtonElement;
      save.type = 'button';
      const result = textNode('p', 'text-sm', '');
      result.setAttribute('role', 'status');
      save.addEventListener('click', async () => {
        const body: AdminLostPetInquiryUpdateInput = { status: select.value as LostPetInquiryStatus, staffNote: note.value.trim() };
        save.disabled = true;
        save.textContent = 'Saving…';
        try {
          await request(`/admin/lost-pet-inquiries/${encodeURIComponent(inquiry.id)}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          result.textContent = 'Saved.';
          result.className = 'text-sm text-[var(--color-moss-dark)]';
          inquiry.status = body.status;
          inquiry.staffNote = body.staffNote;
        } catch (exception) {
          result.textContent = exception instanceof Error ? exception.message : 'We could not save this inquiry.';
          result.className = 'text-sm text-red-800';
        } finally {
          save.disabled = false;
          save.textContent = 'Save';
        }
      });
      row.append(save, result);
      controls.append(statusLabel, noteLabel, row);
      card.append(controls);
      list.append(card);
    }
  }

  async function load() {
    try {
      inquiries = (await request<AdminLostPetInquiryListResponse>('/admin/lost-pet-inquiries')).inquiries;
      render();
    } catch {
      list?.replaceChildren(textNode('p', 'text-sm text-red-800', 'We could not load lost-pet inquiries right now.'));
    }
  }

  purge?.addEventListener('click', async () => {
    if (!window.confirm('Permanently delete every expired lost-pet search, its photos, and its inquiries?')) return;
    purge.disabled = true;
    try {
      const { removed } = await request<{ removed: number }>('/admin/lost-pet/purge-expired', { method: 'POST' });
      if (purgeMessage) { purgeMessage.textContent = removed ? `Removed ${removed} expired search(es) with their photos and inquiries.` : 'Nothing has expired.'; purgeMessage.className = 'mt-3 text-sm text-[var(--color-moss-dark)]'; }
      await load();
    } catch (exception) {
      if (purgeMessage) { purgeMessage.textContent = exception instanceof Error ? exception.message : 'We could not delete expired data.'; purgeMessage.className = 'mt-3 text-sm text-red-800'; }
    } finally { purge.disabled = false; }
  });

  void load();
</script>
