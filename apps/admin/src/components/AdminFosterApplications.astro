<section class="mt-10 border-t border-stone-300 pt-8" aria-labelledby="foster-applications-title">
  <h2 id="foster-applications-title" class="text-lg font-semibold text-stone-950">Foster applications</h2>
  <p class="mt-2 max-w-2xl leading-6 text-stone-700">Review foster applications here. Changing an outcome does not change the pet’s status; mark a pet Fostered separately when a placement begins.</p>
  <div data-foster-list class="mt-5 grid gap-4" aria-live="polite">
    <p class="text-sm text-stone-700">Loading foster applications…</p>
  </div>
</section>

<script>
  import type { ApplicationReviewResponse, AdminFosterApplicationListResponse, AdoptionApplicationStatus, FosterApplication } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';

  const list = document.querySelector<HTMLElement>('[data-foster-list]');
  let applications: FosterApplication[] = [];

  function textNode(tag: string, className: string, content: string) {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  }

  async function request<T>(path: string, init?: RequestInit): Promise<T> {
    const response = await fetch(`${apiBase}${path}`, { credentials: 'include', ...init });
    const payload = await response.json().catch(() => null) as { message?: unknown } | T | null;
    if (!response.ok) throw new Error(typeof (payload as { message?: unknown } | null)?.message === 'string' ? (payload as { message: string }).message : 'The request could not be completed.');
    return payload as T;
  }

  function formatDate(value: string) {
    const date = new Date(value);
    return Number.isNaN(date.valueOf()) ? 'Unknown date' : date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function render() {
    if (!list) return;
    list.replaceChildren();
    if (!applications.length) {
      list.append(textNode('p', 'text-sm leading-6 text-stone-700', 'No foster applications yet.'));
      return;
    }
    for (const application of applications) {
      const card = document.createElement('article');
      card.className = 'border border-stone-300 bg-white p-5';
      card.append(
        textNode('h3', 'font-semibold text-stone-950', `${application.applicantName} · ${application.petName}`),
        textNode('p', 'mt-1 text-sm text-stone-700', `${application.applicantEmail} · Submitted ${formatDate(application.submittedAt)} · ${application.status}`),
        textNode('p', 'mt-2 text-sm leading-6 text-stone-700', `Phone: ${application.applicantPhone} · Address: ${application.applicantAddress} · Date of birth: ${application.applicantDateOfBirth}`),
        textNode('p', 'mt-2 text-sm font-medium leading-6 text-stone-900', `Can provide care: ${application.availableFrom} to ${application.availableUntil}`),
        textNode('p', 'mt-4 whitespace-pre-wrap leading-7 text-stone-800', application.householdSummary),
        textNode('p', 'mt-3 whitespace-pre-wrap leading-7 text-stone-800', `Foster experience: ${application.fosterExperience}`),
      );
      if (application.note) card.append(textNode('p', 'mt-3 whitespace-pre-wrap border-l-2 border-stone-300 pl-3 text-sm leading-6 text-stone-700', application.note));

      const controls = document.createElement('div');
      controls.className = 'mt-5 flex flex-wrap items-end gap-3';
      const label = textNode('label', 'text-sm font-medium text-stone-900', 'Application outcome');
      const select = document.createElement('select');
      select.className = 'mt-2 block border border-stone-400 bg-white px-3 py-2 text-stone-950';
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = application.status === 'Pending' ? 'Select outcome' : application.status;
      placeholder.disabled = true;
      placeholder.selected = application.status === 'Pending';
      select.append(placeholder);
      for (const status of ['In review', 'Approved', 'Declined'] as AdoptionApplicationStatus[]) {
        const option = document.createElement('option');
        option.value = status;
        option.textContent = status;
        option.selected = status === application.status;
        select.append(option);
      }
      label.append(select);
      const shortcut = textNode('label', 'flex items-center gap-2 text-sm text-stone-800', '');
      const markPet = document.createElement('input');
      markPet.type = 'checkbox';
      markPet.disabled = select.value !== 'Approved';
      select.addEventListener('change', () => { markPet.disabled = select.value !== 'Approved'; if (markPet.disabled) markPet.checked = false; });
      shortcut.append(markPet, `Also mark ${application.petName} Fostered`);
      const save = textNode('button', 'bg-[var(--color-moss)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70', 'Save outcome') as HTMLButtonElement;
      save.type = 'button';
      const result = textNode('p', 'text-sm', '');
      result.setAttribute('role', 'status');
      save.addEventListener('click', async () => {
        if (!select.value) { result.textContent = 'Choose an outcome first.'; result.className = 'text-sm text-red-800'; return; }
        save.disabled = true;
        save.textContent = 'Saving…';
        try {
          const saved = await request<ApplicationReviewResponse<FosterApplication>>(`/admin/foster-applications/${encodeURIComponent(application.id)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: select.value, ...(markPet.checked && { markPetStatus: 'Fostered' }) }),
          });
          applications = applications.map((item) => item.id === saved.id ? saved : item);
          render();
          if (saved.petStatusUpdate === 'applied') window.dispatchEvent(new CustomEvent('pawheaven:pets-changed'));
        } catch (exception) {
          result.textContent = exception instanceof Error ? exception.message : 'We could not save the foster application outcome.';
          result.className = 'text-sm text-red-800';
          save.disabled = false;
          save.textContent = 'Save outcome';
        }
      });
      controls.append(label, shortcut, save, result);
      card.append(controls);
      list.append(card);
    }
  }

  async function load() {
    try {
      applications = (await request<AdminFosterApplicationListResponse>('/admin/foster-applications')).applications;
      render();
    } catch {
      list?.replaceChildren(textNode('p', 'text-sm text-red-800', 'We could not load foster applications right now.'));
    }
  }

  void load();
</script>
