<section aria-labelledby="schedule-title">
  <h2 id="schedule-title" class="text-xl font-semibold tracking-tight text-stone-950">Schedule</h2>
  <p class="mt-2 max-w-2xl leading-6 text-stone-700">Visit times, volunteer shifts, and open houses on one calendar. Drag across empty space to add something, or click an item to manage it. Times are America/New_York.</p>

  <div class="mt-5 flex flex-wrap items-center gap-2" data-sched-toolbar>
    <button type="button" class="ph-btn" data-sched-prev aria-label="Previous week">←</button>
    <button type="button" class="ph-btn" data-sched-today>This week</button>
    <button type="button" class="ph-btn" data-sched-next aria-label="Next week">→</button>
    <strong class="px-2 text-stone-950" data-sched-label aria-live="polite"></strong>
    <span class="grow"></span>
    <button type="button" class="ph-btn ph-btn-primary" data-sched-add>Add…</button>
    <button type="button" class="ph-btn" data-sched-copy>Copy this week to the next</button>
    <button type="button" class="ph-btn" data-sched-generate>Fill in from open hours</button>
  </div>
  <p data-sched-message class="mt-3 hidden text-sm" role="status"></p>

  <div class="mt-4 overflow-x-auto border border-stone-300 bg-white" data-sched-grid-wrap>
    <div data-sched-grid class="grid min-w-[44rem]" style="grid-template-columns: 3.5rem repeat(7, minmax(0, 1fr));"></div>
  </div>
  <p class="mt-2 text-xs text-stone-600">Legend: <span class="ph-pill ph-pill-good">Visit times</span> <span class="ph-pill ph-pill-warn">Volunteer shifts</span> <span class="ph-pill">Open house</span></p>

  <div class="mt-10 grid items-start gap-6 xl:grid-cols-2">
    <section class="ph-card" aria-labelledby="hours-title">
      <h3 id="hours-title" class="text-base font-semibold text-stone-950">Open hours</h3>
      <p class="mt-1 text-sm leading-6 text-stone-700">Weekly patterns keep the next weeks filled in automatically. Edits you make to a generated item are kept.</p>
      <div data-sched-rules class="mt-3 grid gap-2"></div>
      <h4 class="mt-5 text-sm font-semibold text-stone-950">Days closed</h4>
      <div data-sched-exceptions class="mt-2 grid gap-2"></div>
      <form data-sched-exception-form class="mt-3 flex flex-wrap items-end gap-2">
        <label class="ph-field">Date<input class="ph-input" type="date" name="date" required /></label>
        <label class="ph-field">Reason<input class="ph-input" name="reason" maxlength="200" placeholder="Holiday, training day…" /></label>
        <button class="ph-btn" type="submit">Close this day</button>
      </form>
    </section>
    <section class="ph-card" aria-labelledby="events-title">
      <h3 id="events-title" class="text-base font-semibold text-stone-950">Open houses and events</h3>
      <p class="mt-1 text-sm leading-6 text-stone-700">One event creates its visit capacity, volunteer roles, and featured pets together. Use <strong>Add… → Open house</strong>.</p>
      <div data-sched-events class="mt-3 grid gap-2"></div>
    </section>
  </div>

  <dialog data-sched-dialog class="m-auto w-[min(36rem,calc(100vw-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto border border-stone-400 bg-white p-0 text-stone-900 shadow-md backdrop:bg-[color-mix(in_oklab,var(--ph-ink-strong)_55%,transparent)]" aria-labelledby="sched-dialog-title">
    <div class="flex items-center justify-between border-b border-stone-300 px-5 py-4">
      <h3 id="sched-dialog-title" class="text-lg font-semibold text-stone-950" data-sched-dialog-title></h3>
      <button type="button" class="ph-btn" data-sched-dialog-close>Close</button>
    </div>
    <div class="px-5 py-5" data-sched-dialog-body></div>
  </dialog>
</section>

<script>
  import type {
    AdminPetListResponse, AdminVisitAppointment, AdminVisitScheduleResponse, AdminVisitSlot, AdminVolunteerShift, AdminVolunteerShiftListResponse,
    AvailabilityResponse, AvailabilityRule, GenerateAvailabilityResponse, ShelterEvent,
  } from '@pawheaven/contracts';
  import { ApiRequestError, apiRequest, el, pill } from '@pawheaven/contracts/ui';
  import { apiBase } from '../lib/api';
  import { newYorkInstant } from '../lib/shelter-time';

  const FIRST_HOUR = 7;
  const LAST_HOUR = 21;
  const ROW = 22; // pixels per 30 minutes
  const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const root = document.querySelector<HTMLElement>('[aria-labelledby="schedule-title"]');
  const grid = root?.querySelector<HTMLElement>('[data-sched-grid]');
  const label = root?.querySelector<HTMLElement>('[data-sched-label]');
  const message = root?.querySelector<HTMLElement>('[data-sched-message]');
  const dialog = root?.querySelector<HTMLDialogElement>('[data-sched-dialog]');
  const dialogBody = root?.querySelector<HTMLElement>('[data-sched-dialog-body]');
  const dialogTitle = root?.querySelector<HTMLElement>('[data-sched-dialog-title]');

  let slots: AdminVisitSlot[] = [];
  let shifts: AdminVolunteerShift[] = [];
  let events: ShelterEvent[] = [];
  let rules: AvailabilityRule[] = [];
  let exceptions: { date: string; reason: string }[] = [];
  let pets: { id: string; name: string; status: string }[] = [];
  let weekStart = '';

  // --- Civil dates in the shelter's time zone ------------------------------------------------
  const fmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  function etParts(iso: string) {
    const get = (type: string, parts = fmt.formatToParts(new Date(iso))) => Number(parts.find((part) => part.type === type)?.value);
    const parts = fmt.formatToParts(new Date(iso));
    const pad = (n: number) => String(n).padStart(2, '0');
    return { date: `${get('year', parts)}-${pad(get('month', parts))}-${pad(get('day', parts))}`, minutes: get('hour', parts) * 60 + get('minute', parts) };
  }
  const addDays = (date: string, days: number) => new Date(Date.parse(`${date}T00:00:00Z`) + days * 86_400_000).toISOString().slice(0, 10);
  const sundayOf = (date: string) => addDays(date, -new Date(`${date}T00:00:00Z`).getUTCDay());
  const todayEt = () => etParts(new Date().toISOString()).date;
  const clock = (minutes: number) => `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
  const niceTime = (minutes: number) => { const h = Math.floor(minutes / 60); return `${h % 12 || 12}:${String(minutes % 60).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`; };
  const niceDay = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString(undefined, { timeZone: 'UTC', weekday: 'short', month: 'short', day: 'numeric' });

  function say(text: string, error = false) {
    if (!message) return;
    message.textContent = text;
    message.className = `mt-3 text-sm ${error ? 'text-red-800' : 'text-green-900'}`;
  }
  const messageOf = (error: unknown) => (error instanceof Error ? error.message : 'The request could not be completed.');

  async function load() {
    try {
      const [visitResult, shiftResult, eventResult, availability, petResult] = await Promise.all([
        apiRequest<AdminVisitScheduleResponse>(apiBase, '/admin/visit-slots'),
        apiRequest<AdminVolunteerShiftListResponse>(apiBase, '/admin/volunteer-shifts'),
        apiRequest<{ events: ShelterEvent[] }>(apiBase, '/admin/events'),
        apiRequest<AvailabilityResponse>(apiBase, '/admin/availability'),
        apiRequest<AdminPetListResponse>(apiBase, '/admin/pets'),
      ]);
      slots = visitResult.slots.filter((slot) => slot.status === 'published');
      shifts = shiftResult.shifts.filter((shift) => shift.status === 'published');
      events = eventResult.events;
      rules = availability.rules;
      exceptions = availability.exceptions;
      pets = petResult.pets.map((pet) => ({ id: pet.id, name: pet.name, status: pet.status }));
      draw();
    } catch (error) {
      say(messageOf(error), true);
    }
  }

  // --- The week grid -----------------------------------------------------------------------------
  type Block = { kind: 'visit' | 'shift'; start: number; end: number; title: string; sub: string; event: boolean; open: () => void };

  function blocksFor(date: string): Block[] {
    const blocks: Block[] = [];
    for (const slot of slots) {
      const s = etParts(slot.startsAt);
      if (s.date !== date) continue;
      const e = etParts(slot.endsAt);
      blocks.push({ kind: 'visit', start: s.minutes, end: e.date === date ? e.minutes : 24 * 60, title: 'Visits', sub: `${slot.appointments.length}/${slot.capacity} booked`, event: Boolean(slot.eventId), open: () => showSlot(slot) });
    }
    for (const shift of shifts) {
      const s = etParts(shift.startsAt);
      if (s.date !== date) continue;
      const e = etParts(shift.endsAt);
      blocks.push({ kind: 'shift', start: s.minutes, end: e.date === date ? e.minutes : 24 * 60, title: shift.title, sub: `${shift.participants.length}/${shift.capacity} signed up`, event: false, open: () => showShift(shift) });
    }
    return blocks;
  }

  function draw() {
    if (!grid) return;
    if (!weekStart) weekStart = sundayOf(todayEt());
    if (label) label.textContent = `${niceDay(weekStart)} – ${niceDay(addDays(weekStart, 6))}`;
    grid.replaceChildren();
    const height = (LAST_HOUR - FIRST_HOUR) * 2 * ROW;

    grid.append(el('div', 'border-b border-stone-200 bg-stone-50'));
    for (let day = 0; day < 7; day += 1) {
      const date = addDays(weekStart, day);
      const head = el('div', `border-b border-l border-stone-200 bg-stone-50 px-1 py-2 text-center text-xs font-semibold ${date === todayEt() ? 'text-[var(--color-moss-dark)]' : 'text-stone-800'}`, `${DAYS[day]} ${new Date(`${date}T00:00:00Z`).getUTCDate()}`);
      if (exceptions.some((exception) => exception.date === date)) head.append(el('span', 'block font-normal text-red-800', 'Closed'));
      grid.append(head);
    }

    const axis = el('div', 'relative');
    axis.style.height = `${height}px`;
    for (let hour = FIRST_HOUR; hour < LAST_HOUR; hour += 1) {
      const tick = el('span', 'absolute right-1 text-[0.65rem] text-stone-600', niceTime(hour * 60).replace(':00 ', ' '));
      tick.style.top = `${(hour - FIRST_HOUR) * 2 * ROW - 6}px`;
      axis.append(tick);
    }
    grid.append(axis);

    for (let day = 0; day < 7; day += 1) {
      const date = addDays(weekStart, day);
      const column = el('div', 'relative cursor-crosshair touch-none border-l border-stone-200 select-none');
      column.style.height = `${height}px`;
      column.style.backgroundImage = `repeating-linear-gradient(to bottom, transparent 0, transparent ${ROW * 2 - 1}px, var(--ph-divider) ${ROW * 2 - 1}px, var(--ph-divider) ${ROW * 2}px)`;
      column.dataset.date = date;
      const band = el('div', 'pointer-events-none absolute inset-x-0 hidden bg-[var(--ph-brand-soft)] opacity-80');
      column.append(band);
      attachDrag(column, band, date);
      for (const block of blocksFor(date)) {
        const top = Math.max(0, ((block.start - FIRST_HOUR * 60) / 30) * ROW);
        const bottom = Math.min(height, ((block.end - FIRST_HOUR * 60) / 30) * ROW);
        if (bottom <= 0 || top >= height) continue;
        const node = el('button', `absolute overflow-hidden border px-1 text-left text-[0.7rem] leading-tight ${block.kind === 'visit' ? 'border-green-300 bg-green-50 text-green-900' : 'border-amber-700 bg-amber-50 text-amber-900'} ${block.event ? 'outline outline-2 outline-[var(--ph-accent)]' : ''}`);
        node.type = 'button';
        node.style.top = `${top}px`;
        node.style.height = `${Math.max(bottom - top - 1, 14)}px`;
        node.style.left = block.kind === 'visit' ? '2px' : '50%';
        node.style.width = 'calc(50% - 3px)';
        node.append(el('strong', 'block truncate', block.title), el('span', 'block truncate', block.sub));
        node.title = `${block.title}, ${niceTime(block.start)}–${niceTime(block.end)}, ${block.sub}`;
        node.addEventListener('pointerdown', (event) => event.stopPropagation());
        node.addEventListener('click', block.open);
        column.append(node);
      }
      grid.append(column);
    }
    drawRules();
    drawEvents();
  }

  function attachDrag(column: HTMLElement, band: HTMLElement, date: string) {
    let anchor: number | null = null;
    const rowAt = (event: PointerEvent) => Math.max(0, Math.min((LAST_HOUR - FIRST_HOUR) * 2 - 1, Math.floor((event.clientY - column.getBoundingClientRect().top) / ROW)));
    const paint = (from: number, to: number) => {
      const [a, b] = from <= to ? [from, to] : [to, from];
      band.style.top = `${a * ROW}px`;
      band.style.height = `${(b - a + 1) * ROW}px`;
      band.classList.remove('hidden');
    };
    column.addEventListener('pointerdown', (event) => { anchor = rowAt(event); column.setPointerCapture(event.pointerId); paint(anchor, anchor); });
    column.addEventListener('pointermove', (event) => { if (anchor !== null) paint(anchor, rowAt(event)); });
    column.addEventListener('pointerup', (event) => {
      if (anchor === null) return;
      const from = Math.min(anchor, rowAt(event));
      const to = Math.max(anchor, rowAt(event));
      anchor = null;
      band.classList.add('hidden');
      const start = FIRST_HOUR * 60 + from * 30;
      showCreate({ date, start: clock(start), end: clock(start + (to - from + 1) * 30) });
    });
    column.addEventListener('pointercancel', () => { anchor = null; band.classList.add('hidden'); });
  }

  // --- Dialog helpers ----------------------------------------------------------------------------
  function open(title: string, ...content: HTMLElement[]) {
    if (!dialog || !dialogBody || !dialogTitle) return;
    dialogTitle.textContent = title;
    dialogBody.replaceChildren(...content);
    if (!dialog.open) dialog.showModal();
  }
  const closeDialog = () => dialog?.close();
  root?.querySelector('[data-sched-dialog-close]')?.addEventListener('click', closeDialog);
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });

  function field(text: string, control: HTMLElement) {
    const wrap = el('label', 'ph-field');
    wrap.append(text, control);
    return wrap;
  }
  function input(attrs: Record<string, string>, value = '') {
    const node = el('input', 'ph-input');
    for (const [key, val] of Object.entries(attrs)) node.setAttribute(key, val);
    node.value = value;
    node.setAttribute('value', value);
    return node;
  }
  function button(text: string, onClick: () => void, primary = false) {
    const node = el('button', `ph-btn${primary ? ' ph-btn-primary' : ''}`, text);
    node.type = 'button';
    node.addEventListener('click', onClick);
    return node;
  }

  // --- Create (drag or Add…) ---------------------------------------------------------------------
  function showCreate(initial?: { date: string; start: string; end: string }) {
    const date = initial?.date ?? todayEt();
    const kind = el('select', 'ph-input');
    for (const [value, text] of [['visit', 'Visit times'], ['shift', 'Volunteer shift'], ['event', 'Open house / event']]) kind.append(Object.assign(el('option', '', text), { value }));
    const dateInput = input({ type: 'date', required: '' }, date);
    const start = input({ type: 'time', required: '' }, initial?.start ?? '10:00');
    const end = input({ type: 'time', required: '' }, initial?.end ?? '12:00');
    const capacity = input({ type: 'number', min: '1', max: '500' }, '2');
    const slotMinutes = input({ type: 'number', min: '15', max: '240', step: '15' }, '30');
    const title = input({ maxlength: '100' });
    const duties = el('textarea', 'ph-input'); duties.rows = 3; duties.maxLength = 2000;
    const minAge = input({ type: 'number', min: '0', max: '99' }, '16');
    const repeat = el('input', 'mr-2'); repeat.type = 'checkbox';
    const roles = el('textarea', 'ph-input'); roles.rows = 3; roles.placeholder = 'Greeters x 3\nDog handlers x 4';
    const petBox = el('div', 'max-h-32 overflow-y-auto border border-stone-300 p-2 text-sm');
    for (const pet of pets.filter((item) => item.status === 'Available')) {
      const row = el('label', 'mr-3 inline-flex items-center gap-1'); const box = el('input'); box.type = 'checkbox'; box.value = pet.id; row.append(box, pet.name); petBox.append(row);
    }
    const errorLine = el('p', 'mt-3 hidden text-sm text-red-800'); errorLine.setAttribute('role', 'alert');

    const parts = {
      visit: [field('How many slots at once (groups)', capacity), field('Slot length (minutes)', slotMinutes)],
      shift: [field('Title', title), field('Duties', duties), field('How many volunteers', capacity.cloneNode(true) as HTMLElement), field('Minimum age', minAge)],
      event: [field('Event name', title.cloneNode(true) as HTMLElement), field('Description', duties.cloneNode(true) as HTMLElement), field('Visit groups per slot (0 for none)', capacity.cloneNode(true) as HTMLElement), field('Visit slot length (minutes)', slotMinutes.cloneNode(true) as HTMLElement), field('Volunteer roles, one per line as "Title x count"', roles), (() => { const wrap = el('div', 'ph-field'); wrap.append('Featured animals', petBox); return wrap; })()],
    };
    const dynamic = el('div', 'grid gap-4');
    const repeatRow = el('label', 'flex items-center text-sm'); repeatRow.append(repeat, 'Repeat every week (adds open hours)');
    const form = el('form', 'grid gap-4');
    const render = () => {
      dynamic.replaceChildren(...parts[kind.value as keyof typeof parts]);
      repeatRow.hidden = kind.value === 'event';
    };
    kind.addEventListener('change', render);
    render();
    const submit = el('button', 'ph-btn ph-btn-primary', 'Create'); submit.type = 'submit';
    form.append(field('What are you adding?', kind), el('div', 'grid grid-cols-3 gap-3'), dynamic, repeatRow, submit, errorLine);
    form.children[1].append(field('Day', dateInput), field('From', start), field('To', end));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorLine.classList.add('hidden');
      const startsAt = newYorkInstant(`${dateInput.value}T${start.value}`);
      const endsAt = newYorkInstant(`${dateInput.value}T${end.value}`);
      if (!startsAt || !endsAt || end.value <= start.value) { errorLine.textContent = 'Choose a valid day and an end time after the start.'; errorLine.classList.remove('hidden'); return; }
      const numbers = [...dynamic.querySelectorAll<HTMLInputElement>('input[type="number"]')].map((node) => Number(node.value));
      const text = [...dynamic.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type="number"]):not([type="checkbox"]), textarea')].map((node) => node.value.trim());
      submit.disabled = true;
      try {
        const weekday = new Date(`${dateInput.value}T00:00:00Z`).getUTCDay();
        if (kind.value === 'visit') {
          const [cap, minutes] = numbers;
          if (repeat.checked) {
            await apiRequest(apiBase, '/admin/availability/rules', { method: 'POST', json: { kind: 'visit', weekday, startTime: start.value, endTime: end.value, capacity: cap, slotMinutes: minutes, weeksAhead: 6 } });
            await apiRequest(apiBase, '/admin/availability/generate', { method: 'POST' });
          } else {
            const startMs = Date.parse(startsAt);
            for (let t = startMs; t + minutes * 60_000 <= Date.parse(endsAt); t += minutes * 60_000) {
              await apiRequest(apiBase, '/admin/visit-slots', { method: 'POST', json: { startsAt: new Date(t).toISOString(), endsAt: new Date(t + minutes * 60_000).toISOString(), capacity: cap } });
            }
          }
        } else if (kind.value === 'shift') {
          const [cap, age] = numbers;
          const [name, duty] = text;
          if (repeat.checked) {
            await apiRequest(apiBase, '/admin/availability/rules', { method: 'POST', json: { kind: 'shift', weekday, startTime: start.value, endTime: end.value, capacity: cap, title: name, description: duty, minAge: age, weeksAhead: 6 } });
            await apiRequest(apiBase, '/admin/availability/generate', { method: 'POST' });
          } else {
            await apiRequest(apiBase, '/admin/volunteer-shifts', { method: 'POST', json: { title: name, description: duty, requirements: '', minAge: age, startsAt, endsAt, capacity: cap } });
          }
        } else {
          const [cap, minutes] = numbers;
          const [name, description, roleText] = text;
          const roleList = roleText.split('\n').map((lineText) => lineText.trim()).filter(Boolean).map((lineText) => {
            const match = lineText.match(/^(.*?)\s*[x×]\s*(\d+)$/i);
            return { title: (match ? match[1] : lineText).trim(), capacity: match ? Number(match[2]) : 2 };
          });
          const petIds = [...petBox.querySelectorAll<HTMLInputElement>('input:checked')].map((node) => node.value);
          await apiRequest(apiBase, '/admin/events', { method: 'POST', json: { title: name, description, startsAt, endsAt, visitCapacity: cap, slotMinutes: minutes, roles: roleList, petIds } });
        }
        closeDialog();
        say('Added to the schedule.');
        await load();
      } catch (error) {
        errorLine.textContent = error instanceof ApiRequestError && error.fieldErrors ? Object.values(error.fieldErrors).join(' ') : messageOf(error);
        errorLine.classList.remove('hidden');
      } finally { submit.disabled = false; }
    });
    open('Add to the schedule', form);
  }

  // --- Details -----------------------------------------------------------------------------------
  function showSlot(slot: AdminVisitSlot) {
    const body = el('div', 'grid gap-4');
    const when = `${niceDay(etParts(slot.startsAt).date)} · ${niceTime(etParts(slot.startsAt).minutes)} – ${niceTime(etParts(slot.endsAt).minutes)}`;
    body.append(el('p', 'text-sm text-stone-700', `${when}. Holds ${slot.capacity} group${slot.capacity === 1 ? '' : 's'}; ${slot.appointments.length} booked.`));
    if (slot.eventId) body.append(pill('Part of an event', 'neutral'));
    if (slot.ruleId) body.append(pill('Generated from open hours', 'later'));
    if (!slot.appointments.length) body.append(el('p', 'text-sm text-stone-700', 'Nobody has booked this time yet.'));
    for (const appointment of slot.appointments) body.append(appointmentCard(appointment));
    const cap = input({ type: 'number', min: String(Math.max(1, slot.appointments.length)), max: '50' }, String(slot.capacity));
    const actions = el('div', 'flex flex-wrap items-end gap-3');
    actions.append(field('Capacity (groups)', cap), button('Save capacity', async () => {
      try { await apiRequest(apiBase, `/admin/visit-slots/${slot.id}/capacity`, { method: 'PUT', json: { capacity: Number(cap.value) } }); closeDialog(); say('Capacity updated.'); await load(); } catch (error) { say(messageOf(error), true); }
    }));
    if (!slot.appointments.length) actions.append(button('Withdraw this time', async () => {
      try { await apiRequest(apiBase, `/admin/visit-slots/${slot.id}/withdraw`, { method: 'POST' }); closeDialog(); say('Visit time withdrawn.'); await load(); } catch (error) { say(messageOf(error), true); }
    }));
    body.append(actions);
    open('Visit time', body);
  }

  function appointmentCard(appointment: AdminVisitAppointment) {
    const card = el('div', 'border border-stone-300 p-3 text-sm');
    card.append(el('strong', 'block text-stone-950', `${appointment.memberName} · party of ${appointment.partySize}`), el('span', 'block text-stone-700', appointment.memberEmail));
    if (appointment.pets.length) card.append(el('span', 'mt-1 block text-stone-900', `Meeting: ${appointment.pets.map((pet) => pet.name).join(', ')}`));
    card.append(el('span', 'mt-1 block text-stone-700', appointment.purpose));
    return card;
  }

  function showShift(shift: AdminVolunteerShift) {
    const body = el('div', 'grid gap-3');
    body.append(el('p', 'text-sm text-stone-700', `${niceDay(etParts(shift.startsAt).date)} · ${niceTime(etParts(shift.startsAt).minutes)} – ${niceTime(etParts(shift.endsAt).minutes)}. ${shift.participants.length} of ${shift.capacity} signed up. Minimum age ${shift.minAge}.`), el('p', 'text-sm leading-6 text-stone-800', shift.description));
    if (!shift.participants.length) body.append(el('p', 'text-sm text-stone-700', 'Nobody has signed up yet.'));
    for (const person of shift.participants) body.append(el('p', 'border border-stone-300 p-2 text-sm', `${person.memberName} · ${person.memberEmail} · ${person.memberPhone}`));
    body.append(el('p', 'text-xs text-stone-600', 'To edit duties, times, or to cancel this shift, use Visit and shift lists in the menu.'));
    open(shift.title, body);
  }

  // --- Open hours and events ---------------------------------------------------------------------
  function drawRules() {
    const box = root?.querySelector<HTMLElement>('[data-sched-rules]');
    if (!box) return;
    box.replaceChildren();
    if (!rules.length) box.append(el('p', 'text-sm text-stone-700', 'No weekly patterns yet. Tick "Repeat every week" when you add visit times or a shift.'));
    for (const rule of rules) {
      const row = el('div', 'flex flex-wrap items-center justify-between gap-2 border border-stone-300 p-2 text-sm');
      const what = rule.kind === 'visit' ? `Visits, ${rule.capacity} group${rule.capacity === 1 ? '' : 's'} per ${rule.slotMinutes}-minute slot` : `${rule.title}, ${rule.capacity} volunteer${rule.capacity === 1 ? '' : 's'}`;
      row.append(el('span', rule.active ? '' : 'text-stone-500', `${DAYS[rule.weekday]} ${rule.startTime}–${rule.endTime} · ${what}`));
      const actions = el('span', 'flex gap-2');
      actions.append(
        button(rule.active ? 'Pause' : 'Resume', async () => { try { await apiRequest(apiBase, `/admin/availability/rules/${rule.id}`, { method: 'PUT', json: { ...rule, active: !rule.active } }); await load(); } catch (error) { say(messageOf(error), true); } }),
        button('Delete', async () => { try { await apiRequest(apiBase, `/admin/availability/rules/${rule.id}`, { method: 'DELETE' }); say('Pattern deleted. Times already created stay on the calendar.'); await load(); } catch (error) { say(messageOf(error), true); } }),
      );
      row.append(actions);
      box.append(row);
    }
    const list = root?.querySelector<HTMLElement>('[data-sched-exceptions]');
    list?.replaceChildren();
    if (!exceptions.length) list?.append(el('p', 'text-sm text-stone-700', 'No closed days coming up.'));
    for (const exception of exceptions) {
      const row = el('div', 'flex items-center justify-between gap-2 border border-stone-300 p-2 text-sm');
      row.append(el('span', '', `${niceDay(exception.date)}${exception.reason ? ` · ${exception.reason}` : ''}`), button('Reopen', async () => { try { await apiRequest(apiBase, `/admin/availability/exceptions/${exception.date}`, { method: 'DELETE' }); say('Day reopened. Use "Fill in from open hours" to bring its times back.'); await load(); } catch (error) { say(messageOf(error), true); } }));
      list?.append(row);
    }
  }

  function drawEvents() {
    const box = root?.querySelector<HTMLElement>('[data-sched-events]');
    if (!box) return;
    box.replaceChildren();
    const upcoming = events.filter((item) => Date.parse(item.endsAt) > Date.now());
    if (!upcoming.length) box.append(el('p', 'text-sm text-stone-700', 'No events coming up.'));
    for (const item of upcoming) {
      const row = el('div', 'border border-stone-300 p-2 text-sm');
      row.append(el('strong', 'block text-stone-950', item.title), el('span', 'block text-stone-700', `${niceDay(etParts(item.startsAt).date)} · ${niceTime(etParts(item.startsAt).minutes)} – ${niceTime(etParts(item.endsAt).minutes)}`));
      if (item.pets.length) row.append(el('span', 'block text-stone-700', `Featuring ${item.pets.map((pet) => pet.name).join(', ')}`));
      box.append(row);
    }
  }

  // --- Toolbar -----------------------------------------------------------------------------------
  root?.querySelector('[data-sched-prev]')?.addEventListener('click', () => { weekStart = addDays(weekStart, -7); draw(); });
  root?.querySelector('[data-sched-next]')?.addEventListener('click', () => { weekStart = addDays(weekStart, 7); draw(); });
  root?.querySelector('[data-sched-today]')?.addEventListener('click', () => { weekStart = sundayOf(todayEt()); draw(); });
  root?.querySelector('[data-sched-add]')?.addEventListener('click', () => showCreate());
  root?.querySelector('[data-sched-copy]')?.addEventListener('click', async () => {
    try {
      const result = await apiRequest<GenerateAvailabilityResponse>(apiBase, '/admin/schedule/copy-week', { method: 'POST', json: { fromWeek: weekStart, toWeek: addDays(weekStart, 7) } });
      say(`Copied: ${result.visitsCreated} visit time${result.visitsCreated === 1 ? '' : 's'} and ${result.shiftsCreated} shift${result.shiftsCreated === 1 ? '' : 's'} added to next week.`);
      weekStart = addDays(weekStart, 7);
      await load();
    } catch (error) { say(messageOf(error), true); }
  });
  root?.querySelector('[data-sched-generate]')?.addEventListener('click', async () => {
    try {
      const result = await apiRequest<GenerateAvailabilityResponse>(apiBase, '/admin/availability/generate', { method: 'POST' });
      say(`Open hours filled in: ${result.visitsCreated} visit time${result.visitsCreated === 1 ? '' : 's'} and ${result.shiftsCreated} shift${result.shiftsCreated === 1 ? '' : 's'} added.`);
      await load();
    } catch (error) { say(messageOf(error), true); }
  });
  root?.querySelector<HTMLFormElement>('[data-sched-exception-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formEl = event.currentTarget as HTMLFormElement;
    const data = new FormData(formEl);
    try {
      const result = await apiRequest<{ visitsRemoved: number; shiftsRemoved: number; kept: number }>(apiBase, '/admin/availability/exceptions', { method: 'POST', json: { date: data.get('date'), reason: data.get('reason') } });
      say(`Day closed. Removed ${result.visitsRemoved} unused visit time${result.visitsRemoved === 1 ? '' : 's'} and ${result.shiftsRemoved} empty shift${result.shiftsRemoved === 1 ? '' : 's'}${result.kept ? `; ${result.kept} with bookings were kept` : ''}.`);
      formEl.reset();
      await load();
    } catch (error) { say(messageOf(error), true); }
  });

  // The dashboard shows this view only after staff access is confirmed, so wait until it is visible.
  const view = root?.closest<HTMLElement>('[data-view]');
  let loaded = false;
  const start = () => { if (view && !view.hidden && !loaded) { loaded = true; void load(); } };
  if (view) new MutationObserver(start).observe(view, { attributes: true, attributeFilter: ['hidden'] });
  window.addEventListener('pawheaven:schedule-changed', () => { if (loaded) void load(); });
  start();
</script>
