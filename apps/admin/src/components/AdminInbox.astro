<section aria-labelledby="inbox-title">
  <h2 id="inbox-title" class="text-xl font-semibold tracking-tight text-stone-950">Inbox</h2>
  <p class="mt-2 max-w-2xl leading-6 text-stone-700">Everything waiting on staff, oldest first: new applications, lost-pet inquiries, and upcoming shifts nobody has signed up for.</p>
  <div class="mt-6 grid items-start gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    <div class="ph-card" aria-live="polite">
      <div data-inbox-filters class="flex flex-wrap gap-2"></div>
      <div data-inbox-list class="mt-3"><p class="text-sm text-stone-700">Loading the inbox…</p></div>
    </div>
    <div class="flex min-w-0 flex-col gap-5">
      <section class="ph-card" aria-labelledby="today-title" data-inbox-today><h3 id="today-title" class="text-base font-semibold text-stone-950">Today</h3></section>
      <section class="ph-card" aria-labelledby="money-title" data-inbox-money><h3 id="money-title" class="text-base font-semibold text-stone-950">Donations</h3></section>
      <section class="ph-card" aria-labelledby="glance-title" data-inbox-glance><h3 id="glance-title" class="text-base font-semibold text-stone-950">Shelter at a glance</h3></section>
    </div>
  </div>
</section>

<script>
  import type { AdminAdoptionApplicationListResponse, AdminDonationsResponse, AdminFosterApplicationListResponse, AdminLostPetInquiryListResponse, AdminPetListResponse, AdminVisitScheduleResponse, AdminVolunteerShiftListResponse } from '@pawheaven/contracts';
  import { SHELTER_TIME_ZONE, apiRequest, el, formatShelterRange, pill } from '@pawheaven/contracts/ui';
  import { apiBase } from '../lib/api';

  type Item = { kind: 'Adoption' | 'Foster' | 'Lost pet' | 'Shift'; group: 'applications' | 'lost-pets' | 'visits'; title: string; detail: string; when: string; age: string; view: string };
  type Loaded<T> = { ok: true; value: T } | { ok: false };
  const settle = async <T,>(path: string): Promise<Loaded<T>> => apiRequest<T>(apiBase, path).then((value) => ({ ok: true as const, value }), () => ({ ok: false as const }));

  const listEl = document.querySelector<HTMLElement>('[data-inbox-list]');
  const filtersEl = document.querySelector<HTMLElement>('[data-inbox-filters]');
  const todayEl = document.querySelector<HTMLElement>('[data-inbox-today]');
  const moneyEl = document.querySelector<HTMLElement>('[data-inbox-money]');
  const glanceEl = document.querySelector<HTMLElement>('[data-inbox-glance]');
  let items: Item[] = [];
  let filter: 'all' | Item['group'] = 'all';

  const setCount = (name: string, value: number) => {
    for (const badge of document.querySelectorAll<HTMLElement>(`[data-count="${name}"]`)) { badge.textContent = String(value); badge.hidden = value === 0; }
  };
  const age = (when: string) => { const days = Math.floor((Date.now() - Date.parse(when)) / 86_400_000); return days <= 0 ? 'today' : days === 1 ? '1 day' : `${days} days`; };
  const shelterDay = (value: string | number | Date) => new Intl.DateTimeFormat('en-CA', { timeZone: SHELTER_TIME_ZONE }).format(new Date(value));
  const line = (label: string, value: string) => { const row = el('div', 'mt-3 flex items-baseline justify-between gap-3 border-t border-stone-200 pt-3 text-sm'); row.append(el('span', 'text-stone-600', label), el('span', 'text-right font-medium text-stone-950', value)); return row; };

  function renderList() {
    if (!listEl || !filtersEl) return;
    const counts = { all: items.length, applications: items.filter((item) => item.group === 'applications').length, 'lost-pets': items.filter((item) => item.group === 'lost-pets').length, visits: items.filter((item) => item.group === 'visits').length };
    filtersEl.replaceChildren();
    for (const [key, label] of [['all', 'All'], ['applications', 'Applications'], ['lost-pets', 'Lost pet'], ['visits', 'Shifts']] as const) {
      const chip = el('button', `ph-pill ph-pill-${filter === key ? 'good' : 'neutral'} cursor-pointer`, `${label} ${counts[key]}`);
      chip.type = 'button';
      chip.setAttribute('aria-pressed', String(filter === key));
      chip.addEventListener('click', () => { filter = key; renderList(); });
      filtersEl.append(chip);
    }
    listEl.replaceChildren();
    const shown = items.filter((item) => filter === 'all' || item.group === filter);
    if (!shown.length) { listEl.append(el('p', 'text-sm leading-6 text-stone-700', 'Nothing is waiting on staff. New applications and inquiries will show up here.')); return; }
    for (const item of shown) {
      const row = el('div', 'grid items-center gap-3 border-t border-stone-200 py-3 sm:grid-cols-[6rem_minmax(0,1fr)_5rem_6rem]');
      const text = el('div', 'min-w-0');
      text.append(el('p', 'text-sm font-semibold text-stone-950', item.title), el('p', 'mt-1 text-sm text-stone-600', item.detail));
      const open = Object.assign(el('a', 'ph-btn ph-btn-primary text-center', 'Review'), { href: `#${item.view}` });
      row.append(pill(item.kind, item.kind === 'Lost pet' ? 'warn' : 'neutral'), text, el('span', 'text-sm text-amber-900', item.age), open);
      listEl.append(row);
    }
  }

  async function load() {
    const [adoption, foster, lost, shifts, visits, donations, pets] = await Promise.all([
      settle<AdminAdoptionApplicationListResponse>('/admin/applications'),
      settle<AdminFosterApplicationListResponse>('/admin/foster-applications'),
      settle<AdminLostPetInquiryListResponse>('/admin/lost-pet-inquiries'),
      settle<AdminVolunteerShiftListResponse>('/admin/volunteer-shifts'),
      settle<AdminVisitScheduleResponse>('/admin/visit-slots'),
      settle<AdminDonationsResponse>('/admin/donations'),
      settle<AdminPetListResponse>('/admin/pets'),
    ]);

    items = [];
    if (adoption.ok) for (const item of adoption.value.applications) if (item.status === 'Pending') items.push({ kind: 'Adoption', group: 'applications', title: `${item.applicantName} wants to adopt ${item.petName}`, detail: item.applicantEmail, when: item.submittedAt, age: age(item.submittedAt), view: 'applications' });
    if (foster.ok) for (const item of foster.value.applications) if (item.status === 'Pending') items.push({ kind: 'Foster', group: 'applications', title: `${item.applicantName} offers to foster ${item.petName}`, detail: `Care window ${item.availableFrom} to ${item.availableUntil}`, when: item.submittedAt, age: age(item.submittedAt), view: 'applications' });
    if (lost.ok) for (const item of lost.value.inquiries) if (item.status === 'New') items.push({ kind: 'Lost pet', group: 'lost-pets', title: `${item.memberName} thinks ${item.petName} is their pet`, detail: `${item.photoUrls.length} photo${item.photoUrls.length === 1 ? '' : 's'} attached · ${item.memberPhone}`, when: item.createdAt, age: age(item.createdAt), view: 'lost-pets' });
    if (shifts.ok) for (const shift of shifts.value.shifts) {
      const soon = Date.parse(shift.startsAt) - Date.now();
      if (shift.status === 'published' && soon > 0 && soon < 3 * 86_400_000 && shift.participants.length === 0) {
        items.push({ kind: 'Shift', group: 'visits', title: `${shift.title} has nobody signed up`, detail: `${formatShelterRange(shift.startsAt, shift.endsAt)} · capacity ${shift.capacity}`, when: shift.createdAt, age: `in ${Math.max(0, Math.floor(soon / 86_400_000))}d`, view: 'visits' });
      }
    }
    items.sort((a, b) => Date.parse(a.when) - Date.parse(b.when));
    const total = (group: Item['group']) => items.filter((item) => item.group === group).length;
    setCount('inbox', items.length);
    setCount('applications', total('applications'));
    setCount('visits', total('visits'));
    setCount('lost-pets', total('lost-pets'));
    renderList();

    // Today: booked visits and shifts that start today (shelter time).
    if (todayEl) {
      const today = shelterDay(Date.now());
      const visitsToday = visits.ok ? visits.value.slots.filter((slot) => slot.appointment && slot.status === 'published' && shelterDay(slot.startsAt) === today) : [];
      const shiftsToday = shifts.ok ? shifts.value.shifts.filter((shift) => shift.status === 'published' && shelterDay(shift.startsAt) === today) : [];
      if (!visitsToday.length && !shiftsToday.length) todayEl.append(el('p', 'mt-2 text-sm text-stone-600', 'No visits or shifts today.'));
      for (const slot of visitsToday) todayEl.append(line(`Visit · ${slot.appointment?.memberName ?? ''}`, formatShelterRange(slot.startsAt, slot.endsAt).split(' · ')[1] ?? ''));
      for (const shift of shiftsToday) todayEl.append(line(shift.title, `${shift.participants.length} of ${shift.capacity} signed up`));
    }

    if (moneyEl) {
      const money = (cents: number, currency: string) => new Intl.NumberFormat(undefined, { style: 'currency', currency: currency.toUpperCase() }).format(cents / 100);
      if (!donations.ok) moneyEl.append(el('p', 'mt-2 text-sm text-stone-600', 'Donation totals are unavailable right now.'));
      else if (!donations.value.totals.length) moneyEl.append(el('p', 'mt-2 text-sm text-stone-600', 'No successful donations yet.'));
      else for (const total of donations.value.totals) moneyEl.append(line(total.livemode ? 'Live' : 'Test mode', `${money(total.totalCents, total.currency)} · ${total.count} gift${total.count === 1 ? '' : 's'}`));
    }

    if (glanceEl) {
      if (!pets.ok) glanceEl.append(el('p', 'mt-2 text-sm text-stone-600', 'Pet counts are unavailable right now.'));
      else {
        const all = pets.value.pets;
        const count = (status: string) => all.filter((pet) => pet.status === status).length;
        const available = all.filter((pet) => pet.status === 'Available');
        const longest = available.reduce<typeof available[number] | null>((best, pet) => (!best || pet.daysInShelter > best.daysInShelter ? pet : best), null);
        glanceEl.append(line('Available', String(count('Available'))), line('Pending or fostered', String(count('Pending') + count('Fostered'))), line('Unavailable', String(count('Unavailable'))));
        if (longest) glanceEl.append(line('Longest wait (available)', `${longest.name}, ${longest.daysInShelter} days`));
      }
    }
  }

  void load();
</script>
