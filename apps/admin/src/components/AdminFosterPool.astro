<section aria-labelledby="pool-title">
  <h2 id="pool-title" class="text-xl font-semibold tracking-tight text-stone-950">Foster pool</h2>
  <p class="mt-2 max-w-2xl leading-6 text-stone-700">Approved fosters who opted in to alerts. Ask the pool for help with a pet: it opens the pet to foster, marks it urgent, and emails everyone in the pool. They accept in one step and you approve the application they file.</p>
  <p data-pool-message class="mt-3 hidden text-sm" role="status"></p>

  <div class="mt-6 grid items-start gap-6 xl:grid-cols-2">
    <div class="ph-card">
      <h3 class="text-base font-semibold text-stone-950">Ask for a foster</h3>
      <form data-request-form class="mt-3 grid gap-3">
        <label class="ph-field">Pet<select class="ph-input" name="petId" required data-request-pet></select></label>
        <label class="ph-field">Note to fosters (optional)<textarea class="ph-input" name="note" rows="2" maxlength="500" placeholder="Needs out by Friday. Good with other dogs."></textarea></label>
        <button class="ph-btn ph-btn-primary justify-self-start" type="submit">Email the foster pool</button>
      </form>
      <h3 class="mt-6 text-base font-semibold text-stone-950">Requests</h3>
      <div data-request-list class="mt-3 grid gap-2"><p class="text-sm text-stone-700">Loading…</p></div>
    </div>
    <div class="ph-card">
      <h3 class="text-base font-semibold text-stone-950">Volunteers who might foster</h3>
      <p class="mt-1 text-sm leading-6 text-stone-700">Members with five or more finished volunteer shifts who have never applied to foster.</p>
      <div data-candidate-list class="mt-3 grid gap-2"><p class="text-sm text-stone-700">Loading…</p></div>
    </div>
  </div>
</section>

<script>
  import type { AdminFosterRequest, AdminPetListResponse, VolunteerFosterCandidate } from '@pawheaven/contracts';
  import { apiRequest, el, pill } from '@pawheaven/contracts/ui';
  import { apiBase } from '../lib/api';

  const root = document.querySelector<HTMLElement>('[aria-labelledby="pool-title"]');
  const message = root?.querySelector<HTMLElement>('[data-pool-message]');
  const petSelect = root?.querySelector<HTMLSelectElement>('[data-request-pet]');
  const requestList = root?.querySelector<HTMLElement>('[data-request-list]');
  const candidateList = root?.querySelector<HTMLElement>('[data-candidate-list]');
  let loaded = false;

  function say(text: string, error = false) {
    if (!message) return;
    message.textContent = text;
    message.className = `mt-3 text-sm ${error ? 'text-red-800' : 'text-green-900'}`;
  }
  const messageOf = (error: unknown) => (error instanceof Error ? error.message : 'That did not work.');

  async function load() {
    try {
      const [pets, requests, candidates] = await Promise.all([
        apiRequest<AdminPetListResponse>(apiBase, '/admin/pets'),
        apiRequest<{ requests: AdminFosterRequest[] }>(apiBase, '/admin/foster-requests'),
        apiRequest<{ candidates: VolunteerFosterCandidate[] }>(apiBase, '/admin/volunteer-foster-candidates'),
      ]);
      petSelect?.replaceChildren(...pets.pets.filter((pet) => ['Available', 'Pending'].includes(pet.status)).map((pet) => Object.assign(el('option', '', `${pet.name} (${pet.type})`), { value: pet.id })));

      requestList?.replaceChildren();
      if (!requests.requests.length) requestList?.append(el('p', 'text-sm text-stone-700', 'No requests yet.'));
      for (const request of requests.requests) {
        const row = el('div', 'border border-stone-300 p-3 text-sm');
        const head = el('div', 'flex flex-wrap items-center justify-between gap-2');
        head.append(el('strong', 'text-stone-950', request.petName), request.closedAt ? pill('Closed', 'neutral') : pill('Open', 'warn'));
        row.append(head, el('span', 'mt-1 block text-stone-700', `${request.notified} emailed · ${request.accepted} accepted · ${request.declined} declined · ${new Date(request.createdAt).toLocaleDateString()}`));
        if (request.note) row.append(el('span', 'mt-1 block text-stone-700', request.note));
        if (!request.closedAt) {
          const close = el('button', 'ph-btn mt-2', 'Close request'); close.type = 'button';
          close.addEventListener('click', async () => { try { await apiRequest(apiBase, `/admin/foster-requests/${request.id}/close`, { method: 'POST' }); await load(); window.dispatchEvent(new CustomEvent('pawheaven:schedule-changed')); } catch (error) { say(messageOf(error), true); } });
          row.append(close);
        }
        requestList?.append(row);
      }

      candidateList?.replaceChildren();
      if (!candidates.candidates.length) candidateList?.append(el('p', 'text-sm text-stone-700', 'No one qualifies yet.'));
      for (const person of candidates.candidates) {
        const row = el('div', 'flex flex-wrap items-center justify-between gap-2 border border-stone-300 p-3 text-sm');
        const text = el('span', '');
        text.append(el('strong', 'block text-stone-950', person.name), el('span', 'block text-stone-700', `${person.shifts} shifts · ${person.hours} hours · ${person.email}`));
        const invite = el('button', 'ph-btn', person.invited ? 'Invite again' : 'Invite to foster'); invite.type = 'button';
        invite.addEventListener('click', async () => { try { await apiRequest(apiBase, `/admin/volunteer-foster-candidates/${person.memberId}/invite`, { method: 'POST' }); say(`Invitation sent to ${person.name}.`); await load(); window.dispatchEvent(new CustomEvent('pawheaven:schedule-changed')); } catch (error) { say(messageOf(error), true); } });
        row.append(text, invite);
        candidateList?.append(row);
      }
    } catch (error) { say(messageOf(error), true); }
  }

  root?.querySelector<HTMLFormElement>('[data-request-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formEl = event.currentTarget as HTMLFormElement;
    const data = new FormData(formEl);
    try {
      const result = await apiRequest<{ notified: number }>(apiBase, '/admin/foster-requests', { method: 'POST', json: { petId: data.get('petId'), note: data.get('note') } });
      say(result.notified ? `Asked ${result.notified} approved foster${result.notified === 1 ? '' : 's'}.` : 'The request is open, but nobody has opted in to alerts yet.');
      formEl.reset();
      window.dispatchEvent(new CustomEvent('pawheaven:pets-changed'));
      await load();
    } catch (error) { say(messageOf(error), true); }
  });

  const view = root?.closest<HTMLElement>('[data-view]');
  const start = () => { if (!loaded && view && !view.hidden) { loaded = true; void load(); } };
  if (view) new MutationObserver(start).observe(view, { attributes: true, attributeFilter: ['hidden'] });
  window.addEventListener('pawheaven:schedule-changed', () => { if (loaded) void load(); });
  start();
</script>
