<section data-user-manager aria-live="polite">
  <p data-loading class="text-sm text-stone-700">Loading user accounts…</p>

  <section data-denied hidden>
    <h1 class="text-2xl font-semibold tracking-tight text-stone-950">Staff access required</h1>
    <p class="mt-3 max-w-xl leading-7 text-stone-700">Log in with a staff account to manage users.</p>
    <a class="mt-7 inline-block bg-[var(--color-moss)] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[var(--color-moss-dark)]" href="/login">Go to login</a>
  </section>

  <div data-content hidden>
    <header class="flex flex-wrap items-start justify-between gap-6 border-b border-stone-300 pb-8">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-stone-950">User management</h1>
        <p class="mt-3 max-w-2xl leading-7 text-stone-700">View account details and adoption applications, send password resets, block sign-in, edit account information, or permanently delete accounts.</p>
        <p data-current-user class="mt-2 text-sm text-stone-600"></p>
      </div>
      <button data-logout type="button" class="border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-900 transition-colors hover:bg-stone-100 disabled:cursor-wait disabled:opacity-70">Log out</button>
    </header>

    <p data-page-message class="mt-6 hidden text-sm" role="status"></p>

    <div class="mt-8 grid gap-10 lg:grid-cols-[20rem_minmax(0,1fr)]">
      <aside>
        <h2 class="text-lg font-semibold text-stone-950">Accounts</h2>
        <label class="mt-4 block text-sm font-medium text-stone-900" for="user-search">Search
          <input id="user-search" data-search class="mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 placeholder:text-stone-500" type="search" placeholder="Name or email" />
        </label>
        <label class="mt-4 block text-sm font-medium text-stone-900" for="user-filter">Show
          <select id="user-filter" data-filter class="mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950">
            <option value="all">All accounts</option>
            <option value="member">Users</option>
            <option value="staff">Staff</option>
            <option value="blocked">Blocked</option>
          </select>
        </label>
        <p data-count class="mt-4 text-sm text-stone-600"></p>
        <div data-user-list class="mt-3 grid gap-2"></div>
      </aside>

      <section class="border-t border-stone-300 pt-7 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        <div data-empty-detail>
          <h2 class="text-lg font-semibold text-stone-950">Select an account</h2>
          <p class="mt-2 leading-6 text-stone-700">Choose someone from the account list to view their information and applications.</p>
        </div>

        <p data-detail-loading class="hidden text-sm text-stone-700">Loading account…</p>

        <div data-detail hidden>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 data-detail-name class="text-xl font-semibold text-stone-950"></h2>
              <p data-detail-summary class="mt-1 text-sm text-stone-700"></p>
            </div>
            <span data-access-state class="border px-2.5 py-1 text-xs font-semibold uppercase tracking-wide"></span>
          </div>

          <p data-permission-note class="mt-5 border-l-2 border-stone-400 pl-3 text-sm leading-6 text-stone-700"></p>

          <form data-profile-form class="mt-7 grid gap-5 border-y border-stone-300 py-6" novalidate>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="block text-sm font-medium text-stone-900">Name
                <input data-name name="name" class="mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 disabled:bg-stone-100 disabled:text-stone-600" maxlength="100" required />
              </label>
              <label class="block text-sm font-medium text-stone-900">Email address
                <input data-email name="email" class="mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 disabled:bg-stone-100 disabled:text-stone-600" type="email" maxlength="254" required />
              </label>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <button data-save type="submit" class="bg-[var(--color-moss)] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-not-allowed disabled:opacity-50">Save account</button>
              <p data-form-message class="hidden text-sm" role="status"></p>
            </div>
          </form>

          <dl class="mt-6 grid gap-x-8 gap-y-4 text-sm sm:grid-cols-2">
            <div><dt class="font-medium text-stone-600">Account type</dt><dd data-role class="mt-1 text-stone-950"></dd></div>
            <div><dt class="font-medium text-stone-600">Joined</dt><dd data-created class="mt-1 text-stone-950"></dd></div>
            <div><dt class="font-medium text-stone-600">Last sign-in</dt><dd data-last-sign-in class="mt-1 text-stone-950"></dd></div>
            <div><dt class="font-medium text-stone-600">Email confirmed</dt><dd data-confirmed class="mt-1 text-stone-950"></dd></div>
          </dl>

          <form data-role-form hidden class="mt-6 flex flex-wrap items-end gap-3 border-t border-stone-300 pt-6">
            <label class="text-sm font-medium text-stone-900">Account role
              <select data-role-select class="mt-2 block border border-stone-400 bg-white px-3 py-2.5 text-stone-950">
                <option value="member">Member (public site only)</option>
                <option value="staff">Staff (manages pets, applications, visits, members)</option>
              </select>
            </label>
            <button data-role-save type="submit" class="bg-[var(--color-moss)] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-moss-dark)] disabled:cursor-wait disabled:opacity-70">Save role</button>
            <p data-role-message class="hidden text-sm" role="status"></p>
          </form>

          <section class="mt-8 border-t border-stone-300 pt-7" aria-labelledby="account-actions-title">
            <h3 id="account-actions-title" class="font-semibold text-stone-950">Account actions</h3>
            <div class="mt-4 flex flex-wrap gap-3">
              <button data-reset type="button" class="border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-900 transition-colors hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-50">Send password reset</button>
              <button data-block type="button" class="border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-900 transition-colors hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-50"></button>
              <button data-delete type="button" class="border border-red-700 px-4 py-2 text-sm font-semibold text-red-800 transition-colors hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50">Delete permanently</button>
            </div>
            <p data-action-message class="mt-3 hidden text-sm" role="status"></p>
          </section>

          <section class="mt-8 border-t border-stone-300 pt-7" aria-labelledby="user-applications-title">
            <h3 id="user-applications-title" class="font-semibold text-stone-950">Adoption applications</h3>
            <p data-application-count class="mt-2 text-sm text-stone-600"></p>
            <div data-applications class="mt-4 grid gap-4"></div>
          </section>
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import type { AdminUser, AdminUserDetailResponse, AdminUserListResponse, AdoptionApplication, ManagedUser } from '@pawheaven/contracts';
  import { apiBase } from '../lib/api';

  const root = document.querySelector<HTMLElement>('[data-user-manager]');
  const loading = root?.querySelector<HTMLElement>('[data-loading]');
  const denied = root?.querySelector<HTMLElement>('[data-denied]');
  const content = root?.querySelector<HTMLElement>('[data-content]');
  const currentUserLabel = root?.querySelector<HTMLElement>('[data-current-user]');
  const pageMessage = root?.querySelector<HTMLElement>('[data-page-message]');
  const search = root?.querySelector<HTMLInputElement>('[data-search]');
  const filter = root?.querySelector<HTMLSelectElement>('[data-filter]');
  const count = root?.querySelector<HTMLElement>('[data-count]');
  const userList = root?.querySelector<HTMLElement>('[data-user-list]');
  const emptyDetail = root?.querySelector<HTMLElement>('[data-empty-detail]');
  const detailLoading = root?.querySelector<HTMLElement>('[data-detail-loading]');
  const detail = root?.querySelector<HTMLElement>('[data-detail]');
  const detailName = root?.querySelector<HTMLElement>('[data-detail-name]');
  const detailSummary = root?.querySelector<HTMLElement>('[data-detail-summary]');
  const accessState = root?.querySelector<HTMLElement>('[data-access-state]');
  const permissionNote = root?.querySelector<HTMLElement>('[data-permission-note]');
  const profileForm = root?.querySelector<HTMLFormElement>('[data-profile-form]');
  const nameInput = root?.querySelector<HTMLInputElement>('[data-name]');
  const emailInput = root?.querySelector<HTMLInputElement>('[data-email]');
  const saveButton = root?.querySelector<HTMLButtonElement>('[data-save]');
  const formMessage = root?.querySelector<HTMLElement>('[data-form-message]');
  const roleValue = root?.querySelector<HTMLElement>('[data-role]');
  const createdValue = root?.querySelector<HTMLElement>('[data-created]');
  const lastSignInValue = root?.querySelector<HTMLElement>('[data-last-sign-in]');
  const confirmedValue = root?.querySelector<HTMLElement>('[data-confirmed]');
  const resetButton = root?.querySelector<HTMLButtonElement>('[data-reset]');
  const blockButton = root?.querySelector<HTMLButtonElement>('[data-block]');
  const deleteButton = root?.querySelector<HTMLButtonElement>('[data-delete]');
  const actionMessage = root?.querySelector<HTMLElement>('[data-action-message]');
  const roleForm = root?.querySelector<HTMLFormElement>('[data-role-form]');
  const roleSelect = root?.querySelector<HTMLSelectElement>('[data-role-select]');
  const roleSave = root?.querySelector<HTMLButtonElement>('[data-role-save]');
  const roleMessage = root?.querySelector<HTMLElement>('[data-role-message]');
  const applicationCount = root?.querySelector<HTMLElement>('[data-application-count]');
  const applications = root?.querySelector<HTMLElement>('[data-applications]');

  let currentUser: AdminUser | null = null;
  let users: ManagedUser[] = [];
  let selected: AdminUserDetailResponse | null = null;
  let selectedId: string | null = null;
  let selectionRequest = 0;

  function setMessage(target: HTMLElement | null | undefined, text: string, success = false) {
    if (!target) return;
    target.textContent = text;
    target.className = `text-sm ${success ? 'text-[var(--color-moss-dark)]' : 'text-red-800'}`;
  }

  async function responseJson<T>(path: string, init?: RequestInit): Promise<T> {
    const response = await fetch(`${apiBase}${path}`, { credentials: 'include', ...init });
    if (response.status === 401) { window.location.assign('/login'); throw new Error('Your session has expired.'); }
    const payload = await response.json().catch(() => null) as { message?: unknown } | T | null;
    if (!response.ok) throw new Error(typeof (payload as { message?: unknown } | null)?.message === 'string' ? (payload as { message: string }).message : 'The request could not be completed.');
    return payload as T;
  }

  function formatDate(value: string | null) {
    if (!value) return 'Never';
    const date = new Date(value);
    return Number.isNaN(date.valueOf()) ? 'Unknown' : date.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
  }

  function roleLabel(role: ManagedUser['role']) {
    if (role === 'superuser') return 'Superuser';
    if (role === 'staff') return 'Staff';
    return 'Member';
  }

  function canManage(user: ManagedUser) {
    if (!currentUser || user.id === currentUser.id || user.role === 'superuser') return false;
    return user.role !== 'staff' || currentUser.role === 'superuser';
  }

  function updateUser(user: ManagedUser) {
    users = users.map((item) => item.id === user.id ? user : item);
    if (selected?.user.id === user.id) selected = { ...selected, user };
    renderUsers();
    if (selected?.user.id === user.id) renderDetail();
  }

  function visibleUsers() {
    const query = search?.value.trim().toLowerCase() ?? '';
    const selectedFilter = filter?.value ?? 'all';
    return users.filter((user) => {
      const matchesSearch = !query || user.name.toLowerCase().includes(query) || user.email.toLowerCase().includes(query);
      const matchesFilter = selectedFilter === 'all'
        || (selectedFilter === 'member' && user.role === 'member')
        || (selectedFilter === 'staff' && user.role !== 'member')
        || (selectedFilter === 'blocked' && user.blocked);
      return matchesSearch && matchesFilter;
    });
  }

  function renderUsers() {
    if (!userList) return;
    const visible = visibleUsers();
    userList.replaceChildren();
    if (count) count.textContent = `${visible.length} of ${users.length} accounts`;
    if (!visible.length) {
      const empty = document.createElement('p');
      empty.className = 'text-sm leading-6 text-stone-700';
      empty.textContent = 'No accounts match this search.';
      userList.append(empty);
      return;
    }
    for (const user of visible) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `border px-3 py-3 text-left transition-colors ${selectedId === user.id ? 'border-stone-950 bg-stone-100' : 'border-stone-300 bg-white hover:bg-stone-100'}`;
      const name = document.createElement('span');
      name.className = 'block truncate font-semibold text-stone-950';
      name.textContent = user.name;
      const email = document.createElement('span');
      email.className = 'mt-1 block truncate text-sm text-stone-700';
      email.textContent = user.email;
      const meta = document.createElement('span');
      meta.className = `mt-2 block text-xs font-semibold uppercase tracking-wide ${user.blocked ? 'text-red-800' : 'text-stone-600'}`;
      meta.textContent = `${roleLabel(user.role)}${user.blocked ? ' · Blocked' : ''}`;
      button.append(name, email, meta);
      button.addEventListener('click', () => selectUser(user.id));
      userList.append(button);
    }
  }

  function renderApplications(items: AdoptionApplication[]) {
    if (!applications) return;
    applications.replaceChildren();
    if (applicationCount) applicationCount.textContent = items.length === 1 ? '1 application' : `${items.length} applications`;
    if (!items.length) {
      const empty = document.createElement('p');
      empty.className = 'text-sm leading-6 text-stone-700';
      empty.textContent = 'This user has not submitted an adoption application.';
      applications.append(empty);
      return;
    }
    for (const application of items) {
      const card = document.createElement('article');
      card.className = 'border border-stone-300 bg-white p-4';
      const heading = document.createElement('h4');
      heading.className = 'font-semibold text-stone-950';
      heading.textContent = application.petName;
      const summary = document.createElement('p');
      summary.className = 'mt-1 text-sm text-stone-700';
      summary.textContent = `${application.status} · Submitted ${formatDate(application.submittedAt)}`;
      const household = document.createElement('p');
      household.className = 'mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-800';
      household.textContent = `Household: ${application.householdSummary}`;
      const experience = document.createElement('p');
      experience.className = 'mt-2 whitespace-pre-wrap text-sm leading-6 text-stone-800';
      experience.textContent = `Pet-care experience: ${application.adoptionExperience}`;
      card.append(heading, summary, household, experience);
      if (application.note) {
        const note = document.createElement('p');
        note.className = 'mt-2 whitespace-pre-wrap text-sm leading-6 text-stone-700';
        note.textContent = `Note: ${application.note}`;
        card.append(note);
      }
      applications.append(card);
    }
  }

  function renderDetail() {
    if (!selected || !currentUser) return;
    const user = selected.user;
    const manageable = canManage(user);
    if (detailName) detailName.textContent = user.name;
    if (detailSummary) detailSummary.textContent = user.email;
    if (accessState) {
      accessState.textContent = user.blocked ? 'Blocked' : 'Active';
      accessState.className = `border px-2.5 py-1 text-xs font-semibold uppercase tracking-wide ${user.blocked ? 'border-red-300 bg-red-50 text-red-800' : 'border-green-300 bg-green-50 text-green-900'}`;
    }
    if (permissionNote) {
      permissionNote.textContent = manageable
        ? user.role === 'staff'
          ? 'As a superuser, you can manage, change the role of, or completely delete this staff account.'
          : 'Staff can manage this member account. Deleting it also removes its adoption applications.'
        : user.id === currentUser.id
          ? 'Your own account is protected from changes here.'
          : user.role === 'superuser'
            ? 'Superuser accounts are protected from changes in this portal.'
            : 'Only a superuser can manage another staff account.';
    }
    if (nameInput) { nameInput.value = user.name; nameInput.disabled = !manageable; }
    if (emailInput) { emailInput.value = user.email; emailInput.disabled = !manageable; }
    if (saveButton) saveButton.disabled = !manageable;
    const roleAssignable = manageable && currentUser.role === 'superuser' && (user.role === 'member' || user.role === 'staff');
    if (roleForm) roleForm.hidden = !roleAssignable;
    if (roleSelect) roleSelect.value = user.role === 'staff' ? 'staff' : 'member';
    if (roleMessage) { roleMessage.textContent = ''; roleMessage.className = 'hidden text-sm'; }
    if (roleValue) roleValue.textContent = roleLabel(user.role);
    if (createdValue) createdValue.textContent = formatDate(user.createdAt);
    if (lastSignInValue) lastSignInValue.textContent = formatDate(user.lastSignInAt);
    if (confirmedValue) confirmedValue.textContent = formatDate(user.emailConfirmedAt);
    if (resetButton) resetButton.disabled = !manageable || user.blocked;
    if (blockButton) { blockButton.disabled = !manageable; blockButton.textContent = user.blocked ? 'Unblock sign-in' : 'Block sign-in'; }
    if (deleteButton) deleteButton.disabled = !manageable;
    if (formMessage) { formMessage.textContent = ''; formMessage.className = 'hidden text-sm'; }
    if (actionMessage) { actionMessage.textContent = ''; actionMessage.className = 'hidden text-sm'; }
    renderApplications(selected.applications);
    emptyDetail?.setAttribute('hidden', '');
    detailLoading?.classList.add('hidden');
    detail?.removeAttribute('hidden');
  }

  async function selectUser(id: string) {
    selectedId = id;
    selected = null;
    const requestNumber = ++selectionRequest;
    renderUsers();
    emptyDetail?.setAttribute('hidden', '');
    detail?.setAttribute('hidden', '');
    detailLoading?.classList.remove('hidden');
    try {
      const payload = await responseJson<AdminUserDetailResponse>(`/admin/users/${encodeURIComponent(id)}`);
      if (requestNumber !== selectionRequest) return;
      selected = payload;
      renderDetail();
    } catch (exception) {
      if (requestNumber !== selectionRequest) return;
      detailLoading?.classList.add('hidden');
      emptyDetail?.removeAttribute('hidden');
      setMessage(pageMessage, exception instanceof Error ? exception.message : 'We could not load that account.');
    }
  }

  profileForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!selected || !canManage(selected.user) || !profileForm.reportValidity() || !nameInput || !emailInput || !saveButton) return;
    saveButton.disabled = true;
    saveButton.textContent = 'Saving…';
    try {
      const payload = await responseJson<{ user: ManagedUser }>(`/admin/users/${encodeURIComponent(selected.user.id)}`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: nameInput.value.trim(), email: emailInput.value.trim() }),
      });
      updateUser(payload.user);
      setMessage(formMessage, 'Account information saved.', true);
    } catch (exception) {
      setMessage(formMessage, exception instanceof Error ? exception.message : 'We could not save this account.');
    } finally {
      saveButton.textContent = 'Save account';
      saveButton.disabled = selected ? !canManage(selected.user) : true;
    }
  });

  roleForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!selected || !canManage(selected.user) || !roleSelect || !roleSave) return;
    roleSave.disabled = true;
    roleSave.textContent = 'Saving…';
    try {
      const payload = await responseJson<{ user: ManagedUser }>(`/admin/users/${encodeURIComponent(selected.user.id)}/role`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ role: roleSelect.value }),
      });
      updateUser(payload.user);
      setMessage(roleMessage, `Role changed to ${roleLabel(payload.user.role)}. It takes effect the next time they use the site.`, true);
    } catch (exception) {
      setMessage(roleMessage, exception instanceof Error ? exception.message : 'We could not change this role.');
    } finally {
      roleSave.disabled = false;
      roleSave.textContent = 'Save role';
    }
  });

  resetButton?.addEventListener('click', async () => {
    if (!selected || !canManage(selected.user) || selected.user.blocked || !resetButton) return;
    resetButton.disabled = true;
    resetButton.textContent = 'Sending…';
    try {
      const payload = await responseJson<{ message: string }>(`/admin/users/${encodeURIComponent(selected.user.id)}/password-reset`, { method: 'POST' });
      setMessage(actionMessage, payload.message, true);
    } catch (exception) {
      setMessage(actionMessage, exception instanceof Error ? exception.message : 'We could not send the password reset.');
    } finally {
      resetButton.textContent = 'Send password reset';
      resetButton.disabled = selected ? !canManage(selected.user) || selected.user.blocked : true;
    }
  });

  blockButton?.addEventListener('click', async () => {
    if (!selected || !canManage(selected.user) || !blockButton) return;
    const blocked = !selected.user.blocked;
    if (blocked && !window.confirm(`Block ${selected.user.email} from signing in?`)) return;
    blockButton.disabled = true;
    blockButton.textContent = blocked ? 'Blocking…' : 'Unblocking…';
    try {
      const payload = await responseJson<{ user: ManagedUser }>(`/admin/users/${encodeURIComponent(selected.user.id)}/access`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ blocked }),
      });
      updateUser(payload.user);
      setMessage(actionMessage, blocked ? 'Sign-in blocked.' : 'Sign-in restored.', true);
    } catch (exception) {
      renderDetail();
      setMessage(actionMessage, exception instanceof Error ? exception.message : 'We could not change account access.');
    }
  });

  deleteButton?.addEventListener('click', async () => {
    if (!selected || !canManage(selected.user) || !deleteButton) return;
    const user = selected.user;
    const warning = user.role === 'staff'
      ? `Permanently delete staff member ${user.email}? This cannot be undone.`
      : `Permanently delete ${user.email}? Their ${selected.applications.length} adoption application${selected.applications.length === 1 ? '' : 's'} will also be deleted. This cannot be undone.`;
    if (!window.confirm(warning)) return;
    deleteButton.disabled = true;
    deleteButton.textContent = 'Deleting…';
    try {
      await responseJson(`/admin/users/${encodeURIComponent(user.id)}`, { method: 'DELETE' });
      users = users.filter((item) => item.id !== user.id);
      selected = null;
      selectedId = null;
      renderUsers();
      detail?.setAttribute('hidden', '');
      emptyDetail?.removeAttribute('hidden');
      setMessage(pageMessage, `${user.email} was permanently deleted.`, true);
    } catch (exception) {
      setMessage(actionMessage, exception instanceof Error ? exception.message : 'We could not delete this account.');
      deleteButton.textContent = 'Delete permanently';
      deleteButton.disabled = false;
    }
  });

  search?.addEventListener('input', renderUsers);
  filter?.addEventListener('change', renderUsers);

  root?.querySelector<HTMLButtonElement>('[data-logout]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    try { await fetch(`${apiBase}/auth/logout`, { method: 'POST', credentials: 'include' }); } finally { window.location.assign('/login'); }
  });

  async function load() {
    try {
      const [identity, accountList] = await Promise.all([
        responseJson<{ user: AdminUser }>('/admin/me'),
        responseJson<AdminUserListResponse>('/admin/users'),
      ]);
      currentUser = identity.user;
      users = accountList.users;
      if (currentUserLabel) currentUserLabel.textContent = `Signed in as ${currentUser.email} · ${roleLabel(currentUser.role)}`;
      renderUsers();
      loading?.setAttribute('hidden', '');
      content?.removeAttribute('hidden');
    } catch (exception) {
      loading?.setAttribute('hidden', '');
      if (exception instanceof Error && exception.message === 'Your session has expired.') return;
      denied?.removeAttribute('hidden');
    }
  }

  load();
</script>
