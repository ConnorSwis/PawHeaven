<section aria-labelledby="attention-title" data-attention hidden class="mb-6">
  <h3 id="attention-title" class="text-base font-semibold text-stone-950">Needs attention</h3>
  <div data-attention-list class="mt-3 grid gap-2" aria-live="polite"></div>
</section>

<script>
  import type { AttentionItem } from '@pawheaven/contracts';
  import { apiRequest, el } from '@pawheaven/contracts/ui';
  import { apiBase } from '../lib/api';

  const section = document.querySelector<HTMLElement>('[data-attention]');
  const list = document.querySelector<HTMLElement>('[data-attention-list]');
  let loaded = false;

  async function run(item: AttentionItem, status: HTMLElement) {
    try {
      if (item.action === 'generate') {
        await apiRequest(apiBase, '/admin/availability/generate', { method: 'POST' });
      } else if (item.action === 'open_foster') {
        await apiRequest(apiBase, '/admin/pets/flags', { method: 'POST', json: { petIds: item.petIds ?? [], fosterAvailable: true } });
        window.dispatchEvent(new CustomEvent('pawheaven:pets-changed'));
      } else {
        window.location.hash = item.action === 'schedule' ? '#schedule' : '#fosters';
        return;
      }
      window.dispatchEvent(new CustomEvent('pawheaven:schedule-changed'));
      await load();
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'That did not work.';
    }
  }

  async function load() {
    try {
      const { items } = await apiRequest<{ items: AttentionItem[] }>(apiBase, '/admin/attention');
      if (!section || !list) return;
      list.replaceChildren();
      section.hidden = items.length === 0;
      for (const item of items) {
        const card = el('div', 'ph-card flex flex-wrap items-center justify-between gap-3 border-l-4 border-l-[var(--ph-warning)]');
        const text = el('div', 'min-w-0');
        text.append(el('strong', 'block text-sm text-stone-950', item.title), el('span', 'block text-sm text-stone-700', item.detail));
        const status = el('span', 'block text-sm text-red-800');
        text.append(status);
        const label = { generate: 'Fill in open hours', schedule: 'Open the schedule', open_foster: 'Open them to foster', fosters: 'Go to foster pool' }[item.action];
        const act = el('button', 'ph-btn', label);
        act.type = 'button';
        act.addEventListener('click', () => { act.disabled = true; void run(item, status).finally(() => { act.disabled = false; }); });
        card.append(text, act);
        list.append(card);
      }
    } catch { if (section) section.hidden = true; }
  }

  const view = section?.closest<HTMLElement>('[data-view]');
  const start = () => { if (!loaded && view && !view.hidden) { loaded = true; void load(); } };
  if (view) new MutationObserver(start).observe(view, { attributes: true, attributeFilter: ['hidden'] });
  window.addEventListener('pawheaven:schedule-changed', () => { if (loaded) void load(); });
  window.addEventListener('pawheaven:pets-changed', () => { if (loaded) void load(); });
  start();
</script>
