---
import '../styles/global.css';
import { SITE, THEMES } from '@pawheaven/contracts/site';

interface Props {
  title: string;
  description?: string;
}

const themeSwitcher = import.meta.env.PUBLIC_THEME_SWITCHER === 'true';
const { title, description = `${SITE.name} staff portal` } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={import.meta.env.PUBLIC_THEME || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | {SITE.adminName}</title>
    <script is:inline define:vars={{ ids: THEMES.map((theme) => theme.id) }}>try { const root = document.documentElement; const saved = localStorage.getItem('ph-theme'); if (saved !== null && ids.includes(saved)) { if (saved) root.dataset.theme = saved; else delete root.dataset.theme; } const vars = JSON.parse(localStorage.getItem('ph-theme-vars') || '{}'); for (const [name, value] of Object.entries(vars)) if (/^--ph-[a-z-]+$/.test(name) && typeof value === 'string' && /^[#\w\s.,%()"'-]+$/.test(value)) root.style.setProperty(name, value); } catch { /* Storage blocked or unreadable. */ }</script>
  </head>
  <body class="min-h-dvh bg-[var(--color-page)] text-stone-900 antialiased">
    <header class="border-b border-stone-300 bg-white">
      <div class="mx-auto flex min-h-16 max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-3">
        <a class="text-lg font-semibold tracking-tight text-stone-950" href="/">{SITE.adminName}</a>
        <nav class="flex items-center gap-5 text-sm font-medium" aria-label="Staff navigation">
          <a class="text-stone-700 underline decoration-stone-400 underline-offset-4 hover:text-stone-950 hover:decoration-stone-950" href="/">Portal</a>
          <a class="text-stone-700 underline decoration-stone-400 underline-offset-4 hover:text-stone-950 hover:decoration-stone-950" href="/users">Users</a>
          <a class="text-stone-700 underline decoration-stone-400 underline-offset-4 hover:text-stone-950 hover:decoration-stone-950" href="https://pawheaven.online">Shelter site</a>
          {themeSwitcher && (
            <label class="flex items-center gap-2 text-sm text-stone-700">Theme
              <select data-theme-switcher class="border border-stone-400 bg-white px-2 py-1.5 text-stone-900">
                {THEMES.map((theme) => <option value={theme.id}>{theme.label}</option>)}
              </select>
            </label>
          )}
        </nav>
      </div>
    </header>
    <main id="main-content" class="mx-auto w-full max-w-6xl px-6 py-10">
      <slot />
    </main>
  </body>
</html>

<script>
  import { initThemeSwitcher } from '@pawheaven/contracts/ui';
  const themeSelect = document.querySelector<HTMLSelectElement>('[data-theme-switcher]');
  if (themeSelect) initThemeSwitcher(themeSelect);
</script>
