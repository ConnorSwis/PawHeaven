---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="PawHeaven staff pet management" />
    <title>Staff | PawHeaven</title>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div><p>PawHeaven</p><h1>Staff portal</h1></div>
        <button class="secondary" type="button" data-logout hidden>Log out</button>
      </header>
      <p class="message" role="status" aria-live="polite" data-message>Checking your session…</p>

      <section class="panel login" data-login hidden aria-labelledby="login-heading">
        <h2 id="login-heading">Staff sign in</h2>
        <form data-login-form>
          <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="username" required /></div>
          <div class="field" style="margin-top: 1rem"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div>
          <div class="actions"><button class="primary" type="submit">Log in</button></div>
        </form>
      </section>

      <main data-dashboard hidden>
        <section class="panel" aria-labelledby="pets-heading">
          <h2 id="pets-heading">Pets</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Image</th><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
              <tbody data-pet-rows></tbody>
            </table>
          </div>
        </section>

        <section class="panel" aria-labelledby="editor-heading">
          <h2 id="editor-heading" data-editor-heading>Add a pet</h2>
          <form data-pet-form>
            <div class="form-grid">
              <div class="field"><label for="pet-name">Name</label><input id="pet-name" name="name" maxlength="100" required /></div>
              <div class="field"><label for="pet-type">Type</label><input id="pet-type" name="type" maxlength="60" placeholder="Dog, cat…" required /></div>
              <div class="field"><label for="pet-breed">Breed</label><input id="pet-breed" name="breed" maxlength="100" required /></div>
              <div class="field"><label for="pet-age">Age</label><input id="pet-age" name="age" maxlength="60" placeholder="3 years" required /></div>
              <div class="field"><label for="pet-intake">Intake date</label><input id="pet-intake" name="intakeDate" type="date" required /></div>
              <div class="field"><label for="pet-status">Status</label><select id="pet-status" name="status"><option>Available</option><option>Pending</option><option>Adopted</option></select></div>
              <div class="field full"><label for="pet-tags">Tags</label><input id="pet-tags" name="tags" placeholder="big-dog, good-with-kids" aria-describedby="tags-help" /><span id="tags-help">Use comma-separated lowercase tags with hyphens.</span></div>
              <div class="field full"><label for="pet-summary">Summary</label><textarea id="pet-summary" name="summary" maxlength="2000" required></textarea></div>
              <div class="field full"><label for="pet-image">Photo</label><input id="pet-image" name="image" type="file" accept="image/jpeg,image/png,image/webp" data-pet-image /><span>JPEG, PNG, or WebP; 5 MB maximum.</span></div>
            </div>
            <div class="actions"><button class="primary" type="submit" data-save>Save pet</button><button class="secondary" type="button" data-cancel>Clear form</button></div>
          </form>
        </section>
      </main>
    </div>

    <script>
      import type { ApiUser, Pet, PetInput } from '@pawheaven/contracts';
      const apiBase = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:8787/api';
      const message = document.querySelector<HTMLElement>('[data-message]')!;
      const login = document.querySelector<HTMLElement>('[data-login]')!;
      const dashboard = document.querySelector<HTMLElement>('[data-dashboard]')!;
      const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]')!;
      const petForm = document.querySelector<HTMLFormElement>('[data-pet-form]')!;
      const rows = document.querySelector<HTMLTableSectionElement>('[data-pet-rows]')!;
      const logout = document.querySelector<HTMLButtonElement>('[data-logout]')!;
      const save = document.querySelector<HTMLButtonElement>('[data-save]')!;
      const heading = document.querySelector<HTMLElement>('[data-editor-heading]')!;
      const imageInput = document.querySelector<HTMLInputElement>('[data-pet-image]')!;
      let pets: Pet[] = [];
      let editingId: string | null = null;

      function say(text: string, error = false) {
        message.textContent = text;
        message.classList.toggle('error', error);
      }

      async function api(path: string, options: RequestInit = {}) {
        const response = await fetch(`${apiBase}${path}`, { credentials: 'include', ...options });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.message || `Request failed (${response.status}).`);
        return payload;
      }

      function showLogin() { login.hidden = false; dashboard.hidden = true; logout.hidden = true; }
      function showDashboard() { login.hidden = true; dashboard.hidden = false; logout.hidden = false; }

      function cell(text: string) {
        const node = document.createElement('td');
        node.textContent = text;
        return node;
      }

      function renderPets() {
        rows.replaceChildren();
        if (pets.length === 0) {
          const row = document.createElement('tr');
          const empty = cell('No pets yet. Add one below.');
          empty.colSpan = 5;
          row.append(empty);
          rows.append(row);
          return;
        }
        for (const pet of pets) {
          const row = document.createElement('tr');
          const imageCell = document.createElement('td');
          if (pet.imageUrl) {
            const image = document.createElement('img');
            image.src = pet.imageUrl;
            image.alt = `${pet.name} photo`;
            image.className = 'thumb';
            imageCell.append(image);
          } else imageCell.textContent = '—';
          const actionCell = document.createElement('td');
          const edit = document.createElement('button');
          edit.type = 'button'; edit.textContent = 'Edit'; edit.dataset.edit = pet.id;
          const remove = document.createElement('button');
          remove.type = 'button'; remove.textContent = 'Delete'; remove.dataset.delete = pet.id;
          actionCell.append(edit, remove);
          row.append(imageCell, cell(pet.name), cell(pet.type), cell(pet.status), actionCell);
          rows.append(row);
        }
      }

      async function loadPets() {
        const payload = await api('/staff/pets');
        pets = payload.pets;
        renderPets();
        say(`${pets.length} ${pets.length === 1 ? 'pet' : 'pets'} loaded.`);
      }

      function clearForm() {
        editingId = null;
        petForm.reset();
        heading.textContent = 'Add a pet';
        save.textContent = 'Save pet';
      }

      function editPet(pet: Pet) {
        editingId = pet.id;
        const fields: Record<string, string> = {
          name: pet.name, type: pet.type, breed: pet.breed, age: pet.age,
          intakeDate: pet.intakeDate, tags: pet.tags.join(', '), status: pet.status, summary: pet.summary,
        };
        for (const [name, value] of Object.entries(fields)) {
          const field = petForm.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
          if (field) field.value = value;
        }
        imageInput.value = '';
        heading.textContent = `Edit ${pet.name}`;
        save.textContent = 'Save changes';
        petForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      async function checkSession() {
        try {
          const { user } = await api('/auth/me') as { user: ApiUser };
          if (user.role !== 'staff' && user.role !== 'admin') {
            showLogin(); say('This account does not have staff access.', true); return;
          }
          showDashboard();
          await loadPets();
        } catch (error) {
          showLogin();
          say(error instanceof Error && error.message !== 'Not signed in.' ? error.message : 'Sign in with a staff account.', false);
        }
      }

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!loginForm.reportValidity()) return;
        const form = new FormData(loginForm);
        try {
          await api('/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: form.get('email'), password: form.get('password') }) });
          await checkSession();
        } catch (error) { say(error instanceof Error ? error.message : 'Unable to log in.', true); }
      });

      logout.addEventListener('click', async () => {
        try { await api('/auth/logout', { method: 'POST' }); }
        finally { showLogin(); clearForm(); say('Signed out.'); }
      });

      rows.addEventListener('click', async (event) => {
        const target = event.target as HTMLElement;
        const editId = target.dataset.edit;
        const deleteId = target.dataset.delete;
        if (editId) {
          const pet = pets.find((entry) => entry.id === editId);
          if (pet) editPet(pet);
        }
        if (deleteId) {
          const pet = pets.find((entry) => entry.id === deleteId);
          if (!pet || !window.confirm(`Delete ${pet.name}? This also removes its photo.`)) return;
          try {
            await api(`/staff/pets/${deleteId}`, { method: 'DELETE' });
            if (editingId === deleteId) clearForm();
            await loadPets();
          } catch (error) { say(error instanceof Error ? error.message : 'Unable to delete pet.', true); }
        }
      });

      document.querySelector('[data-cancel]')?.addEventListener('click', clearForm);
      petForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!petForm.reportValidity()) return;
        const form = new FormData(petForm);
        const input: PetInput = {
          name: String(form.get('name')).trim(), type: String(form.get('type')).trim(), breed: String(form.get('breed')).trim(),
          age: String(form.get('age')).trim(), intakeDate: String(form.get('intakeDate')),
          status: String(form.get('status')) as PetInput['status'], summary: String(form.get('summary')).trim(),
          tags: String(form.get('tags') || '').split(',').map((tag) => tag.trim()).filter(Boolean),
        };
        const image = imageInput.files?.[0];
        save.disabled = true;
        try {
          const pet = await api(editingId ? `/staff/pets/${editingId}` : '/staff/pets', {
            method: editingId ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(input),
          }) as Pet;
          if (image) {
            const upload = new FormData(); upload.set('image', image);
            await api(`/staff/pets/${pet.id}/image`, { method: 'POST', body: upload });
          }
          clearForm();
          await loadPets();
          say(`${pet.name} saved.`);
        } catch (error) { say(error instanceof Error ? error.message : 'Unable to save pet.', true); }
        finally { save.disabled = false; }
      });

      checkSession();
    </script>
  </body>
</html>
