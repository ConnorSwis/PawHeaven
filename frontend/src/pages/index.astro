---
import PageShell from '../layouts/PageShell.astro';
---

<PageShell title="PawHeaven">
  <main class="mx-auto grid min-h-dvh max-w-5xl place-items-center px-6 py-12">
    <section class="w-full max-w-xl border border-stone-300 bg-white p-8 sm:p-10">
      <p class="text-sm font-medium text-stone-600">PawHeaven</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Animal shelter portal</h1>
      <p class="mt-3 leading-7 text-stone-700">Choose a page to review the first frontend pieces.</p>
      <div class="mt-7 grid gap-3 sm:grid-cols-2">
        <a class="border border-stone-400 px-4 py-3 font-medium text-stone-900 transition-colors hover:bg-stone-100" href="/login">Log in</a>
        <a class="border border-stone-400 px-4 py-3 font-medium text-stone-900 transition-colors hover:bg-stone-100" href="/sign-up">Create account</a>
        <a class="border border-stone-400 px-4 py-3 font-medium text-stone-900 transition-colors hover:bg-stone-100" href="/pets">Browse pets</a>
        <a class="border border-stone-400 px-4 py-3 font-medium text-stone-900 transition-colors hover:bg-stone-100" href="/account">Account</a>
      </div>
    </section>
  </main>
</PageShell>
